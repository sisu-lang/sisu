// Every token kind, every reserved word, and every case of the rules of the lexer, one row each.
// The file lexes with no error. It gives a warning (W0007) for each redundant `;`, and it need not
// check: no test builds it. Tests compare the tokens of `sisu build --emit tokens` with the tokens
// of `selfhost/lexer.sisu`. A row that the program lexes in another way fails there.
// A rule row has a comment that names its rule, so a reader who deletes a row sees what it guarded.

// Names: a name is an ASCII letter or `_`, then ASCII letters, digits and `_`.
// Keywords: each one, and `_` alone, which is `Underscore`.
class Names {
    let mut x1 = _y_2
    var _
    todo
    fn f() { return }
    const K = true
    for a in b { loop { break } }
    if a { continue } else { while false { } }
    match None { Some(self) => Self, _ => x is y }
    interface I { }
    extend Names { }
    enum E { }
}

// Reserved words: each one is `Reserved`, and `var` and `todo` are not.
import pub record type weak test extern as

// Operators and punctuation: each one, by longest match.
fn operators() {
    a + b - c * d / e % f
    a += b -= c *= d /= e %= f
    a == b != c < d <= e > f >= g && h || !i
    a = (b, c) -> d => e | f
    a.b..c..=d[e]
    a?.b ?? c ? d
    a: b
    // `**=` is `**` then `=`: the longest match takes two chars, and `=` starts the next token.
    a **= b
    a ** b
    // A lone `&` joins the bounds of a type parameter.
    fn bounded<T: A & B>() { }
}

// Literals: an integer, a float, a char, a string.
fn literals() {
    1 2.5 'a' "b"
    // A `//` in a string is text, not a comment.
    "a // b"
    // An escape in a char literal: the char after the `\` is part of it, so `'\''` ends at the
    // second `'`.
    '\'' '\\' '\n' '\u{e4}'
    // An escape in string text is consumed whole.
    "a\tb \"quoted\" \{braced\} \u{e4} \\"
}

// Interpolation: `StrHead` runs from the `"` to the `{`, `StrMiddle` from a `}` to the next
// `{`, and `StrTail` from a `}` to the `"`.
fn interpolation() {
    "head {a} tail"
    "{a}{b}"
    "x {a} y {b} z"
    // A string literal inside an interpolation.
    "a { "b" + "c" } d"
    "a { "b {c} d" } e"
    // A format spec runs from its `:` to the `}` that ends the interpolation, not including it.
    "{x:>8.2}"
    // A `{` in a spec opens a pair, and its `}` is part of the spec.
    "{x:>{w}}"
    "{x:\{}}"
    // A `\` in a spec is an ordinary char: it does not hide the `}`.
    "{x:\}"
    // A `:` inside a bracket of the interpolation is a `Colon`, not a spec.
    "{f(a: 1)}"
    "{xs[a: b]}"
    // After `\\` the `{` opens an interpolation, and after `\{` it does not.
    "\\{x}"
    "\{x\}"
    // `\u{` is an escape: its `{` opens nothing.
    "\u{e4}\u{1F600}"
    "\u{e4}{x}"
    // A `}` or `:` of a char literal or a string inside the interpolation does not end it.
    "{ c == '}' }"
    "{ "a:b" }"
    "{ ':' }"
}

// Columns count chars, not bytes. The token after a char that takes two bytes, or a tab, sits one
// column right of it.
fn columns() {
    "ä" + x
    'ä' + x
    "ä{a}ö{b}ä" + x
    a	b "ä"	c
}

// A `.` or `?.` at the start of a line continues the line above it, also after blank lines and
// comment lines.
fn continuation() {
    a
        .b()
    a

        .b()
    a
        // A comment line comes between.
        .b()
    a


        // Blank lines and a comment line.

        ?.b()
    // `..` and `..=` start a range, so they do not continue the line.
    a
        ..b
    a
        ..=b
}

// No `Newline` inside `(` or `[`, also after a token that could end a statement.
fn brackets() {
    f(a
        , b)
    g([a
        , b
    ])
    // A `{` inside them opens a block, and its line breaks end statements again.
    h(a, { b
        c })
}

// Where a number ends.
fn numbers() {
    // A tuple index: a digit run after `.` or `?.` has no fraction and no exponent.
    t.0.1
    x?.0
    t.0e10
    x?.0E2
    // A `.` that a `.` or a name follows ends an integer.
    1..2
    1.abs()
    1.e5
    // A fraction and an exponent.
    1.5e-3
    1.5E+3
    1e10
    2.5
    // A digit separator goes on in a fraction, and in an exponent.
    1.5_0
    1_000
    1.5e1_0
    // A prefixed number takes every ASCII letter, digit and `_`.
    0xFF_ff
    0b1010
    0o17
    0xdeadBEEF
}

// A line break after a token that can end a statement is a `Newline`. This holds after each kind
// of such token, `_`, `Self` and `?` among them.
fn endings() {
    a
    1
    1.5
    'c'
    "s"
    "{a}"
    true
    false
    return
    todo
    break
    continue
    None
    self
    Self
    _
    a?
    f()
    xs[0]
    if a { }
    // After any other token the statement goes on.
    a +
        b
    f(
        a,
    )
}

// A `;` in a block separates two statements on a line.
fn separators() {
    x; y
    // A `;` at the end of a line, and a `;` at the start, are redundant.
    x;
    ; y
    // A run of `;` is one: the first decides, and the others print nothing.
    x;;
    x;;; y
    // A `;` after `{` or before `}` is redundant.
    if a {; x }
    if a { x; }
    // A `;` before `else` is redundant: a `}` ends the line, `else` goes on with it.
    if a { }; else { }
    if a { }
    ; else { }
    // A `;` that joins two lines into a different statement stays, also when a line break stands
    // before it.
    a +; b
    a +
        ; b
    // A `;` in `(` and `[` is a `Semicolon` token, as in `[value; length]`.
    [0; 3]
    f(a; b)
    // A `.` after the run continues the line when nothing else ends the statement, so the `;`
    // separates.
    x;
        .f()
    x; .f()
    x; ?.f()
    // A `;` that follows no end of a statement stays before a `.` too.
    a +; .f()
    a +; ?.f()
    // A `;` at the start of a line stays when it joins nothing: it is before a `.`, and the line
    // above it ends.
    x
        ; .f()
    x
        ; ?.f()
    // After a `.`, the digits of a number are an integer, also with a `;` between.
    t.;0.5
}

// A `;` between top-level items. After a `fn`, `class`, `enum`, `interface` or `extend` item
// the `;` is redundant: the `}` ends the item.
fn first() {};fn main() {}
class C { };class D { }
enum E { };enum F { }
// After a `const` the `;` separates it from the item after it.
const X = 1; fn main() {}
// A run before a `const` after one of those items is redundant too.
fn first() {};const X = 1
// `interface` ends an item too. A run before it is redundant, and so is a run after it. But
// `const` before it makes the run a separator.
fn first() {};interface I { }
const A = 1
interface I { }; fn main() { }
const A = 1; interface I { }
// `extend` is the same.
fn first() {};extend C { }
const A = 1
extend C { }; fn main() { }
const A = 1; extend C { }
// A `;` cuts an item's header, and no item starts with `{`: it stays. After a `}` it separates.
fn first(); { }
const A = 1; { }
fn first() { }; { }
// A `;` between two methods of a class separates them: the item is not at the top level.
class C { fn f() {}; fn g() {} }

// A `>` or `??` that closes a type annotation ends the statement, so a line break after it is a
// `Newline`. After a comparison it does not.
fn annotations() {
    let b: Box<i64>
    let c = 1
    x: i64??
    y: Pair<A, Box<B>>
    z = a >
        b
    w = a ??
        b
    // A `;` after such a `>` or `??` separates, and after a token that goes on with the type it
    // stays.
    let d: Box<i64>; let e = 2
    x: i64??; y
    x: a +; b
    // A `;` ends the statement, and with it the annotation before it.
    let f: Box<i64>; g ??
        h
    // A `>=` after a type annotation starts its value, so a `>` that ends the line compares.
    a: b >= c < d >
        e
    // A loop keyword ends what the label's `:` started: `for` and `loop` too.
    outer: for a in b ??
        c { }
    outer: loop ??
        x { }
    // The annotation of a loop label does not start a type.
    outer: while a < b && c >
        d { break outer }
}

// A line break inside an open bound list goes on with the line.
fn first<T: A &
    B, U
    : C
    & D>() { }
class Pair<A, B
    : E> { }
interface Source {
    type Item: A
        & B
    type Other: C
}
extend<T: A
    & B> Stack<T> { }
// A bound's arguments keep the list open: a `.` in its name, and the `<` and `>` around them.
fn k<T: A.B
    & C>() { }
fn g<T: A<B>
    & C>() { }
// A line break after a token that can end a bound's arguments leaves no `Newline`: after a name,
// `>`, `]`, `?`, `??` or `Self`. The next line goes on with a name, `,`, `>`, `?` or `??`. A line
// break inside `[ ]` gives no `Newline` at all.
fn to<T: Convert<Kelvin>
>(x: T) { }
fn to<T: Convert<Kelvin>
, U>(x: T) { }
fn to<T: Convert<Kelvin
>>(x: T) { }
fn to<T: Convert<[i64]
>>(x: T) { }
fn to<T: Convert<K?
>>(x: T) { }
fn to<T: Convert<K
?>>(x: T) { }
fn to<T: Convert<K??
>>(x: T) { }
fn to<T: Convert<K
??>>(x: T) { }
fn to<T: Convert<Self
>>(x: T) { }
fn to<A
    B>() { }
// The `=` of `type X = ...` in an interface starts the type of its choice, so a `>` that ends the
// line closes it.
interface Chooser {
    type X = Box<i64>
    y
}

// The `->` starts the type of a method's result, so a `>` that ends the line closes it.
interface Boxes {
    fn f(self) -> Box<i64>
    fn g(self) -> Box<i64>
}

// A bracket gives its tokens a statement of their own, and the statement around it goes on after
// the bracket closes. So a `??` that ends a line after `( )`, `[ ]`, a block or an interpolation
// still sees the type of the header.
fn h1() -> Box<i64> { g(x) ??
    y }
fn h2() -> Box<i64> { [x] ??
    y }
fn h3() -> Box<i64> { if a { b } ??
    y }
fn h4() -> Box<i64> { "{x}" ??
    y }
fn h5() -> Box<i64> { x: A "{y}" ??
    z }
// The `}` that ends the body of a `fn`, `class`, `enum`, `interface` or `extend` ends the item.
// The next item can start on the same line.
fn f() { } class C<T: A
    & B> { }
// A block in the body of a class is no `(`: its `}` ends the method too.
class D { fn f() { } fn g<T: A
    & B>() { } }
// The `}` of an `if` ends no item, so the statement goes on, and a `fn` after it is no header.
fn i() {
    if a { } fn f<T: A
        & B>() { }
}

// A bound list is open only where a header or a `type X:` opens it. It ends at its own `>`, so a
// name after that starts a statement.
class C<T: Convert<K>>: Shape
foo
// A `??` that ends a bound closes a list that no `<` of its own opened.
fn t<T: K??
>() { }
// Only `type` opens a list at a `:`, with one name before the `:`, and not at a `->`.
pub Item: A
    & B
type X -> A
    & B
type 1: A
    & B
type X Y: A
    & B
// A `<` opens a list only as the third token of a header, or the second of an `extend`. It opens
// none in a statement that is no header.
fn h() {
    a b < c
        & d
}
fn q() -> Foo<A
    & B> { }
class A extend<T: B
    & C> { }
// The `=` of `type X = ...` starts a type only as its third token, and only in a `type`. Another
// token at that place, such as `>=`, starts none.
type X >= Box<i64>
    y
type X: A = Box<i64>
    y
x y = Box<i64>
    z

// A `}` ends the line, and `else` on the next line is a statement of its own.
fn branches() {
    if a { }
    else { }
}
// The lexer of Sisu, written in Sisu. It reads standard input and prints the tokens that
// `sisu build --emit tokens` prints for the same text, one `line:col Kind text` line each.
// A test compares the two outputs byte for byte. The program follows the clean path only: on text
// that the compiler's lexer reports an error for, its output is not specified.
//
// It has two passes. The first reads each line with `read_line` and walks its `chars()` once. It
// keeps the tokens in an array, and it decides at each line break whether a `Newline` follows.
// The second pass judges each run of `;` (ADR 0028) and prints the tokens.

// One variant for each `TokenKind` of the compiler's lexer. A variant has the name that
// `TokenKind::name()` gives it, so the generated `Display` prints the kind as the dump does.
enum Kind {
    Ident
    Underscore
    Int
    Float
    Char
    Str
    StrHead
    StrMiddle
    StrTail
    FormatSpec
    Fn
    Let
    Mut
    Var
    Reserved
    Todo
    If
    Else
    While
    For
    Loop
    In
    Return
    Break
    Continue
    Class
    Const
    Enum
    Interface
    Extend
    Match
    NoneKw
    Is
    SelfKw
    SelfType
    True
    False
    Plus
    Minus
    Star
    StarStar
    Slash
    Percent
    PlusEq
    MinusEq
    StarEq
    SlashEq
    PercentEq
    EqEq
    NotEq
    Lt
    Le
    Gt
    Ge
    AndAnd
    Amp
    OrOr
    Bang
    Eq
    LParen
    RParen
    LBrace
    RBrace
    Comma
    Colon
    Arrow
    FatArrow
    Pipe
    Dot
    DotDot
    DotDotEq
    LBracket
    RBracket
    Semicolon
    Question
    QuestionDot
    QuestionQuestion
    Newline
    Eof
}

// A token as the dump prints it: its kind, its position, and its text as written in the source.
class Token: Display {
    kind: Kind
    line: i64
    col: i64
    text: string

    fn to_string(self) -> string {
        match self.kind {
            Newline | Eof => "{self.line}:{self.col} {self.kind}"
            _ => "{self.line}:{self.col} {self.kind} {self.text}"
        }
    }
}

class Cell<T> {
    value: T
    next: Cell<T>?
}

class Stack<T> {
    mut head: Cell<T>?
    mut size: i64

    fn push(self, x: T) {
        self.head = Cell(value: x, next: self.head)
        self.size += 1
    }

    fn pop(self) -> T? {
        if let cell = self.head {
            self.head = cell.next
            self.size -= 1
            cell.value
        } else {
            None
        }
    }

    fn top(self) -> T? {
        if let cell = self.head {
            cell.value
        } else {
            None
        }
    }

    fn len(self) -> i64 {
        self.size
    }
}

// The cursor over one line: the line's chars, its number, and where the next char is.
class Text {
    cs: [char]
    line: i64
    mut at: i64

    fn peek(self, k: i64) -> char? {
        let i = self.at + k
        if i < self.cs.len() {
            self.cs[i]
        } else {
            None
        }
    }

    // gap: no marker says that a caller may drop this result, so a call that skips the char is
    // `let _ = text.next()`.
    fn next(self) -> char? {
        let c = self.peek(0)
        self.at += 1
        c
    }

    // The chars from `from` up to, but not including, `to`, as a string.
    // gap: a `[char]` has no slice, so the text of a token is pushed char by char.
    fn slice(self, from: i64, to: i64) -> string {
        let mut part: [char] = []
        let mut i = from
        while i < to {
            part.push(self.cs[i])
            i += 1
        }
        string(part)
    }
}

interface CharClass {
    fn has(self, c: char) -> bool
}

// gap: a `char` has no classification methods, so these two read the ranges.
fn is_digit(c: char) -> bool {
    match c {
        '0'..='9' => true
        _ => false
    }
}

fn is_alpha(c: char) -> bool {
    match c {
        'a'..='z' | 'A'..='Z' => true
        _ => false
    }
}

// ASCII letters, digits and `_`: what a name takes after its first char, and what a prefixed
// number takes after its prefix.
class NameChar: CharClass {
    fn has(self, c: char) -> bool {
        is_alpha(c) || is_digit(c) || c == '_'
    }
}

class DigitOrSeparator: CharClass {
    fn has(self, c: char) -> bool {
        is_digit(c) || c == '_'
    }
}

// Moves the cursor past the chars that `predicate` accepts.
fn take_while<C: CharClass>(text: Text, predicate: C) {
    while let c = text.peek(0) {
        if !predicate.has(c) {
            break
        }
        let _ = text.next()
    }
}

// gap: the exit code of a panic is 101, and a program cannot set another one.
fn unexpected(text: Text, at: i64) -> string {
    "lexer.sisu: unexpected input at {text.line}:{at + 1}"
}

fn keyword(word: string) -> Kind {
    match word {
        "fn" => Kind.Fn
        "let" => Kind.Let
        "mut" => Kind.Mut
        "var" => Kind.Var
        "import" | "pub" | "record" | "type" | "weak" | "test" | "extern" | "as" => Kind.Reserved
        "todo" => Kind.Todo
        "if" => Kind.If
        "else" => Kind.Else
        "while" => Kind.While
        "for" => Kind.For
        "loop" => Kind.Loop
        "in" => Kind.In
        "return" => Kind.Return
        "break" => Kind.Break
        "continue" => Kind.Continue
        "class" => Kind.Class
        "const" => Kind.Const
        "enum" => Kind.Enum
        "interface" => Kind.Interface
        "extend" => Kind.Extend
        "match" => Kind.Match
        "None" => Kind.NoneKw
        "is" => Kind.Is
        "self" => Kind.SelfKw
        "Self" => Kind.SelfType
        "true" => Kind.True
        "false" => Kind.False
        "_" => Kind.Underscore
        _ => Kind.Ident
    }
}

// Moves the cursor past the next char when it is `want`.
fn eat(text: Text, want: char) -> bool {
    if text.peek(0) == want {
        let _ = text.next()
        true
    } else {
        false
    }
}

// The operator or punctuation that starts with `c`, by longest match.
fn symbol(c: char, text: Text) -> Kind? {
    match c {
        '+' => if eat(text, '=') { Kind.PlusEq } else { Kind.Plus }
        '-' => if eat(text, '=') {
            Kind.MinusEq
        } else if eat(text, '>') {
            Kind.Arrow
        } else {
            Kind.Minus
        }
        '*' => if eat(text, '=') {
            Kind.StarEq
        } else if eat(text, '*') {
            Kind.StarStar
        } else {
            Kind.Star
        }
        '/' => if eat(text, '=') { Kind.SlashEq } else { Kind.Slash }
        '%' => if eat(text, '=') { Kind.PercentEq } else { Kind.Percent }
        '=' => if eat(text, '=') {
            Kind.EqEq
        } else if eat(text, '>') {
            Kind.FatArrow
        } else {
            Kind.Eq
        }
        '!' => if eat(text, '=') { Kind.NotEq } else { Kind.Bang }
        '<' => if eat(text, '=') { Kind.Le } else { Kind.Lt }
        '>' => if eat(text, '=') { Kind.Ge } else { Kind.Gt }
        '&' => if eat(text, '&') { Kind.AndAnd } else { Kind.Amp }
        '|' => if eat(text, '|') { Kind.OrOr } else { Kind.Pipe }
        '(' => Kind.LParen
        ')' => Kind.RParen
        '{' => Kind.LBrace
        '}' => Kind.RBrace
        ',' => Kind.Comma
        ':' => Kind.Colon
        '.' => if eat(text, '.') {
            if eat(text, '=') { Kind.DotDotEq } else { Kind.DotDot }
        } else {
            Kind.Dot
        }
        '[' => Kind.LBracket
        ']' => Kind.RBracket
        ';' => Kind.Semicolon
        '?' => if eat(text, '.') {
            Kind.QuestionDot
        } else if eat(text, '?') {
            Kind.QuestionQuestion
        } else {
            Kind.Question
        }
        _ => None
    }
}

// The opener that a closer closes.
fn opened_by(kind: Kind) -> char? {
    match kind {
        RParen => '('
        RBracket => '['
        RBrace => '{'
        _ => None
    }
}

fn opener(kind: Kind) -> char? {
    match kind {
        LParen => '('
        LBracket => '['
        LBrace => '{'
        _ => None
    }
}

// Whether a line break after a token of this kind ends a statement (Go's rule).
fn can_end_statement(kind: Kind) -> bool {
    match kind {
        Ident | Underscore | Int | Float | Char | Str | StrTail | True | False | Return | Todo |
        Break | Continue | NoneKw | SelfKw | SelfType | Question | RParen | RBracket |
        RBrace => true
        _ => false
    }
}

// Whether a token of this kind starts a header, which a `}` ends.
fn declares(kind: Kind) -> bool {
    match kind {
        Fn | Class | Enum | Interface | Extend => true
        _ => false
    }
}

// Whether a line break may follow a token of this kind inside an open bound list.
fn ends_in_list(kind: Kind) -> bool {
    match kind {
        Ident | Gt | RBracket | Question | QuestionQuestion | SelfType => true
        _ => false
    }
}

// Whether a line that starts with a token of this kind goes on with an open bound list. A `.`
// that goes on is `QuestionDot` or `Dot`, which every line continues.
fn goes_on_in_list(kind: Kind) -> bool {
    match kind {
        Ident | Comma | Colon | RBracket | Question | QuestionQuestion | Amp | Gt => true
        _ => false
    }
}

// What the first token of a statement was, and whether the statement may take a bound list.
enum Head {
    Unseen
    Plain
    Declaration
}

enum Start {
    Unseen
    TypeWord
    Other
}

// What the tokens of a statement so far, outside its closed brackets, show. The compiler's lexer
// keeps the same facts in its `Statement`.
class Statement {
    mut head: Head
    // After its last `:` or `->` that no `=` follows, how many more `>` than `<` there are.
    mut annotation: i64?
    mut tokens: i64
    // Whether a bound list is open, and how many `<` of a bound's arguments are open in it.
    mut params: bool
    mut nested: i64
    mut first: Start
    grouped: bool

    // Counts a token of `kind` into the bound list that is open, and tells whether the list was
    // open before it.
    fn keep_list_open(self, kind: Kind) -> bool {
        let opened = self.params
        let stays = match kind {
            Ident | Comma | Colon | Amp | Lt | LBracket | RBracket | Dot | Question |
            QuestionQuestion | SelfType => true
            Gt => self.nested > 0
            _ => false
        }
        self.params = opened && stays
        opened
    }
}

// gap: a field has no default value, so each `Statement` lists all its fields.
fn fresh() -> Statement {
    Statement(head: Head.Unseen, annotation: None, tokens: 0, params: false, nested: 0,
        first: Start.Unseen, grouped: false)
}

// Reads the tokens in order and keeps the statement that they end in, one for each open
// bracket.
class Tracker {
    mut current: Statement
    enclosing: Stack<Statement>
    mut prev: Kind

    // Whether a `>` or `??` that ends the tokens closes a type annotation.
    fn annotates(self) -> bool {
        self.current.annotation == 0
    }

    fn feed(self, kind: Kind, text: string) {
        let s = self.current
        if s.first == Start.Unseen {
            s.first = if kind == Kind.Reserved && text == "type" {
                Start.TypeWord
            } else {
                Start.Other
            }
        }
        if s.head == Head.Unseen {
            s.head = if declares(kind) { Head.Declaration } else { Head.Plain }
        }
        s.tokens += 1
        let opened = s.keep_list_open(kind)
        match kind {
            LBrace | LParen | LBracket | StrHead => {
                let block = kind == Kind.LBrace
                self.enclosing.push(s)
                let head = if block { Head.Unseen } else { s.head }
                let first = if block { Start.Unseen } else { s.first }
                self.current = Statement(head: head, annotation: None, tokens: 0, params: false,
                    nested: 0, first: first, grouped: !block)
            }
            RBrace | RParen | RBracket | StrTail => {
                let around = self.enclosing.pop() ?? fresh()
                // The `}` that ends the body of a declaration ends the item.
                let ends_item = kind == Kind.RBrace && around.head == Head.Declaration
                self.current = if ends_item && !around.grouped { fresh() } else { around }
            }
            Newline | Semicolon => {
                self.current = fresh()
            }
            Colon | Arrow => {
                s.annotation = 0
                if kind == Kind.Colon {
                    self.open_bounds(s, opened)
                }
            }
            Eq | Ge | While | For | Loop => {
                // The `=` of `type Item = ...` starts the type of an associated type's choice.
                let chooses = kind == Kind.Eq && s.tokens == 3 && s.first == Start.TypeWord
                s.annotation = if chooses { 0 } else { None }
            }
            Gt => {
                if let a = s.annotation {
                    s.annotation = a + 1
                }
                if s.params {
                    s.nested -= 1
                }
            }
            Lt => {
                if let a = s.annotation {
                    s.annotation = a - 1
                }
                if s.params {
                    s.nested += 1
                } else {
                    s.params = s.head == Head.Declaration && opens_list(self.prev, s.tokens)
                }
            }
            _ => {}
        }
        self.prev = kind
    }

    // Reads the `:` that was just counted. In an open list it starts the bounds of a parameter.
    // Outside one, the `:` of a `type Item:` opens the list of its bounds.
    fn open_bounds(self, s: Statement, in_list: bool) {
        let in_bounds = in_list && s.nested == 0
        if !in_bounds && s.tokens == 3 && self.prev == Kind.Ident && s.first == Start.TypeWord {
            s.params = true
        }
    }
}

// Whether a `<` after `prev`, the `tokens`th token of a header, opens its type-parameter list.
fn opens_list(prev: Kind, tokens: i64) -> bool {
    match prev {
        Ident => tokens == 3
        Extend => tokens == 2
        _ => false
    }
}

// A `;` that separates statements, which the second pass judges.
class Semi {
    // Where its token stands among the tokens.
    at: i64
    // Whether it stands between top-level items, after a `fn`, `class`, `enum`, `interface` or
    // `extend`.
    between_items: bool
    // Whether a `>` or `??` before it closes a type annotation.
    annotates: bool
}

// A `Newline` that a line break may leave: the next token can still go on with the line.
class Pending {
    line: i64
    col: i64
    // Whether an open bound list lets the line go on with a name, `,`, `:`, `&`, `>`, `]` or `?`.
    params: bool
}

// Skips the rest of an escape after its `\`: the char after it, and for `\u{...}` the digits
// through the `}`.
fn skip_escape(text: Text, start: i64) {
    let c = text.next() ?? panic(unexpected(text, start))
    if c == 'u' && text.peek(0) == '{' {
        while let d = text.next() {
            if d == '}' {
                break
            }
        }
    }
}

// Whether a float literal goes on after its digits: a fraction, an exponent, or both.
fn float_rest(text: Text) -> bool {
    let mut float = false
    if text.peek(0) == '.' && is_digit(text.peek(1) ?? ' ') {
        let _ = text.next()
        take_while(text, DigitOrSeparator())
        float = true
    }
    if text.peek(0) == 'e' || text.peek(0) == 'E' {
        let _ = text.next()
        if text.peek(0) == '+' || text.peek(0) == '-' {
            let _ = text.next()
        }
        take_while(text, DigitOrSeparator())
        float = true
    }
    float
}

// The first pass. It reads the lines and keeps their tokens, with the `Newline`s that line breaks
// leave.
class Lexer {
    mut tokens: [Token]
    mut semis: [Semi]
    // The open brackets, innermost on top. An interpolation's `{` is the char `"`.
    open: Stack<char>
    mut interps: i64
    tracker: Tracker
    // How many `;` that separate statements end the tokens, which the tracker has not read.
    mut trailing: i64
    // Whether the top-level item so far is a `fn`, `class`, `enum`, `interface` or `extend`. Such
    // an item ends at its `}`. A `const` ends at a line break.
    mut self_ending: bool
    // The kind of the last token that is not a `;`.
    mut last_code: Kind
    mut pending: Pending?

    // Whether the innermost open bracket is a block's `{`, or there is none.
    fn in_block(self) -> bool {
        match self.open.top() {
            Some(c) => c == '{'
            None => true
        }
    }

    // Whether a `}` or `:` now ends the expression of the innermost interpolation.
    fn at_end(self) -> bool {
        self.open.top() == '"'
    }

    // Adds a token that the source holds. A `Newline` that the last line break left goes in first,
    // unless this token goes on with the line.
    fn push(self, kind: Kind, text: Text, start: i64, spelled: string) {
        if let p = self.pending {
            self.pending = None
            let goes_on = kind == Kind.Dot || kind == Kind.QuestionDot ||
                p.params && goes_on_in_list(kind)
            if !goes_on {
                self.put(Kind.Newline, p.line, p.col, "")
            }
        }
        self.put(kind, text.line, start + 1, spelled)
    }

    // Adds a token to the tokens, and tells the tracker.
    fn put(self, kind: Kind, line: i64, col: i64, spelled: string) {
        let separator = kind == Kind.Semicolon && self.in_block()
        if self.open.len() == 0 {
            if declares(kind) {
                self.self_ending = true
            } else if kind == Kind.Const {
                self.self_ending = false
            }
        }
        if separator {
            let between_items = self.open.len() == 0 && self.self_ending
            let at = self.tokens.len()
            self.semis.push(Semi(at: at, between_items: between_items,
                annotates: self.tracker.annotates()))
            self.trailing += 1
        } else {
            // The `;`s before this token end the statement, whatever the first of them does.
            if self.trailing > 0 {
                self.tracker.feed(Kind.Semicolon, ";")
            }
            self.tracker.feed(kind, spelled)
            self.trailing = 0
        }
        if kind != Kind.Semicolon {
            self.last_code = kind
        }
        self.tokens.push(Token(kind: kind, line: line, col: col, text: spelled))
    }

    // Whether a line break here ends a statement. The token before the `;`s that end the tokens
    // must be one that can end a statement. The innermost open bracket must be a block's `{`.
    fn ends_statement(self) -> bool {
        let n = self.tokens.len()
        if n <= self.trailing || !self.in_block() {
            return false
        }
        let last = self.tokens[n - self.trailing - 1].kind
        can_end_statement(last) ||
            (last == Kind.Gt || last == Kind.QuestionQuestion) && self.tracker.annotates()
    }

    // The end of a line, whose text is `text`. The `Newline` goes at the column after the text.
    fn line_break(self, text: Text) {
        if self.interps > 0 {
            panic(unexpected(text, text.cs.len()))
        }
        if self.pending == None && self.ends_statement() {
            let n = self.tokens.len()
            let in_list = self.trailing == 0 && ends_in_list(self.tokens[n - 1].kind)
            let params = in_list && self.tracker.current.params
            self.pending = Pending(line: text.line, col: text.cs.len() + 1, params: params)
        }
    }

    fn lex_line(self, text: Text) {
        while let c = text.peek(0) {
            if c == ' ' || c == '\t' || c == '\r' {
                let _ = text.next()
            } else if c == '/' && text.peek(1) == '/' {
                text.at = text.cs.len()
            } else if is_alpha(c) || c == '_' {
                self.name(text)
            } else if is_digit(c) {
                self.number(text)
            } else if c == '\'' {
                self.char_literal(text)
            } else if c == '"' {
                self.string_part(text, false)
            } else if (c == '}' || c == ':') && self.at_end() {
                if c == '}' {
                    self.string_part(text, true)
                } else {
                    self.format_spec(text)
                }
            } else {
                self.operator(text)
            }
        }
        self.line_break(text)
    }

    fn name(self, text: Text) {
        let start = text.at
        take_while(text, NameChar())
        let word = text.slice(start, text.at)
        self.push(keyword(word), text, start, word)
    }

    fn number(self, text: Text) {
        let start = text.at
        let first = text.cs[start]
        let _ = text.next()
        // A digit run after a `.` is a tuple index or a fraction. The parser reads it. No fraction
        // and no exponent goes on after it.
        let after_dot = self.last_code == Kind.Dot || self.last_code == Kind.QuestionDot
        let p = text.peek(0)
        let prefixed = first == '0' &&
            (p == 'x' || p == 'X' || p == 'b' || p == 'B' || p == 'o' || p == 'O')
        let mut float = false
        if prefixed {
            let _ = text.next()
            take_while(text, NameChar())
        } else {
            take_while(text, DigitOrSeparator())
            if !after_dot {
                float = float_rest(text)
            }
        }
        let kind = if float { Kind.Float } else { Kind.Int }
        self.push(kind, text, start, text.slice(start, text.at))
    }

    fn char_literal(self, text: Text) {
        let start = text.at
        let _ = text.next()
        loop {
            let c = text.next() ?? panic(unexpected(text, start))
            if c == '\'' {
                break
            }
            if c == '\\' {
                skip_escape(text, start)
            }
        }
        self.push(Kind.Char, text, start, text.slice(start, text.at))
    }

    // The text of a string literal. It starts at the `"`, or, when `resumed`, at the `}` that ends
    // an interpolation. It ends at the closing `"` or at the `{` that opens an interpolation.
    fn string_part(self, text: Text, resumed: bool) {
        let start = text.at
        let _ = text.next()
        if resumed {
            let _ = self.open.pop()
            self.interps -= 1
        }
        let mut brace = false
        loop {
            let c = text.next() ?? panic(unexpected(text, start))
            if c == '"' {
                break
            }
            if c == '{' {
                brace = true
                break
            }
            if c == '\\' {
                skip_escape(text, start)
            }
        }
        // gap: a `match` takes no tuple pattern, so the two flags are two nested `if`s.
        let kind = if brace {
            if resumed { Kind.StrMiddle } else { Kind.StrHead }
        } else {
            if resumed { Kind.StrTail } else { Kind.Str }
        }
        if brace {
            self.open.push('"')
            self.interps += 1
        }
        self.push(kind, text, start, text.slice(start, text.at))
    }

    // The format spec after the `:` that ends an interpolation's expression: up to the `}` that
    // ends the interpolation, which is not part of it. A `{` in the spec opens a pair, and a `\`
    // is an ordinary char.
    fn format_spec(self, text: Text) {
        let start = text.at
        let mut pairs = 0
        loop {
            let c = text.peek(0) ?? panic(unexpected(text, start))
            if c == '"' {
                panic(unexpected(text, start))
            }
            if c == '}' && pairs == 0 {
                break
            }
            if c == '{' {
                pairs += 1
            } else if c == '}' {
                pairs -= 1
            }
            let _ = text.next()
        }
        self.push(Kind.FormatSpec, text, start, text.slice(start, text.at))
    }

    fn operator(self, text: Text) {
        let start = text.at
        let c = text.next() ?? panic(unexpected(text, start))
        let kind = symbol(c, text) ?? panic(unexpected(text, start))
        if let bracket = opener(kind) {
            self.open.push(bracket)
        } else if let bracket = opened_by(kind) {
            let top = self.open.pop() ?? panic(unexpected(text, start))
            if top != bracket {
                panic(unexpected(text, start))
            }
        }
        self.push(kind, text, start, text.slice(start, text.at))
    }

    // The end of the input: no bracket is open, and a `Newline` that the last line break left
    // stays.
    fn finish(self, text: Text) {
        if self.open.len() > 0 {
            panic(unexpected(text, text.cs.len()))
        }
        if let p = self.pending {
            self.pending = None
            self.put(Kind.Newline, p.line, p.col, "")
        }
    }
}

enum Judgement {
    Separator
    Redundant
    Kept
}

// What becomes of the first `;` of the run `tokens[i..end]`, in statement context. A `;` that
// separates two statements prints as a `Newline`, a redundant one prints nothing, and any other
// one prints as a `;`.
fn judge(tokens: [Token], i: i64, end: i64, semi: Semi) -> Judgement {
    let first = tokens[i]
    let has_prev = i > 0
    let prev = if has_prev { tokens[i - 1].kind } else { Kind.Newline }
    let has_next = end < tokens.len()
    let next = if has_next { tokens[end].kind } else { Kind.Eof }
    let break_before = !has_prev || prev == Kind.Newline || tokens[i - 1].line != first.line
    let break_after = !has_next || next == Kind.Newline || tokens[end].line != first.line
    // A `>` or `??` that closes a type annotation ends a statement, as at a line's end.
    let ends = has_prev && (can_end_statement(prev) ||
        (prev == Kind.Gt || prev == Kind.QuestionQuestion) && semi.annotates)
    if next == Kind.Dot || next == Kind.QuestionDot {
        // Without the `;`, the line break before the `.` would continue the line.
        if ends && !break_before {
            Judgement.Separator
        } else {
            Judgement.Kept
        }
    } else if has_prev && !ends && prev != Kind.LBrace && prev != Kind.Newline && !break_before {
        // Without the `;`, the lines would join into a different statement.
        Judgement.Kept
    } else if next == Kind.Else || break_before || break_after || prev == Kind.LBrace ||
        next == Kind.RBrace || semi.between_items && starts_item(next) {
        Judgement.Redundant
    } else if semi.between_items && prev != Kind.RBrace && next == Kind.LBrace {
        // The `;` cuts an item's header, and no item starts with `{`.
        Judgement.Kept
    } else {
        Judgement.Separator
    }
}

// Whether a token of this kind starts a top-level item, which needs no `;` before it.
fn starts_item(kind: Kind) -> bool {
    declares(kind) || kind == Kind.Const
}

// The second pass: prints the tokens, and the `Eof` after the last one that is not a `Newline`.
class Printer {
    mut eof_line: i64
    mut eof_col: i64

    fn show(self, t: Token) {
        print(t)
        if t.kind != Kind.Newline {
            self.eof_line = t.line
            self.eof_col = t.col + t.text.chars().len()
        }
    }
}

fn separate(tokens: [Token], semis: [Semi]) {
    let printer = Printer(eof_line: 1, eof_col: 1)
    let mut i = 0
    let mut k = 0
    while i < tokens.len() {
        let t = tokens[i]
        if t.kind == Kind.Semicolon && k < semis.len() && semis[k].at == i {
            let mut end = i
            while end < tokens.len() && tokens[end].kind == Kind.Semicolon {
                end += 1
            }
            let verdict = judge(tokens, i, end, semis[k])
            if verdict == Judgement.Separator {
                printer.show(Token(kind: Kind.Newline, line: t.line, col: t.col, text: ""))
            } else if verdict == Judgement.Kept {
                printer.show(t)
            }
            k += end - i
            i = end
        } else {
            printer.show(t)
            i += 1
        }
    }
    print(Token(kind: Kind.Eof, line: printer.eof_line, col: printer.eof_col, text: ""))
}

fn main() {
    let tracker = Tracker(current: fresh(), enclosing: Stack(head: None, size: 0),
        prev: Kind.Newline)
    let lexer = Lexer(tokens: [], semis: [], open: Stack(head: None, size: 0), interps: 0,
        tracker: tracker, trailing: 0, self_ending: false, last_code: Kind.Newline,
        pending: None)
    let mut last = Text(cs: [], line: 1, at: 0)
    let mut line = 0
    while let row = read_line() {
        line += 1
        last = Text(cs: row.chars(), line: line, at: 0)
        lexer.lex_line(last)
    }
    lexer.finish(last)
    separate(lexer.tokens, lexer.semis)
}
// Niches: an empty optional is kept in a spare value of its payload. A `char?` is an `i32` with
// `None` as 0x110000, a `bool?` is a byte with `None` as 2, and an enum optional uses the tag
// after the last variant. A nested optional uses the next spare value. Each value is made in
// each way, kept in an array, read back, and tested with `== None`, `if let` and `match`. A
// `None` never reads as a value, and no value reads as `None`.
class Holder<T> {
    v: T
}

enum E {
    A
    B
}

// `F` holds a string, so its optional is counted.
enum F {
    S(string)
    N
    M
}

enum G {
    A(f64)
    B
    C
}

// The ways to make a `None`, other than the literal.
fn nothing<T>() -> T? {
    None
}

fn filled<T>() -> T? {
    let xs: [T?] = [None; 3]
    xs[2]
}

fn or_none<T>(x: T?) -> T? {
    x ?? None
}

fn through<T>(h: Holder<T?>?) -> T? {
    h?.v
}

fn arm<T>(k: i64, x: T) -> T? {
    match k {
        0 => None
        _ => x
    }
}

// A string in a new block on each call.
fn text(n: i64) -> string {
    "s{n}"
}

// Each `show` function gives `== None`, then `if let`, then `match`, then a `??`.
fn show_char(c: char?) -> string {
    let by_if = if let v = c { "{i64(v)}" } else { "None" }
    let by_match = match c {
        None => "None"
        Some(v) => "{i64(v)}"
    }
    "{c == None} {by_if} {by_match} {i64(c ?? '?')}"
}

fn show_char2(c: char??) -> string {
    let by_if = if let v = c {
        if let w = v { "{i64(w)}" } else { "Some(None)" }
    } else {
        "None"
    }
    let by_match = match c {
        None => "None"
        Some(None) => "Some(None)"
        Some(Some(w)) => "{i64(w)}"
    }
    "{c == None} {by_if} {by_match} {i64((c ?? None) ?? '?')}"
}

fn show_bool(b: bool?) -> string {
    let by_if = if let v = b { "{v}" } else { "None" }
    let by_match = match b {
        None => "None"
        Some(true) => "true"
        Some(false) => "false"
    }
    "{b == None} {by_if} {by_match} {b ?? true}"
}

fn show_bool2(b: bool??) -> string {
    let by_if = if let v = b {
        if let w = v { "{w}" } else { "Some(None)" }
    } else {
        "None"
    }
    let by_match = match b {
        None => "None"
        Some(None) => "Some(None)"
        Some(Some(w)) => "{w}"
    }
    "{b == None} {by_if} {by_match} {(b ?? None) ?? true}"
}

fn name_e(e: E) -> string {
    match e {
        A => "A"
        B => "B"
    }
}

fn show_e(e: E?) -> string {
    let by_if = if let v = e { name_e(v) } else { "None" }
    let by_match = match e {
        None => "None"
        A => "A"
        B => "B"
    }
    "{e == None} {by_if} {by_match} {name_e(e ?? E.A)}"
}

fn show_e2(e: E??) -> string {
    let by_if = if let v = e {
        if let w = v { name_e(w) } else { "Some(None)" }
    } else {
        "None"
    }
    let by_match = match e {
        None => "None"
        Some(None) => "Some(None)"
        Some(Some(w)) => name_e(w)
    }
    "{e == None} {by_if} {by_match} {name_e((e ?? None) ?? E.A)}"
}

fn name_f(f: F) -> string {
    match f {
        S(s) => "S({s})"
        N => "N"
        M => "M"
    }
}

fn show_f(f: F?) -> string {
    let by_if = if let v = f { name_f(v) } else { "None" }
    let by_match = match f {
        None => "None"
        S(s) => "S({s})"
        N => "N"
        M => "M"
    }
    "{f == None} {by_if} {by_match} {name_f(f ?? F.N)}"
}

fn name_g(g: G) -> string {
    match g {
        A(x) => "A({x})"
        B => "B"
        C => "C"
    }
}

fn show_g(g: G?) -> string {
    let by_if = if let v = g { name_g(v) } else { "None" }
    let by_match = match g {
        None => "None"
        A(x) => "A({x})"
        B => "B"
        C => "C"
    }
    "{g == None} {by_if} {by_match} {name_g(g ?? G.B)}"
}

// An `F?` that one branch moves out of `f`. On the other path the end of the scope releases
// `f`; on this one, `f`'s slot holds its zero value, an `F.S` with no string.
fn keep_if(keep: bool) -> F? {
    let f: F? = F.S(text(3))
    let mut out: F? = None
    if keep {
        out = f
    }
    out
}

fn main() {
    let chars: [char?] = [
        None,
        nothing<char>(),
        filled<char>(),
        or_none<char>(None),
        through<char>(None),
        arm(0, 'a'),
        char(0x110000),
        char(-1),
        char(0xD800),
        '\0',
        '\u{10FFFF}',
        arm(1, '\u{10FFFF}'),
        or_none<char>('\0'),
        char(0),
        char(0x10FFFF),
        through<char>(Holder<char?>(v: '\u{10FFFF}')),
    ]
    print(show_char(chars[0]))                 // true None None 63
    print(show_char(chars[1]))                 // true None None 63
    print(show_char(chars[2]))                 // true None None 63
    print(show_char(chars[3]))                 // true None None 63
    print(show_char(chars[4]))                 // true None None 63
    print(show_char(chars[5]))                 // true None None 63
    print(show_char(chars[6]))                 // true None None 63
    print(show_char(chars[7]))                 // true None None 63
    print(show_char(chars[8]))                 // true None None 63
    print(show_char(chars[9]))                 // false 0 0 0
    print(show_char(chars[10]))                // false 1114111 1114111 1114111
    print(show_char(chars[11]))                // false 1114111 1114111 1114111
    print(show_char(chars[12]))                // false 0 0 0
    print(show_char(chars[13]))                // false 0 0 0
    print(show_char(chars[14]))                // false 1114111 1114111 1114111
    print(show_char(chars[15]))                // false 1114111 1114111 1114111

    // `char(0x110000)` is a `char?` `None`, so as a `char??` it is `Some(None)`.
    let chars2: [char??] = [
        None,
        nothing<char?>(),
        filled<char?>(),
        or_none<char?>(None),
        through<char?>(None),
        arm(0, Some('a')),
        Some(None),
        char(0x110000),
        Some('\0'),
        Some('\u{10FFFF}'),
        arm(1, Some('\0')),
    ]
    print(show_char2(chars2[0]))               // true None None 63
    print(show_char2(chars2[1]))               // true None None 63
    print(show_char2(chars2[2]))               // true None None 63
    print(show_char2(chars2[3]))               // true None None 63
    print(show_char2(chars2[4]))               // true None None 63
    print(show_char2(chars2[5]))               // true None None 63
    print(show_char2(chars2[6]))               // false Some(None) Some(None) 63
    print(show_char2(chars2[7]))               // false Some(None) Some(None) 63
    print(show_char2(chars2[8]))               // false 0 0 0
    print(show_char2(chars2[9]))               // false 1114111 1114111 1114111
    print(show_char2(chars2[10]))              // false 0 0 0

    let bools: [bool?] = [
        None,
        nothing<bool>(),
        filled<bool>(),
        or_none<bool>(None),
        through<bool>(None),
        arm(0, true),
        false,
        true,
        arm(1, false),
    ]
    print(show_bool(bools[0]))                 // true None None true
    print(show_bool(bools[1]))                 // true None None true
    print(show_bool(bools[2]))                 // true None None true
    print(show_bool(bools[3]))                 // true None None true
    print(show_bool(bools[4]))                 // true None None true
    print(show_bool(bools[5]))                 // true None None true
    print(show_bool(bools[6]))                 // false false false false
    print(show_bool(bools[7]))                 // false true true true
    print(show_bool(bools[8]))                 // false false false false

    let bools2: [bool??] = [
        None,
        nothing<bool?>(),
        filled<bool?>(),
        or_none<bool?>(None),
        through<bool?>(None),
        arm(0, Some(true)),
        Some(None),
        Some(false),
        Some(true),
    ]
    print(show_bool2(bools2[0]))               // true None None true
    print(show_bool2(bools2[1]))               // true None None true
    print(show_bool2(bools2[2]))               // true None None true
    print(show_bool2(bools2[3]))               // true None None true
    print(show_bool2(bools2[4]))               // true None None true
    print(show_bool2(bools2[5]))               // true None None true
    print(show_bool2(bools2[6]))               // false Some(None) Some(None) true
    print(show_bool2(bools2[7]))               // false false false false
    print(show_bool2(bools2[8]))               // false true true true

    let es: [E?] = [
        None,
        nothing<E>(),
        filled<E>(),
        or_none<E>(None),
        through<E>(None),
        arm(0, E.B),
        E.A,
        E.B,
    ]
    print(show_e(es[0]))                       // true None None A
    print(show_e(es[1]))                       // true None None A
    print(show_e(es[2]))                       // true None None A
    print(show_e(es[3]))                       // true None None A
    print(show_e(es[4]))                       // true None None A
    print(show_e(es[5]))                       // true None None A
    print(show_e(es[6]))                       // false A A A
    print(show_e(es[7]))                       // false B B B

    let es2: [E??] = [
        None,
        nothing<E?>(),
        filled<E?>(),
        or_none<E?>(None),
        through<E?>(None),
        arm(0, Some(E.B)),
        Some(None),
        Some(E.A),
        Some(E.B),
    ]
    print(show_e2(es2[0]))                     // true None None A
    print(show_e2(es2[1]))                     // true None None A
    print(show_e2(es2[2]))                     // true None None A
    print(show_e2(es2[3]))                     // true None None A
    print(show_e2(es2[4]))                     // true None None A
    print(show_e2(es2[5]))                     // true None None A
    print(show_e2(es2[6]))                     // false Some(None) Some(None) A
    print(show_e2(es2[7]))                     // false A A A
    print(show_e2(es2[8]))                     // false B B B

    let fs: [F?] = [
        None,
        nothing<F>(),
        filled<F>(),
        or_none<F>(None),
        through<F>(None),
        arm(0, F.M),
        F.S(text(1)),
        F.M,
    ]
    print(show_f(fs[0]))                       // true None None N
    print(show_f(fs[1]))                       // true None None N
    print(show_f(fs[2]))                       // true None None N
    print(show_f(fs[3]))                       // true None None N
    print(show_f(fs[4]))                       // true None None N
    print(show_f(fs[5]))                       // true None None N
    print(show_f(fs[6]))                       // false S(s1) S(s1) S(s1)
    print(show_f(fs[7]))                       // false M M M
    print(show_f(keep_if(true)))               // false S(s3) S(s3) S(s3)
    print(show_f(keep_if(false)))              // true None None N

    let gs: [G?] = [
        None,
        nothing<G>(),
        filled<G>(),
        or_none<G>(None),
        through<G>(None),
        arm(0, G.C),
        G.A(1.5),
        G.C,
    ]
    print(show_g(gs[0]))                       // true None None B
    print(show_g(gs[1]))                       // true None None B
    print(show_g(gs[2]))                       // true None None B
    print(show_g(gs[3]))                       // true None None B
    print(show_g(gs[4]))                       // true None None B
    print(show_g(gs[5]))                       // true None None B
    print(show_g(gs[6]))                       // false A(1.5) A(1.5) A(1.5)
    print(show_g(gs[7]))                       // false C C C

    // `==` tests presence first, then compares the payloads as the payload type does.
    let no_bool: bool? = None
    let no: bool? = false
    print(no_bool == no)                       // false
    print(no == no_bool)                       // false
    let zero: char? = '\0'
    print(zero == chars[0])                    // false
    let first: E? = E.A
    print(first == es[0])                      // false
    let s1: string? = text(7)
    let s2: string? = text(7)
    print(s1 == s2)                            // true
    let t1: string?? = Some(text(8))
    let t2: string?? = Some(text(8))
    print(t1 == t2)                            // true
    let a1: [i64]? = [1, 2]
    let a2: [i64]? = [1, 2]
    print(a1 == a2)                            // true
    let nan: G? = G.A(f64.nan)
    print(nan == nan)                          // false
    let plus: G? = G.A(0.0)
    let minus: G? = G.A(-0.0)
    print(plus == minus)                       // true
}
// GIVEN an enum `Expr` that holds itself inline under two `?`s (`Pair`) and under three (`Tri`)
// AND `Expr` has 256 variants, so its tag has no spare value and each `?` is a flag
// AND the variant after `Lit` has no payload, so a walk that reads a flag as a tag stops at once
// AND 15 values with `None`, `Some(None)`, `Some(Some(None))` and a value at each layer of a link
// AND two of them have the absent layer deep in a chain of two `Expr`
// WHEN each value is printed
// AND every value of one list is compared with `==` to every value of a second list
// AND both lists are dropped
// THEN the padding has 252 variants
// AND each absent layer prints as `None` under one `Some(` for each layer above it
// AND `==` is true for the same value only, also when the values differ in layer 2 or 3 alone
// AND every string is released once
enum Two<T> {
    Both(T??, T??)
}

