fn lit(s: string) -> Expr { Expr.Lit("lit {s}") }

fn values() -> [Expr] {
    [
        // Pair(Both(None, None))
        Expr.Pair(Two.Both(None, None)),
        // Pair(Both(Some(None), None))
        Expr.Pair(Two.Both(Some(None), None)),
        // Pair(Both(None, Some(None)))
        Expr.Pair(Two.Both(None, Some(None))),
        // Pair(Both(Lit("lit a"), Some(None)))
        Expr.Pair(Two.Both(Some(Some(lit("a"))), Some(None))),
        // Pair(Both(Lit("lit a"), Lit("lit b")))
        Expr.Pair(Two.Both(Some(Some(lit("a"))), Some(Some(lit("b"))))),
        // Pair(Both(Lit("lit a"), Lit("lit c")))
        Expr.Pair(Two.Both(Some(Some(lit("a"))), Some(Some(lit("c"))))),
        // The absent layer is the second layer of a link in the inner `Pair`.
        // Pair(Both(Pair(Both(Some(None), None)), None))
        Expr.Pair(Two.Both(Some(Some(Expr.Pair(Two.Both(Some(None), None)))), None)),
        // Pair(Both(Pair(Both(None, None)), None))
        Expr.Pair(Two.Both(Some(Some(Expr.Pair(Two.Both(None, None)))), None)),
        // Tri(Both(None, None), 1)
        Expr.Tri(Two.Both(None, None), 1),
        // Tri(Both(Some(None), Some(Some(None))), 1)
        Expr.Tri(Two.Both(Some(None), Some(Some(None))), 1),
        // Tri(Both(Some(Some(None)), Some(Some(None))), 1)
        Expr.Tri(Two.Both(Some(Some(None)), Some(Some(None))), 1),
        // Tri(Both(Some(Some(None)), Lit("lit c")), 1)
        Expr.Tri(Two.Both(Some(Some(None)), Some(Some(Some(lit("c"))))), 1),
        // Tri(Both(Some(Some(None)), Lit("lit c")), 2)
        Expr.Tri(Two.Both(Some(Some(None)), Some(Some(Some(lit("c"))))), 2),
        // The absent layer is the third layer of a link in the inner `Tri`.
        // Tri(Both(Tri(Both(Some(Some(None)), None), 3), None), 4)
        Expr.Tri(Two.Both(Some(Some(Some(Expr.Tri(Two.Both(Some(Some(None)), None), 3)))), None), 4),
        // Pair(Both(Nil, Nil))
        Expr.Pair(Two.Both(Some(Some(Expr.Nil)), Some(Some(Expr.Nil)))),
    ]
}

