fn main() {
    // 252
    print(padding().len())
    let xs = values()
    let ys = values()
    for x in xs {
        print(x)
    }
    // Row i, column j is `T` when value i equals value j: `T` on the diagonal only.
    for i in 0..15 {
        let mut row = ""
        for j in 0..15 {
            row = if xs[i] == ys[j] { "{row}T" } else { "{row}." }
        }
        print(row)
    }
}
// Every type prints at the top level, through `print` and `eprint` (a generic `both` runs
// both on its argument, and then prints the same value through `"{x}"` and `x.to_string()`), by
// the rows of the spec's "Printing" table. A `string` or a `char` is
// bare alone and quoted in an array, a payload or an optional; an optional is transparent, and
// by the Some rule `Some(` wraps only a `None`; a variant has no enum name and keeps its labels;
// a class is its name with its type arguments; a written `to_string`'s text is raw wherever the
// value sits. `printing_optionals.sisu` prints an optional at the top level.
class Node {}

class Stack<T> {
    _items: [T]
}

// A written `to_string`, which prints raw: it holds quotes and no escape is added.
class Celsius {
    degrees: f64
}

extend Celsius: Display {
    fn to_string(self) -> string {
        "{self.degrees} \"C\""
    }
}

// A `to_string` that prints: the inner line goes out where the outer line has got to.
class Loud {
    _n: i64
}

extend Loud: Display {
    fn to_string(self) -> string {
        print("called")
        "loud"
    }
}

// A conditional record: `Node` has no `Eq`, so a `Box<Node>` prints as the generated rule says.
class Box<T> {
    _value: T
}

extend<T: Eq> Box<T>: Display {
    fn to_string(self) -> string {
        "boxed"
    }
}

// A plain block whose bounds fail for a `Node`: `to_string` falls back to the generated
// `Display`, which prints the name.
class Plain<T> {
    _value: T
}

extend<T: Eq> Plain<T> {
    fn to_string(self) -> string {
        "plain"
    }
}

interface Tag<X> {}

class C: Tag<i64> {}

class D: Tag<string> {}

class Label<T> {
    _value: T
}

extend<T: Tag<string>> Label<T>: Display {
    fn to_string(self) -> string {
        "label"
    }
}

enum Expr {
    Num(i64)
    Add(Expr, Expr)
}

enum Shape {
    Dot
    Rect(w: i64, h: i64)
    Named(string, char)
}

enum Tree {
    Leaf
    Node(Tree, Tree)
}

enum Wrap {
    Has(Celsius)
    Many([Tree])
    Nothing(Tree?)
}

// An inline `T?` link that holds `None`, as `deeppair.sisu` has with a link that is optional.
enum Two<T> {
    Both(T, T?)
}

enum Pairs {
    Lit(i64)
    Pair(Two<Pairs>)
}

// A written `to_string` on an enum, on a member of a component with boxes, and on a class that
// keeps its receiver, so that the method owns `self`.
enum Level {
    Low
    High
}

extend Level: Display {
    fn to_string(self) -> string {
        "level"
    }
}

enum Ring {
    End
    Next(Ring)
}

extend Ring: Display {
    fn to_string(self) -> string {
        "ring"
    }
}

enum PA {
    ToB(PB)
}

enum PB {
    ToA(PA)
    End
}

extend PB: Display {
    fn to_string(self) -> string {
        "pb"
    }
}

class Keeper {
    _n: i64
}

extend Keeper: Display {
    fn to_string(self) -> string {
        let kept = [self]
        "kept{kept.len()}"
    }
}

// Links that are not the last field: two of them wait at once, with labels; and boxed links
// under one and two `?`.
enum Tri {
    Leaf
    Node(left: Tri, mid: Tri, right: Tri)
}

enum Maybe {
    End
    Next(Maybe?)
}

enum Maybe2 {
    End
    Next(Maybe2??)
}

// `print`, `eprint`, the interpolation, the interpolation with `#` and `to_string` write one text
// when it fits in 80 columns. The line of `eprint` goes to the other stream.
fn both<T>(x: T) {
    print(x)
    eprint(x)
    print("{x}")
    print("{x:#}")
    print(x.to_string())
}

fn via_bound<T: Display>(x: T) -> string {
    x.to_string()
}

// The parts are evaluated before the buffer: a `return` in a part leaves the text of `e` to be
// released and no buffer behind.
fn tail(stop: bool) -> string {
    let e = Expr.Add(Expr.Num(1), Expr.Num(2))
    "{e}{if stop { return "done" } else { 0 }}"
}

// A part of a type parameter pads as its type argument does: a number on the right, and any
// other value on the left, when the spec has no alignment.
fn padded<T>(x: T) -> string {
    "[{x:5}][{x:>5}][{x:^5}]"
}

fn deep(n: i64) -> Expr {
    if n == 0 {
        Expr.Num(0)
    } else {
        Expr.Add(Expr.Num(n), deep(n - 1))
    }
}

fn main() {
    // Scalars print as they always did.
    both(42)
    both(2.5)
    both(true)
    both('x')
    both("hi")

    // A `string` and a `char` with each escape, bare alone and quoted in an array.
    for s in ["a\"b", "it's", "back\\slash", "tab\there", "line\nbreak", "cr\rx", "nul\0y", "\u{1}", "\u{1B}", "\u{7F}", "ä"] {
        both(s)
        both([s])
    }
    for c in ['"', '\'', '\\', '\n', '\t', '\r', '\0', '\u{1}', 'ä'] {
        both(c)
        both([c])
    }

    // Arrays of each element type.
    both([1, 2])
    both([2.5, 0.5])
    both([true, false])
    both(["a", "b"])
    both(['x'])
    both([[1], [2, 3]])
    both([Expr.Num(1), Expr.Num(2)])
    let none: [i64] = []
    both(none)

    // Optionals inside an array, by the Some rule.
    let middle: i64? = None
    let five: i64? = 5
    let n0: i64?? = None
    let n1: i64?? = middle
    let n2: i64?? = five
    both([n0])                      // [None]
    both([n1])                      // [Some(None)]
    both([n2])                      // [5]
    let m0: i64??? = None
    let m1: i64??? = n0
    let m2: i64??? = n1
    let m3: i64??? = n2
    both([m0, m1, m2, m3])          // [None, Some(None), Some(Some(None)), 5]
    let mixed: [i64?] = [1, None]
    both(mixed)                     // [1, None]
    let wrapped: [i64??] = [Some(None)]
    both(wrapped)                     // [Some(None)]
    let s0: string?? = Some("hi")
    let s1: string?? = None
    both([s0])                      // ["hi"]
    both([s1])                      // [None]
    let c0: char?? = Some('q')
    both([c0])                      // ['q']
    both([Tree.Leaf, Tree.Node(Tree.Leaf, Tree.Leaf)])

    // Classes: a name and its type arguments, never the fields.
    both(Node())
    both(Stack(_items: [1, 2]))
    both(Stack(_items: [["a"]]))
    both([Node()])

    // A written `to_string`: raw alone, in an array, in a payload and under optionals.
    let c = Celsius(degrees: 21.5)
    both(c)
    both([c])
    both(Wrap.Has(c))
    let cs: Celsius?? = Some(c)
    both([cs])
    let c1: Celsius? = None
    let cs1: Celsius?? = c1
    both([cs1])

    // A written `to_string` that prints.
    both([Loud(_n: 1)])

    // A conditional record: the bound decides, and its interface arguments too.
    both(Box(_value: Node()))
    both(Box(_value: 1))
    both([Box(_value: 1)])
    both(Label(_value: C()))
    both(Label(_value: D()))

    // Variants: no enum name, labels kept, a fieldless one alone and in a payload.
    both(Expr.Add(Expr.Num(1), Expr.Num(2)))
    both(Shape.Dot)
    both(Shape.Rect(w: 2, h: 3))
    both(Shape.Named("a\"b", 'c'))
    both([Shape.Rect(w: 2, h: 3), Shape.Dot])
    both(Tree.Leaf)
    both(Tree.Node(Tree.Leaf, Tree.Node(Tree.Leaf, Tree.Leaf)))
    both(Wrap.Many([Tree.Leaf]))
    both(Wrap.Nothing(None))
    both(Wrap.Nothing(Tree.Leaf))
    both(Pairs.Pair(Two.Both(Pairs.Lit(1), None)))
    both(Pairs.Pair(Two.Both(Pairs.Lit(1), Pairs.Lit(2))))

    // Written `to_string`s on an enum, in a component and in a class that keeps `self`.
    both(Level.Low)
    both([Level.High])
    both(Ring.Next(Ring.End))
    both(PA.ToB(PB.End))
    both(PA.ToB(PB.ToA(PA.ToB(PB.End))))
    both([Keeper(_n: 1)])

    // Links that wait, with labels, and boxed links under `?`.
    both(Tri.Node(left: Tri.Node(left: Tri.Leaf, mid: Tri.Leaf, right: Tri.Leaf), mid: Tri.Leaf, right: Tri.Node(left: Tri.Leaf, mid: Tri.Leaf, right: Tri.Leaf)))
    both(Maybe.Next(None))
    both(Maybe.Next(Maybe.End))
    both(Maybe.Next(Maybe.Next(Maybe.End)))
    both(Maybe2.Next(None))
    let middle2: Maybe2? = None
    both(Maybe2.Next(middle2))
    let inner2: Maybe2? = Maybe2.End
    both(Maybe2.Next(inner2))

    // A type parameter that stands for an optional prints it alone: transparent, by the Some rule.
    let hi: string? = "hi"
    let no_string: string? = None
    let q: char? = 'q'
    both(hi)                        // hi
    both(no_string)                 // None
    both(q)                         // q
    both(n0)                        // None
    both(n1)                        // Some(None)
    both(n2)                        // 5
    both(m2)                        // Some(Some(None))

    // `to_string` takes an optional, which prints by the Some rule.
    let ss: string?? = Some("hi")
    print(n0.to_string())           // None
    print(n1.to_string())           // Some(None)
    print(n2.to_string())           // 5
    print(m0.to_string())           // None
    print(m1.to_string())           // Some(None)
    print(m2.to_string())           // Some(Some(None))
    print(m3.to_string())           // 5
    print(ss.to_string())           // hi

    // `to_string` of each scalar is the text that `print` writes.
    let small: u8 = 7
    print(5.to_string())
    print((0 - 5).to_string())
    print(small.to_string())
    print(2.5.to_string())
    print(true.to_string())
    print('x'.to_string())
    print("hi".to_string())
    print([1, 2].to_string())

    // `to_string` through a bound, on a number and on an enum.
    print(via_bound(1))
    print(via_bound(Expr.Num(1)))

    // The width pads the text of a compound part in place, from where the part starts.
    let e = Expr.Add(Expr.Num(1), Expr.Num(2))
    let x = 3.14159
    print("{e:>30}")
    print("{e:<30}|")
    print("{e:^30}|")
    print("{e:>5}|")
    print("[{e:>22}]")
    print("{e} {x:.2}")
    print("{[1, 2]:>10}|{Node():<6}|{Shape.Dot:>5}|")

    // The default alignment of a width follows the type argument.
    print(padded(1))
    print(padded(small))
    print(padded(2.5))
    print(padded("a"))
    print(padded('x'))
    print(padded(true))
    print(padded(Expr.Num(1)))

    // A part that leaves evaluates before any text is written.
    print(tail(false))
    print(tail(true))

    // A text longer than 128 bytes grows the buffer twice.
    let long = deep(12).to_string()
    print(long.len())
    print(long)
    print("{deep(12)}!".len())

    // A conditional block whose bounds fail: `to_string` is the generated `Display`.
    print(Plain(_value: Node()).to_string())
    print(Plain(_value: 1).to_string())
    print(Box(_value: Node()).to_string())
    print(Box(_value: 1).to_string())
}
// `==` and the order operators run through `Eq` and `Ord`. A generic body compiles to the same
// code as the function written for its type: a number keeps its IEEE comparison, and a class with
// a written `Ord` calls its `less`. Every `Circle` holds a counted `string`, so Valgrind and
// `--rc-checks` see a part that a helper passes to a written method without its own reference.
// Results print as scalars and strings only.
class Circle: Eq, Ord {
    name: string
    r: i64
    fn eq(self, other: Self) -> bool {
        self.r == other.r
    }
    fn less(self, other: Self) -> bool {
        self.r < other.r
    }
}

enum Pick {
    One(Circle)
    Nothing
}

enum Expr: Eq {
    Num(i64)
    Add(Expr, Expr)
}

// An enum with a written `Ord` and the `Eq` that the compiler writes.
enum Level: Eq, Ord {
    Low
    High
    fn less(self, other: Self) -> bool {
        self.rank() < other.rank()
    }
    fn rank(self) -> i64 {
        match self {
            Level.Low => 0
            Level.High => 1
        }
    }
}

// An enum with a written `Eq`, compared inside an array: the helper calls its `eq`, which says
// `true` for any pair.
enum Sign: Eq {
    Neg
    Pos
    fn eq(self, _other: Self) -> bool {
        true
    }
}

// Two enums that hold each other, so that `A`'s `==` walks into `B` through a link; `B` writes its
// own `eq`, which says `true` for any pair, so the walk calls it instead of looking inside.
enum A: Eq {
    X(B)
    End
}

enum B: Eq {
    Y(A)
    End
    fn eq(self, _other: Self) -> bool {
        true
    }
}

class Box<T> {
    value: T
}

// The opposite of the fields' equality, so that the structural `==` of a class shows.
extend<T: Eq> Box<T>: Eq {
    fn eq(self, other: Self) -> bool {
        self.value != other.value
    }
}

// `Tag` is a bound that the output keeps no record of: `mono` decides it in the input's ids.
interface Tag {}

class C: Tag {}

class Tagged<T> {
    _value: T
}

extend<T: Tag> Tagged<T>: Eq {
    fn eq(self, _other: Self) -> bool {
        false
    }
}

class Score: Eq, Ord {
    n: i64
    fn eq(self, other: Self) -> bool {
        self.n == other.n
    }
    fn less(self, other: Self) -> bool {
        self.n < other.n
    }
}

class Slot<T> {
    value: T
}

extend<T: Ord> Slot<T>: Eq {
    fn eq(self, other: Self) -> bool {
        !(self.value < other.value)
    }
}

// A written `eq` that keeps its parameter: `other` is owned, so a helper retains the part first.
class Keeper: Eq {
    mut _last: Keeper?
    name: string
    fn eq(self, other: Self) -> bool {
        self._last = other
        true
    }
}

// An `eq` that is not reflexive: the same array or box is not equal to itself.
class Never: Eq {
    _n: i64
    fn eq(self, _other: Self) -> bool {
        false
    }
}

enum Link {
    Cons(Never, Link)
    End
}

fn largest<T: Ord>(xs: [T]) -> T? {
    let mut best: T? = None
    for x in xs {
        if let b = best {
            if x > b {
                best = x
            }
        } else {
            best = x
        }
    }
    best
}

fn le<T: Ord>(a: T, b: T) -> bool {
    a <= b
}

fn between<T: Ord>(a: T, b: T, c: T) -> bool {
    a < b < c
}

fn same<T: Eq>(a: T, b: T) -> bool {
    a == b
}

fn same_items<T: Eq>(a: [T], b: [T]) -> bool {
    a == b
}

fn f() -> Circle {
    print("f")
    Circle(name: "f{1}", r: 1)
}

fn g() -> Circle {
    print("g")
    Circle(name: "g{2}", r: 2)
}

fn h() -> Circle {
    print("h")
    Circle(name: "h{3}", r: 3)
}

fn main() {
    let none: [i64] = []
    print(largest([3, 9, 2]) ?? -1)                    // 9
    print(largest(["b", "c", "a"]) ?? "")              // c
    print(largest([1.5, 0.5, 2.5]) ?? 0.0)             // 2.5
    print(largest([f64.nan, 1.0, 3.0]) ?? 0.0)         // nan: nothing is greater than a nan
    print(largest([1.0, f64.nan, 3.0]) ?? 0.0)         // 3.0
    print((largest([Circle(name: "a{1}", r: 4), Circle(name: "b{2}", r: 7), Circle(name: "c{3}", r: 5)]) ?? Circle(name: "z", r: 0)).name) // b2
    print(largest(none) ?? -1)                         // -1

    print(le(1.0, 2.0))                                // true
    print(le(2.0, 2.0))                                // true
    print(le(f64.nan, 1.0))                            // false: a nan on the left
    print(le(1.0, f64.nan))                            // false: a nan on the right
    print(le(Circle(name: "a{1}", r: 1), Circle(name: "b{2}", r: 2))) // true
    print(le(Circle(name: "a{1}", r: 3), Circle(name: "b{2}", r: 2))) // false

    print(between(1, 2, 3))                            // true
    print(between("a", "c", "b"))                      // false: a chain of `string`s
    print(between(1.5, 2.5, 3.5))                      // true
    print(between(f(), g(), h()))                      // f g h true: a chain of written `less`
    print(Level.Low < Level.High)                      // true
    print(Level.High <= Level.Low)                     // false
    print(Level.Low == Level.Low)                      // true: the enum's generated `Eq`
    print((largest([Level.Low, Level.High, Level.Low]) ?? Level.Low) == Level.High) // true

    // The names show source order, and the skipped link.
    print(f() > g())                                   // f g false
    print(f() <= g())                                  // f g true
    print(f() < g() < h())                             // f g h true
    print(g() < f() < h())                             // g f false: the chain skips h

    print([Box(value: 1)].contains(Box(value: 2)))     // true: the written `eq` says they differ
    print([Box(value: 2)].contains(Box(value: 2)))     // false

    // A shared array or box compared with itself: the written `eq` says `false`.
    let shared = [Never(_n: 1)]
    print(shared == shared)                            // false
    let link = Link.Cons(Never(_n: 1), Link.End)
    print(link == link)                                // false

    let a = Circle(name: "a{1}", r: 1)
    let b = Circle(name: "b{2}", r: 2)
    let c = Circle(name: "c{3}", r: 1)
    print(same(1, 2))                                  // false
    print(same("a", "a"))                              // true
    print(same(1.5, 1.5))                              // true
    print(same(true, false))                           // false
    print(same('a', 'a'))                              // true
    print(same([1, 2], [1, 2]))                        // true
    print(same("x{1}", "x{1}"))                        // true
    print(same(a, b))                                  // false
    print(same(a, c))                                  // true
    print(same_items([1, 2], [1, 3]))                  // false
    print(same_items([a, b], [c, b]))                  // true
    print(same_items([a], [b]))                        // false

    let maybe: Circle? = c
    let nothing: Circle? = None
    print(a == maybe)                                  // true: `a` becomes an optional, and the helper calls `eq`
    print(a == nothing)                                // false: a missing value is not equal, and `eq` is not called
    print(a == c)                                      // true
    print(a != c)                                      // false
    print(a < b)                                       // true
    print(a >= b)                                      // false
    print(a < b < b)                                   // false
    print(a < b <= b)                                  // true
    print([a] == [c])                                  // true
    print([a, b] == [c, b])                            // true
    print([a] == [b])                                  // false
    print(Pick.One(a) == Pick.One(c))                  // true
    print(Pick.One(a) == Pick.One(b))                  // false
    print(Pick.One(a) == Pick.Nothing)                 // false
    print([a, b].contains(c))                          // true
    print([b].contains(a))                             // false

    let e1 = Expr.Add(Expr.Num(1), Expr.Num(2))
    let e2 = Expr.Add(Expr.Num(1), Expr.Num(2))
    let e3 = Expr.Add(Expr.Num(1), Expr.Num(3))
    print(e1 == e2)                                    // true
    print(e1 == e3)                                    // false

    print([Sign.Neg] == [Sign.Pos])                    // true: the written `eq` of the enum
    print(A.X(B.Y(A.End)) == A.X(B.End))               // true: `B`'s written `eq` ends the walk
    print(A.X(B.End) == A.End)                         // false: the tags of `A` differ

    print([Tagged(_value: C())] == [Tagged(_value: C())]) // false: the written `eq`, not the fields
    print([Slot(value: Score(n: 2))] == [Slot(value: Score(n: 1))]) // true: `!(2 < 1)`

    let k1 = Keeper(_last: None, name: "k{1}")
    let k2 = Keeper(_last: None, name: "k{2}")
    print([k1] == [k2])                                // true
    print([k1].contains(k2))                           // true
    print(k1.name + k2.name)                           // k1k2
}
// Patterns on optionals. At an optional position, `Some(p)` and `None` match the optional
// itself, a variant, literal or range pattern matches the value inside, an `|` applies the rule
// to each alternative, and a name or `_` covers the whole optional. Only the top of an `if let`
// or `while let` unwraps. Counted payloads are matched and released, from owned scrutinees and
// from borrowed ones, also under the box of a recursive optional field and through a `Some` on
// a path under a box.
class Node {
    n: i64
}

class Pile {
    mut n: i64

    fn pop(self) -> string? {
        if self.n == 0 {
            return None
        }
        self.n = self.n - 1
        "item {self.n}"
    }
}

enum Shape {
    Circle(string)
    Square(i64)
}

enum Holder {
    V(Shape?)
    W(i64?)
}

enum E {
    End
    Next(E?)
}

enum D {
    End
    Next(D??)
}

enum K {
    Leaf
    Node(K, string?)
}

enum Chain {
    Stop
    Link(i64, Chain)
}

enum Slot {
    S(Chain?)
}

enum Mark {
    Dot(string)
    Dash(string)
    Gap
}

enum Marks {
    M(Mark?)
}

enum T {
    End
    Next(T?, string)
}

fn int_kind(o: i64?) -> string {
    match o {
        Some(0) => "zero"
        Some(n) => "value {n}"
        None => "none"
    }
}

fn literal(o: i64?) -> i64 {
    match o {
        0 => 1
        None => 2
        _ => 3
    }
}

fn ranges(o: i64?) -> i64 {
    match o {
        0..=9 => 1
        10 | 11 => 2
        Some(_) => 3
        None => 4
    }
}

fn zero_or_none(o: i64?) -> i64 {
    match o {
        Some(0) | None => 1
        _ => 2
    }
}

fn whole(o: i64?) -> i64 {
    match o {
        Some(n) => n
        x => x ?? -1
    }
}

fn wild(o: i64?) -> i64 {
    match o {
        _ => 0
    }
}

fn layers(x: i64??) -> i64 {
    match x {
        Some(Some(n)) => n
        Some(None) => -1
        None => -2
    }
}

fn spelled(o: i64?) -> i64 {
    match o {
        Option.Some(m) => m
        Option.None => 0
    }
}

fn describe_string(s: string?) -> string {
    match s {
        "a" => "the letter a"
        Some(t) => "string {t}"
        None => "no string"
    }
}

fn describe_node(n: Node?) -> i64 {
    match n {
        Some(node) => node.n
        None => -1
    }
}

fn shape(s: Shape?) -> string {
    match s {
        Circle(name) => "circle {name}"
        Square(w) => "square {w}"
        None => "nothing"
    }
}

fn held(h: Holder) -> string {
    match h {
        V(None) => "V(None)"
        V(Circle(r)) => "V(Circle({r}))"
        V(Some(x)) => "V(Some({shape(x)}))"
        W(1..=3 | None) => "W small or none"
        W(z) => "W {z ?? 0}"
    }
}

fn payload(h: Holder) -> string {
    match h {
        V(x) => shape(x)
        W(_) => "W"
    }
}

fn owned_shape(name: string) -> string {
    let s: Shape? = Shape.Circle(name)
    match s {
        Circle(n) => n
        _ => "other"
    }
}

fn owned_string(text: string) -> string {
    let s: string? = text
    match s {
        Some(t) => t
        None => "none"
    }
}

fn owned_holder(name: string) -> string {
    let h = Holder.V(Shape.Circle(name))
    match h {
        V(Circle(r)) => r
        _ => "other"
    }
}

fn if_lets(s: Shape?, o: i64?) {
    if let Circle(r) = s {
        print("if let Circle({r})")
    } else {
        print("not a circle")
    }
    if let Some(n) = o {
        print("if let Some({n})")
    }
    if let y = o {
        print("if let y = {y}")
    }
}

fn make(i: i64) -> E {
    match i {
        0 => E.End
        1 => E.Next(None)
        2 => E.Next(E.End)
        3 => E.Next(E.Next(None))
        _ => E.Next(E.Next(E.End))
    }
}

fn deep(e: E) -> i64 {
    match e {
        Next(Some(Next(_))) => 2
        Next(Some(End)) => 1
        _ => 0
    }
}

fn deep_owned(i: i64) -> i64 {
    let e = make(i)
    match e {
        Next(Some(Next(_))) => 2
        Next(Some(End)) => 1
        _ => 0
    }
}

fn under_box(e: E) -> bool {
    match e {
        Next(Some(Next(x))) => x == E.End
        _ => false
    }
}

fn under_box_owned(i: i64) -> bool {
    let e = make(i)
    match e {
        Next(Some(Next(x))) => x == E.End
        _ => false
    }
}

fn make_d(i: i64) -> D {
    match i {
        0 => D.End
        1 => D.Next(None)
        2 => D.Next(Some(None))
        3 => D.Next(Some(D.End))
        _ => D.Next(Some(D.Next(Some(D.End))))
    }
}

fn d_kind(d: D) -> string {
    match d {
        Next(Some(Some(Next(_)))) => "Next(Next(_))"
        Next(Some(Some(End))) => "Next(End)"
        Next(Some(None)) => "Next(Some(None))"
        Next(None) => "Next(None)"
        End => "End"
    }
}

fn d_kind_owned(i: i64) -> string {
    let d = make_d(i)
    match d {
        Next(Some(Some(Next(_)))) => "Next(Next(_))"
        Next(Some(Some(End))) => "Next(End)"
        Next(Some(None)) => "Next(Some(None))"
        Next(None) => "Next(None)"
        End => "End"
    }
}

fn inner_name(k: K) -> string {
    match k {
        Node(Node(_, Some(t)), _) => t
        _ => "no inner name"
    }
}

fn mark(m: Mark?) -> string {
    let marks = Marks.M(m)
    match marks {
        M(Some(Dot(t) | Dash(t))) => t
        _ => "gap"
    }
}

fn second(i: i64) -> string {
    let t = if i == 0 { T.End } else { T.Next(T.Next(None, "second"), "first") }
    match t {
        Next(Some(Next(_, s)), _) => s
        _ => "no second"
    }
}

fn make_slot(i: i64) -> Slot {
    match i {
        0 => Slot.S(None)
        1 => Slot.S(Chain.Link(1, Chain.Stop))
        _ => Slot.S(Chain.Link(1, Chain.Link(7, Chain.Stop)))
    }
}

// The binding `n` is under a box (the tail of the first link) that is under a `Some`.
fn second_link(i: i64) -> i64 {
    let slot = make_slot(i)
    match slot {
        S(Some(Link(_, Link(n, _)))) => n
        _ => -1
    }
}

fn main() {
    let none: i64? = None
    for o in [Some(0), Some(7), none] {
        print(int_kind(o))               // zero, value 7, none
    }
    for o in [Some(0), none, Some(5)] {
        print(literal(o))                // 1, 2, 3
    }
    for o in [Some(3), Some(11), Some(20), none] {
        print(ranges(o))                 // 1, 2, 3, 4
    }
    for o in [Some(0), none, Some(1)] {
        print(zero_or_none(o))           // 1, 1, 2
    }
    print(whole(Some(4)))                // 4
    print(whole(none))                   // -1
    print(wild(Some(4)))                 // 0
    print(wild(none))                    // 0
    let nn: i64?? = None
    let middle: i64?? = Some(None)
    print(layers(Some(Some(6))))         // 6
    print(layers(middle))                // -1
    print(layers(nn))                    // -2
    print(spelled(Some(8)))              // 8
    print(spelled(none))                 // 0
    let no_string: string? = None
    print(describe_string("a"))          // the letter a
    print(describe_string("b"))          // string b
    print(describe_string(no_string))    // no string
    let no_node: Node? = None
    print(describe_node(Node(n: 9)))     // 9
    print(describe_node(no_node))        // -1
    let no_shape: Shape? = None
    print(shape(Shape.Circle("red")))    // circle red
    print(shape(Shape.Square(2)))        // square 2
    print(shape(no_shape))               // nothing
    print(held(Holder.V(None)))          // V(None)
    print(held(Holder.V(Shape.Circle("blue"))))   // V(Circle(blue))
    print(held(Holder.V(Shape.Square(3))))        // V(Some(square 3))
    print(held(Holder.W(2)))             // W small or none
    print(held(Holder.W(None)))          // W small or none
    print(held(Holder.W(10)))            // W 10
    print(payload(Holder.V(Shape.Circle("green"))))   // circle green
    print(payload(Holder.V(None)))       // nothing
    print(payload(Holder.W(1)))          // W
    print(owned_shape("owned"))          // owned
    print(owned_string("owned string"))  // owned string
    print(owned_holder("owned holder"))  // owned holder
    if_lets(Shape.Circle("pink"), Some(1))   // if let Circle(pink), if let Some(1), if let y = 1
    if_lets(Shape.Square(1), none)           // not a circle
    let pile = Pile(n: 3)
    while let Some(item) = pile.pop() {
        print(item)                      // item 2, item 1, item 0
    }
    for i in 0..5 {
        print("{deep(make(i))} {deep_owned(i)} {under_box(make(i))} {under_box_owned(i)}")
        // 0 0 false false, 0 0 false false, 1 1 false false, 2 2 false false, 2 2 true true
    }
    for i in 0..5 {
        print("{d_kind(make_d(i))} {d_kind_owned(i)}")
        // End End, Next(None) Next(None), Next(Some(None)) Next(Some(None)), Next(End) Next(End),
        // Next(Next(_)) Next(Next(_))
    }
    print(inner_name(K.Node(K.Node(K.Leaf, "inner"), None)))   // inner
    print(inner_name(K.Node(K.Node(K.Leaf, None), "outer")))   // no inner name
    print(mark(Mark.Dot("dot")))         // dot
    print(mark(Mark.Dash("dash")))       // dash
    print(mark(Mark.Gap))                // gap
    print(second(0))                     // no second
    print(second(1))                     // second
    for i in 0..3 {
        print(second_link(i))            // -1, -1, 7
    }
}
// `Option`-shaped enums: two variants, one with no payload and one with one field whose storage
// has a spare value. Such an enum is its field's storage, with the payload-free variant in the
// spare value: a `Maybe` is an `i32` with `Nothing` as 0x110000, a `Flag` is a byte with `Unset`
// as 2, a `Named` is a pointer with `Anon` as `null`, and a `Chain`, whose field is a box, is the
// box pointer with `End` as `null`. The order of the variants does not change it (`Rev`). Each
// value is built, matched, compared with `==`, kept in arrays and fields, and released. A `Chain`
// rewrite builds each new `Next` into the box that `match` took apart.
enum Maybe {
    Nothing
    Just(char)
}

enum Rev {
    Just(char)
    Nothing
}

enum Flag {
    Unset
    Set(bool)
}

enum Named {
    Anon
    Name(string)
}

enum Chain {
    End
    Next(Chain)
}

enum Color {
    Red
    Green
    Blue
}

// The niche of a `Color` is its tag, so `Nope` is the tag after `Blue`.
enum Pick {
    Nope
    One(Color)
}

// The niche of a `Maybe` is a `char`'s, so `Empty` is the next spare value, 0x110001.
enum Deep {
    Empty
    Full(Maybe)
}

// A generic enum takes the layout of each instance: `Opt<string>` has a niche, `Opt<i64>` not.
enum Opt<T> {
    No
    Yes(T)
}

// A `Step` holds a `Hop` and a `Hop` holds a `Step`, so the field of `Go` is a box. A `Hop` is
// that box's pointer with `Stop` as `null`, and its `Step` is the value in the box.
enum Step {
    Again(Hop)
    Land(i64)
}

enum Hop {
    Stop
    Go(Step)
}

class Holder: Eq {
    m: Maybe
    f: Flag
    n: Named
    c: Chain

    fn eq(self, other: Self) -> bool {
        self.m == other.m && self.f == other.f && self.n == other.n && self.c == other.c
    }
}

// A string in a new block on each call.
fn text(n: i64) -> string {
    "s{n}"
}

fn show_maybe(m: Maybe) -> string {
    match m {
        Nothing => "Nothing"
        Just(c) => "Just({i64(c)})"
    }
}

fn show_rev(r: Rev) -> string {
    match r {
        Nothing => "Nothing"
        Just(c) => "Just({i64(c)})"
    }
}

fn show_flag(f: Flag) -> string {
    match f {
        Unset => "Unset"
        Set(b) => "Set({b})"
    }
}

fn show_named(n: Named) -> string {
    match n {
        Anon => "Anon"
        Name(s) => "Name({s})"
    }
}

fn show_pick(p: Pick) -> string {
    match p {
        Nope => "Nope"
        One(Red) => "One(Red)"
        One(Green) => "One(Green)"
        One(Blue) => "One(Blue)"
    }
}

fn show_deep(d: Deep) -> string {
    match d {
        Empty => "Empty"
        Full(m) => "Full({show_maybe(m)})"
    }
}

fn show_opt(o: Maybe?) -> string {
    match o {
        None => "None"
        Some(m) => "Some({show_maybe(m)})"
    }
}

fn depth(c: Chain) -> i64 {
    match c {
        End => 0
        Next(rest) => 1 + depth(rest)
    }
}

fn chain(n: i64) -> Chain {
    let mut c = Chain.End
    for _ in 0..n {
        c = Chain.Next(c)
    }
    c
}

fn hops(h: Hop) -> i64 {
    match h {
        Stop => 0
        Go(s) => match s {
            Again(inner) => 1 + hops(inner)
            Land(n) => n
        }
    }
}

// Takes an owned `c` apart and builds each `Next` again, in the box it took apart.
fn rebuild(c: Chain) -> Chain {
    match c {
        Next(rest) => Chain.Next(rebuild(rest))
        End => Chain.End
    }
}

// The same rewrite, with one more `Next` at the end.
fn grow(c: Chain) -> Chain {
    match c {
        Next(rest) => Chain.Next(grow(rest))
        End => Chain.Next(Chain.End)
    }
}

// A `Named` that one branch moves out of `n`. On the other path the end of the scope releases
// `n`; on this one, `n`'s slot holds its zero value, `null`, which is `Anon`.
fn keep_if(keep: bool) -> Named {
    let n = Named.Name(text(7))
    let mut out = Named.Anon
    if keep {
        out = n
    }
    out
}

fn main() {
    let maybes = [Maybe.Nothing, Maybe.Just('\0'), Maybe.Just('a'), Maybe.Just('\u{10FFFF}')]
    for m in maybes {
        print(show_maybe(m))
    }
    // Nothing
    // Just(0)
    // Just(97)
    // Just(1114111)
    print(maybes[0] == Maybe.Nothing)              // true
    print(maybes[1] == Maybe.Nothing)              // false
    print(maybes[1] == Maybe.Just('\0'))           // true
    print(maybes[3] == Maybe.Just('\u{10FFFF}'))   // true
    print(maybes[2] == maybes[3])                  // false

    let revs = [Rev.Nothing, Rev.Just('\0'), Rev.Just('\u{10FFFF}')]
    for r in revs {
        print(show_rev(r))
    }
    // Nothing
    // Just(0)
    // Just(1114111)
    print(revs[0] == Rev.Nothing)                  // true
    print(revs[1] == Rev.Nothing)                  // false
    print(Rev.Nothing == revs[1])                  // false
    print(revs[2] == Rev.Just('\u{10FFFF}'))       // true

    let flags = [Flag.Unset, Flag.Set(false), Flag.Set(true)]
    for f in flags {
        print(show_flag(f))
    }
    // Unset
    // Set(false)
    // Set(true)
    print(Flag.Unset == Flag.Set(false))           // false
    print(Flag.Set(false) == Flag.Unset)           // false
    print(Flag.Unset == flags[0])                  // true
    print(flags[1] == Flag.Set(false))             // true
    print(flags[1] == flags[2])                    // false

    let names = [Named.Anon, Named.Name(text(1)), Named.Name("")]
    for n in names {
        print(show_named(n))
    }
    // Anon
    // Name(s1)
    // Name()
    print(names[0] == Named.Anon)                  // true
    print(names[1] == Named.Name(text(1)))         // true: the same text in another block
    print(names[2] == Named.Anon)                  // false
    print(show_named(keep_if(true)))               // Name(s7)
    print(show_named(keep_if(false)))              // Anon

    let chains = [Chain.End, chain(1), chain(3)]
    for c in chains {
        print(depth(c))
    }
    // 0
    // 1
    // 3
    print(chains[0] == Chain.End)                  // true
    print(chains[2] == chain(3))                   // true
    print(chains[2] == chain(2))                   // false
    print(chain(2) == chains[2])                   // false
    let mut c = chain(3)
    c = rebuild(c)
    print(depth(c))                                // 3
    c = grow(c)
    print(depth(c))                                // 4
    print(c == chain(4))                           // true

    let picks = [Pick.Nope, Pick.One(Color.Red), Pick.One(Color.Green), Pick.One(Color.Blue)]
    for p in picks {
        print(show_pick(p))
    }
    // Nope
    // One(Red)
    // One(Green)
    // One(Blue)
    print(picks[0] == Pick.One(Color.Red))         // false
    print(picks[3] == Pick.One(Color.Blue))        // true

    let deeps = [Deep.Empty, Deep.Full(Maybe.Nothing), Deep.Full(Maybe.Just('z'))]
    for d in deeps {
        print(show_deep(d))
    }
    // Empty
    // Full(Nothing)
    // Full(Just(122))
    print(deeps[0] == Deep.Full(Maybe.Nothing))    // false
    print(deeps[1] == Deep.Full(Maybe.Nothing))    // true

    let opts: [Maybe?] = [None, Maybe.Nothing, Maybe.Just('b')]
    for o in opts {
        print(show_opt(o))
    }
    // None
    // Some(Nothing)
    // Some(Just(98))
    print(opts[0] == None)                         // true
    print(opts[1] == None)                         // false
    print(opts[1] == Some(Maybe.Nothing))          // true
    print(opts[0] == Some(Maybe.Nothing))          // false
    print(show_maybe(opts[0] ?? Maybe.Just('c')))  // Just(99)

    let words: [Opt<string>] = [Opt.No, Opt.Yes(text(2))]
    let numbers: [Opt<i64>] = [Opt.No, Opt.Yes(0)]
    print(words[0] == Opt.No)                      // true
    print(words[1] == Opt.Yes(text(2)))            // true
    print(numbers[0] == Opt.Yes(0))                // false
    print(numbers[1] == Opt.Yes(0))                // true

    let trips = [Hop.Stop, Hop.Go(Step.Land(5)), Hop.Go(Step.Again(Hop.Go(Step.Land(5))))]
    for t in trips {
        print(hops(t))
    }
    // 0
    // 5
    // 6
    print(trips[0] == Hop.Stop)                    // true
    print(trips[0] == Hop.Go(Step.Land(0)))        // false
    print(trips[1] == Hop.Go(Step.Land(5)))        // true
    print(trips[1] == Hop.Go(Step.Land(6)))        // false
    print(trips[2] == Hop.Go(Step.Again(Hop.Go(Step.Land(5)))))  // true
    print(trips[2] == Hop.Go(Step.Again(Hop.Stop)))              // false

    let h = Holder(m: Maybe.Just('h'), f: Flag.Set(true), n: Named.Name(text(3)), c: chain(2))
    print(show_maybe(h.m))                         // Just(104)
    print(show_flag(h.f))                          // Set(true)
    print(show_named(h.n))                         // Name(s3)
    print(depth(h.c))                              // 2
    print(h == Holder(m: Maybe.Just('h'), f: Flag.Set(true), n: Named.Name(text(3)), c: chain(2))) // true
}
// The methods on `f64` and `i64`, each run twice: on literals, which `-O2` folds, and on values
// that come back from `same` or `same_int` at a depth that `-O2` does not know, which it cannot
// fold. The exact methods print in full; the transcendental ones print through `micro`, as the
// nearest millionth, since libm may differ in the last bits.
// args: a
// o2-calls: main same 13
// o2-calls: main same_int 4
fn same(x: f64, depth: i64) -> f64 {
    if depth == 0 { x } else { -same(-x, depth - 1) }
}

fn same_int(n: i64, depth: i64) -> i64 {
    if depth == 0 { n } else { -same_int(-n, depth - 1) }
}

fn micro(x: f64) {
    if let n = i64((x * 1e6).round()) {
        print(n)
    } else {
        print("none")
    }
}

fn show(x: f64?) {
    if let v = x {
        print(v)
    } else {
        print("none")
    }
}

// Each of these prints its name, so the order of the operands of `clamp` shows.
fn f(n: i64) -> i64 {
    print("f")
    n
}

fn g(n: i64) -> i64 {
    print("g")
    n
}

fn h(n: i64) -> i64 {
    print("h")
    n
}

fn main(args: [string]) {
    let d = args.len()

    // On literals.
    print(2.5.round())                  // 3.0: halves round away from zero
    print((-2.5).round())               // -3.0
    print(2.5.floor())                  // 2.0
    print((-2.5).floor())               // -3.0
    print(2.5.ceil())                   // 3.0
    print((-2.5).ceil())                // -2.0
    print(2.5.trunc())                  // 2.0
    print((-2.5).trunc())               // -2.0
    print((-2.5).abs())                 // 2.5
    print(4.0.sqrt())                   // 2.0
    print((-1.0).sqrt().is_nan())       // true
    print(-1.0.sqrt())                  // -1.0: the minus binds looser than the call
    print((0.0 / 0.0).is_nan())         // true
    print(2.5.is_nan())                 // false
    print(2.5.is_finite())              // true
    print((1.0 / 0.0).is_finite())      // false
    print((0.0 / 0.0).is_finite())      // false
    print((1.0 / 0.0).is_infinite())    // true
    print((-1.0 / 0.0).is_infinite())   // true
    print(2.5.is_infinite())            // false
    print((0.0 / 0.0).is_infinite())    // false
    print(2.5.min(-2.5))                // -2.5
    print(2.5.max(-2.5))                // 2.5
    print((0.0 / 0.0).min(2.5))         // 2.5: a `nan` operand gives the other one
    print(2.5.min(0.0 / 0.0))           // 2.5
    print((0.0 / 0.0).max(2.5))         // 2.5
    print(2.5.max(0.0 / 0.0))           // 2.5
    print((-0.0).min(0.0))              // -0.0: `min` orders -0.0 below 0.0
    print(0.0.min(-0.0))                // -0.0
    print((-0.0).max(0.0))              // 0.0
    print(0.0.max(-0.0))                // 0.0
    print((-0.0).clamp(0.0, 1.0))       // 0.0
    print(2.5.clamp(0.0, 1.0))          // 1.0
    print((-2.5).clamp(0.0, 1.0))       // 0.0
    print(0.5.clamp(0.0, 1.0))          // 0.5
    print((0.0 / 0.0).clamp(0.0, 1.0))  // 0.0
    print(2.5.clamp(1.0, 0.0))          // 0.0: with lo above hi, the result is hi
    micro(1.0.sin())                    // 841471
    micro(1.0.cos())                    // 540302
    micro(1.0.tan())                    // 1557408
    micro(0.5.asin())                   // 523599
    micro(0.5.acos())                   // 1047198
    micro(1.0.atan())                   // 785398
    micro(1.0.atan2(2.0))               // 463648
    micro(1.0.exp())                    // 2718282
    micro(10.0.ln())                    // 2302585
    micro(1000.0.log10())               // 3000000
    micro(8.0.log2())                   // 3000000
    micro(2.0.pow(0.5))                 // 1414214
    micro(3.0.hypot(4.0))               // 5000000
    micro((-1.0).sqrt())                // none: `nan` is not a whole number
    micro(0.0.ln())                     // none: -inf is out of range
    print(7.min(-3))                    // -3
    print(7.max(-3))                    // 7
    print(7.clamp(2, 5))                // 5
    print((-3).clamp(2, 5))             // 2
    print(3.clamp(2, 5))                // 3
    print(7.clamp(5, 2))                // 2: with lo above hi, the result is hi, and nothing panics
    let has: f64? = 2.25
    show(has?.sqrt())                   // 1.5
    let nothing: f64? = None
    show(nothing?.sqrt())               // none

    // The same on values that `-O2` cannot fold.
    let a = same(2.5, d)
    let b = same(-2.5, d)
    let z = same(0.0, d)
    let nz = same(-0.0, d)
    let one = same(1.0, d)
    let four = same(4.0, d)
    let nan = z / z
    let inf = 1.0 / z
    print(a.round())                    // 3.0
    print(b.round())                    // -3.0
    print(a.floor())                    // 2.0
    print(b.floor())                    // -3.0
    print(a.ceil())                     // 3.0
    print(b.ceil())                     // -2.0
    print(a.trunc())                    // 2.0
    print(b.trunc())                    // -2.0
    print(b.abs())                      // 2.5
    print(four.sqrt())                  // 2.0
    print((-one).sqrt().is_nan())       // true
    print(-one.sqrt())                  // -1.0
    print(nan.is_nan())                 // true
    print(a.is_nan())                   // false
    print(a.is_finite())                // true
    print(inf.is_finite())              // false
    print(nan.is_finite())              // false
    print(inf.is_infinite())            // true
    print((-inf).is_infinite())         // true
    print(a.is_infinite())              // false
    print(nan.is_infinite())            // false
    print(a.min(b))                     // -2.5
    print(a.max(b))                     // 2.5
    print(nan.min(a))                   // 2.5
    print(a.min(nan))                   // 2.5
    print(nan.max(a))                   // 2.5
    print(a.max(nan))                   // 2.5
    print(nz.min(z))                    // -0.0
    print(z.min(nz))                    // -0.0
    print(nz.max(z))                    // 0.0
    print(z.max(nz))                    // 0.0
    print(nz.clamp(z, one))             // 0.0
    print(a.clamp(z, one))              // 1.0
    print(b.clamp(z, one))              // 0.0
    print(nan.clamp(z, one))            // 0.0
    print(a.clamp(one, z))              // 0.0
    let half = same(0.5, d)
    let two = same(2.0, d)
    let ten = same(10.0, d)
    let thousand = same(1000.0, d)
    let eight = same(8.0, d)
    let three = same(3.0, d)
    micro(one.sin())                    // 841471
    micro(one.cos())                    // 540302
    micro(one.tan())                    // 1557408
    micro(half.asin())                  // 523599
    micro(half.acos())                  // 1047198
    micro(one.atan())                   // 785398
    micro(one.atan2(two))               // 463648
    micro(one.exp())                    // 2718282
    micro(ten.ln())                     // 2302585
    micro(thousand.log10())             // 3000000
    micro(eight.log2())                 // 3000000
    micro(two.pow(half))                // 1414214
    micro(three.hypot(four))            // 5000000
    micro((-one).sqrt())                // none
    micro(z.ln())                       // none
    let p = same_int(7, d)
    let q = same_int(-3, d)
    let r = same_int(5, d)
    let s = same_int(2, d)
    print(p.min(q))                     // -3
    print(p.max(q))                     // 7
    print(p.clamp(s, r))                // 5
    print(q.clamp(s, r))                // 2
    print(r.clamp(q, p))                // 5
    print(p.clamp(r, s))                // 2
    let has_run: f64? = same(2.25, d)
    show(has_run?.sqrt())               // 1.5
    let nothing_run: f64? = None
    show(nothing_run?.sqrt())           // none

    // The operands of `clamp` run left to right.
    print(f(1).clamp(g(2), h(3)))       // f, g, h, then 2
}
// A small interpreter. It scans a program text into a boxed tree with a
// cursor over `bytes()`, simplifies the tree, runs it and counts its nodes.
// Each round parses the text again, so each round frees one tree and builds
// the boxes of the next. `simplify` and `simplify_stmt` take an owned tree
// apart in a `match` and rebuild the nodes that do not fold, so their arms
// reuse the boxes they take apart. `eval`, `run` and `count` only read the tree.
const ROUNDS = 1000
const SPACE: u8 = 32
const OPEN_PAREN: u8 = 40
const STAR: u8 = 42
const PLUS: u8 = 43
const MINUS: u8 = 45
const ZERO: u8 = 48
const NINE: u8 = 57
const LESS: u8 = 60
const EQUAL: u8 = 61
const LOWER_A: u8 = 97
const LOWER_W: u8 = 119
const LOWER_Z: u8 = 122
const CLOSE_BRACE: u8 = 125

enum Expr {
    Num(i64)
    Var(i64)
    Add(Expr, Expr)
    Sub(Expr, Expr)
    Mul(Expr, Expr)
    Less(Expr, Expr)
    Equal(Expr, Expr)
}

enum Stmt {
    Nop
    Set(i64, Expr)
    While(Expr, Stmt)
    If(Expr, Stmt, Stmt)
    Seq(Stmt, Stmt)
}

class Parser {
    src: [u8]
    mut pos: i64

    // The byte at `i`, or 0 past the end.
    fn at(self, i: i64) -> u8 {
        if i < self.src.len() { self.src[i] } else { 0 }
    }

    fn skip(self) {
        while self.at(self.pos) == SPACE {
            self.pos += 1
        }
    }

    fn peek(self) -> u8 {
        self.skip()
        self.at(self.pos)
    }

    fn program(self) -> Stmt {
        let mut s = Stmt.Nop
        while self.peek() != 0 {
            s = Stmt.Seq(s, self.stmt())
        }
        s
    }

    fn block(self) -> Stmt {
        self.skip()
        self.pos += 1
        let mut s = Stmt.Nop
        while self.peek() != CLOSE_BRACE {
            s = Stmt.Seq(s, self.stmt())
        }
        self.pos += 1
        s
    }

    // `x = expr`, `while expr block` or `if expr block else block`. `w` starts
    // a `while`, so no variable is `w`. Another letter that no `=` follows
    // starts an `if`.
    fn stmt(self) -> Stmt {
        let c = self.peek()
        if c == LOWER_W {
            self.pos += 5
            let cond = self.expr()
            Stmt.While(cond, self.block())
        } else {
            self.pos += 1
            if self.peek() == EQUAL {
                self.pos += 1
                Stmt.Set(i64(c) - i64(LOWER_A), self.expr())
            } else {
                self.pos += 1
                let cond = self.expr()
                let yes = self.block()
                self.skip()
                self.pos += 4
                Stmt.If(cond, yes, self.block())
            }
        }
    }

    fn expr(self) -> Expr {
        let l = self.sum()
        let c = self.peek()
        if c == LESS {
            self.pos += 1
            Expr.Less(l, self.sum())
        } else if c == EQUAL {
            self.pos += 2
            Expr.Equal(l, self.sum())
        } else {
            l
        }
    }

    fn sum(self) -> Expr {
        let mut l = self.term()
        let mut c = self.peek()
        while c == PLUS || c == MINUS {
            self.pos += 1
            let r = self.term()
            l = if c == PLUS { Expr.Add(l, r) } else { Expr.Sub(l, r) }
            c = self.peek()
        }
        l
    }

    fn term(self) -> Expr {
        let mut l = self.atom()
        while self.peek() == STAR {
            self.pos += 1
            l = Expr.Mul(l, self.atom())
        }
        l
    }

    fn atom(self) -> Expr {
        let c = self.peek()
        if ZERO <= c <= NINE {
            let mut n = 0
            while ZERO <= self.at(self.pos) <= NINE {
                n = n * 10 + i64(self.at(self.pos)) - i64(ZERO)
                self.pos += 1
            }
            Expr.Num(n)
        } else if c == OPEN_PAREN {
            self.pos += 1
            let e = self.expr()
            self.pos += 1
            e
        } else if LOWER_A <= c <= LOWER_Z {
            self.pos += 1
            Expr.Var(i64(c) - i64(LOWER_A))
        } else {
            Expr.Num(0)
        }
    }
}

fn simplify(e: Expr) -> Expr {
    match e {
        Add(l, Num(0)) => simplify(l)
        Add(Num(0), r) => simplify(r)
        Mul(l, Num(1)) => simplify(l)
        Mul(Num(1), r) => simplify(r)
        Add(Num(a), Num(b)) => Expr.Num(a + b)
        Sub(Num(a), Num(b)) => Expr.Num(a - b)
        Mul(Num(a), Num(b)) => Expr.Num(a * b)
        Add(l, r) => Expr.Add(simplify(l), simplify(r))
        Sub(l, r) => Expr.Sub(simplify(l), simplify(r))
        Mul(l, r) => Expr.Mul(simplify(l), simplify(r))
        Less(l, r) => Expr.Less(simplify(l), simplify(r))
        Equal(l, r) => Expr.Equal(simplify(l), simplify(r))
        Num(n) => Expr.Num(n)
        Var(v) => Expr.Var(v)
    }
}

fn simplify_stmt(s: Stmt) -> Stmt {
    match s {
        Nop => Stmt.Nop
        Set(x, e) => Stmt.Set(x, simplify(e))
        While(c, b) => Stmt.While(simplify(c), simplify_stmt(b))
        If(c, a, b) => Stmt.If(simplify(c), simplify_stmt(a), simplify_stmt(b))
        Seq(a, b) => Stmt.Seq(simplify_stmt(a), simplify_stmt(b))
    }
}

fn eval(e: Expr, vars: [i64]) -> i64 {
    match e {
        Num(n) => n
        Var(v) => vars[v]
        Add(a, b) => eval(a, vars) + eval(b, vars)
        Sub(a, b) => eval(a, vars) - eval(b, vars)
        Mul(a, b) => eval(a, vars) * eval(b, vars)
        Less(a, b) => if eval(a, vars) < eval(b, vars) { 1 } else { 0 }
        Equal(a, b) => if eval(a, vars) == eval(b, vars) { 1 } else { 0 }
    }
}

fn run(s: Stmt, vars: [i64]) -> [i64] {
    let mut vs = vars
    match s {
        Nop => {}
        Set(x, e) => vs[x] = eval(e, vs)
        While(c, b) => {
            while eval(c, vs) != 0 {
                vs = run(b, vs)
            }
        }
        If(c, a, b) => {
            if eval(c, vs) != 0 {
                vs = run(a, vs)
            } else {
                vs = run(b, vs)
            }
        }
        Seq(a, b) => {
            vs = run(a, vs)
            vs = run(b, vs)
        }
    }
    vs
}

fn size(e: Expr) -> i64 {
    match e {
        Num(_) => 1
        Var(_) => 1
        Add(a, b) => 1 + size(a) + size(b)
        Sub(a, b) => 1 + size(a) + size(b)
        Mul(a, b) => 1 + size(a) + size(b)
        Less(a, b) => 1 + size(a) + size(b)
        Equal(a, b) => 1 + size(a) + size(b)
    }
}

fn count(s: Stmt) -> i64 {
    match s {
        Nop => 1
        Set(_, e) => 1 + size(e)
        While(c, b) => 1 + size(c) + count(b)
        If(c, a, b) => 1 + size(c) + count(a) + count(b)
        Seq(a, b) => 1 + count(a) + count(b)
    }
}

fn main() {
    let mut text = "a = 0 b = z + 0 while a < 4 \{ b = b * 3 + a a = a + 1 \} "
    text += "c = 1 * (2 + 3) d = 0 if c == 5 \{ d = c * 1 + 0 * 7 \} else \{ d = 99 \} "
    text += "e = 10 f = 0 g = 0 while 0 < e \{ f = f + e - 2 * 3 g = g + (e == 4) e = e - 3 \} "
    text += "h = 1 i = 0 while i < 5 \{ if i == 2 \{ h = h * 10 \} else \{ h = h + i \} i = i + 1 \} "
    text += "j = (h + 0) * (1 * z) - h k = 0 + (4 * 5) + z"
    let mut sum = 0
    let mut nodes = 0
    for r in 0..ROUNDS {
        let s = simplify_stmt(Parser(src: text.bytes(), pos: 0).program())
        let mut vars = [0; 26]
        vars[25] = r % 10
        let out = run(s, vars)
        for v in out {
            sum += v
        }
        if r == ROUNDS - 1 {
            nodes = count(s)
        }
    }
    print(sum)
    print(nodes)
}
// Class layout: codegen sorts a class's fields by alignment, largest first, so a field's place in
// memory is not its place in the source. Each function proves one property of that layout through
// what the program prints; `eval_order.sisu`'s `Moved` covers constructor evaluation order.
class Box: Eq {
    v: i64
    fn eq(self, other: Self) -> bool { self.v == other.v }
}

// Property 1, a tight sorted layout: sorting moves these fields, so a field stored through the
// wrong element overlaps a neighbour. In memory they sit as `n`, `s`, `on`, `xs`, `oxs`, `obj`
// (align 8), `c`, `oc` (align 4), then `a`, `u`, `ou` (align 1).
class M: Eq {
    mut a: bool
    mut u: u8
    mut c: char
    mut n: i64
    mut s: string
    mut on: i64?
    mut oc: char?
    mut ou: u8?
    mut xs: [i64]
    mut oxs: [i64]?
    mut obj: Box?

    fn eq(self, other: Self) -> bool {
        self.a == other.a && self.u == other.u && self.c == other.c && self.n == other.n &&
            self.s == other.s && self.on == other.on && self.oc == other.oc &&
            self.ou == other.ou && self.xs == other.xs && self.oxs == other.oxs &&
            self.obj == other.obj
    }
}

// Property 5, a chain field among mixed alignments: in memory `next` comes first and `flag` last.
class L: Eq {
    flag: bool
    next: L?
    n: i64

    fn eq(self, other: Self) -> bool {
        self.flag == other.flag && self.next == other.next && self.n == other.n
    }
}

fn base() -> M {
    M(a: true, u: 7, c: 'x', n: 100, s: "str", on: 200, oc: 'y', ou: 9, xs: [1, 2, 3], oxs: [4, 5], obj: Box(v: 300))
}

// The counted optionals: `oxs`'s length and first element, or `none`, then `obj?.v ?? -1`.
fn show_counted(m: M) {
    if let o = m.oxs {
        print(o.len())                // length of oxs
        print(o[0])                   // first element of oxs
    } else {
        print("none")                 // oxs is None
    }
    print(m.obj?.v ?? -1)             // obj
}

// Every field, in declared order; an optional scalar shows `?? sentinel` and `== None`.
fn show(m: M) {
    print(m.a)                        // a
    print(m.u)                        // u
    print(m.c)                        // c
    print(m.n)                        // n
    print(m.s)                        // s
    print(m.on ?? -1)                 // on
    print(m.on == None)               // on is None
    print(m.oc ?? '-')                // oc
    print(m.oc == None)               // oc is None
    print(m.ou ?? 0)                  // ou
    print(m.ou == None)               // ou is None
    print(m.xs.len())                 // length of xs
    for x in m.xs {
        print(x)                      // each element of xs
    }
    show_counted(m)
}

// Property 2, distinct values in every field, after construction and after assigning each.
fn construct_and_assign() {
    let m = base()
    show(m) // true, 7, x, 100, str, 200, false, y, false, 9, false, 3, 1, 2, 3, 2, 4, 300
    m.a = false
    m.u = 70
    m.c = 'z'
    m.n = 1000
    m.s = "new"
    m.on = 2000
    m.oc = 'w'
    m.ou = 90
    m.xs = [10, 20]
    m.oxs = [40, 50, 60]
    m.obj = Box(v: 3000)
    show(m) // false, 70, z, 1000, new, 2000, false, w, false, 90, false, 2, 10, 20, 3, 40, 3000
}

// Property 2, through an array: objects are shared, so a field write through `ms[0]` shows
// through `copy`; an array field is copied on write, so `saved` keeps its old element.
fn through_an_array() {
    let ms = [base(), base()]
    let copy = ms
    ms[0].a = false
    print(copy[0].a)                  // false
    ms[0].u = 71
    print(copy[0].u)                  // 71
    ms[0].c = 'q'
    print(copy[0].c)                  // q
    ms[0].oc = 'r'
    print(copy[0].oc ?? '-')          // r
    ms[0].ou = 91
    print(copy[0].ou ?? 0)            // 91
    ms[0].n = 1001
    print(copy[0].n)                  // 1001
    let saved = ms[0].xs
    ms[0].xs[1] = 99
    print(saved[1])                   // 2
    print(ms[0].xs[1])                // 99
    print(copy[0].xs[1])              // 99
    // The neighbours of each written field are intact, and `ms[1]` is untouched.
    show(ms[0]) // false, 71, q, 1001, str, 200, false, r, false, 91, false, 3, 1, 99, 3, 2, 4, 300
    show(ms[1]) // true, 7, x, 100, str, 200, false, y, false, 9, false, 3, 1, 2, 3, 2, 4, 300
}

// Property 3, each counted optional goes value, then `None`, then a new value.
fn counted_optionals() {
    let m = base()
    show_counted(m)                   // 2, 4, 300
    m.oxs = None
    show_counted(m)                   // none, 300
    m.obj = None
    show_counted(m)                   // none, -1
    m.oxs = [6, 7, 8]
    show_counted(m)                   // 3, 6, -1
    m.obj = Box(v: 301)
    show_counted(m)                   // 3, 6, 301
}

// Property 3, the optional scalars go to `None`: `?? sentinel` gives the sentinel, `== None` is
// true, and the fields around them are intact.
fn none_scalars() {
    let m = base()
    m.on = None
    m.oc = None
    m.ou = None
    show(m) // true, 7, x, 100, str, -1, true, -, true, 0, true, 3, 1, 2, 3, 2, 4, 300
}

// Property 4, two objects built separately that differ only in one field are unequal, and an
// identical pair is equal.
fn equality() {
    print(base() == base())           // true
    let d = base()
    d.a = false
    print(d == base())                // false: a
    let d = base()
    d.u = 8
    print(d == base())                // false: u
    let d = base()
    d.c = 'w'
    print(d == base())                // false: c
    let d = base()
    d.n = 101
    print(d == base())                // false: n
    let d = base()
    d.s = "stR"
    print(d == base())                // false: s
    let d = base()
    d.on = 201
    print(d == base())                // false: on
    let d = base()
    d.oc = 'z'
    print(d == base())                // false: oc
    let d = base()
    d.ou = 10
    print(d == base())                // false: ou
    let d = base()
    d.xs = [1, 2, 4]
    print(d == base())                // false: xs
    let d = base()
    d.oxs = [4, 6]
    print(d == base())                // false: oxs
    let d = base()
    d.obj = Box(v: 302)
    print(d == base())                // false: obj
}

// The sum of `n` along a chain.
fn sum(l: L?) -> i64 {
    if let x = l { x.n + sum(x.next) } else { 0 }
}

// Three nodes deep; `last` is the `n` of the deepest.
fn chain(last: i64) -> L {
    L(flag: true, next: L(flag: false, next: L(flag: true, next: None, n: last), n: 20), n: 100)
}

// Property 5: the drop loop walks the chain through its moved field, and the written `eq` reads
// it. Both chains are dropped when the function returns.
fn chains() {
    let a = chain(3)
    let b = chain(3)
    print(sum(a))                     // 123
    print(a == b)                     // true
    print(a == chain(4))              // false: the deepest `n` differs
}

fn main() {
    construct_and_assign()
    through_an_array()
    counted_optionals()
    none_scalars()
    equality()
    chains()
}
