// Each round writes into a copy of an array whose original stays live, so
// every first write must copy; both arrays are read afterwards. Then an array
// grows from `[]` by pushes, and each round pushes onto an array whose original
// stays live, so every push copies.
fn bump(xs: [i64], i: i64) -> [i64] {
    let mut ys = xs
    ys[i % ys.len()] += 1
    ys
}

fn main() {
    let mut base = [0; 1_000]
    for i in 0..1_000 { base[i] = i }
    let mut total = 0
    for r in 0..20_000 {
        let saved = base
        base = bump(base, r)
        total += base[r % 1_000] - saved[r % 1_000]
    }
    print(total)
    print(base.sum())

    let mut grown: [i64] = []
    for i in 0..20_000 { grown.push(i) }
    print(grown.sum())
    let mut longer = base
    let mut before = longer
    for r in 0..5_000 {
        before = longer
        longer.push(r)
    }
    print(longer.len())
    print(before.len())
}
