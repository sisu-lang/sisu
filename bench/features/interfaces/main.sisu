// Calls through a bound: `total` is generic over `T: Shape` and runs for two classes, `Square`,
// which lists `Shape`, and `Rect`, which conforms in an `extend` block. Each instantiation is a
// copy written by hand for its class, so every `area` and `grow` is a direct call. `last` reads
// the items of a `Source` through its associated type `Item`, which is an `i64`.
interface Shape {
    fn area(self) -> i64
    fn grow(self, by: i64) -> Self
}

class Square: Shape {
    side: i64

    fn area(self) -> i64 {
        self.side * self.side
    }

    fn grow(self, by: i64) -> Square {
        Square(side: self.side + by)
    }
}

class Rect {
    w: i64
    h: i64
}

extend Rect: Shape {
    fn area(self) -> i64 {
        self.w * self.h
    }

    fn grow(self, by: i64) -> Rect {
        Rect(w: self.w + by, h: self.h + 1)
    }
}

interface Source {
    type Item
    fn next(self) -> Item?
}

class Counter: Source {
    type Item = i64
    mut n: i64
    limit: i64

    fn next(self) -> Item? {
        if self.n == self.limit {
            return None
        }
        self.n += 1
        self.n
    }
}

fn total<T: Shape>(shapes: [T], rounds: i64) -> i64 {
    let mut acc = 0
    for r in 0..rounds {
        for s in shapes {
            acc = (acc + s.grow(r % 5).area()) % 1_000_003
        }
    }
    acc
}

fn last<S: Source>(s: S) -> S.Item? {
    let mut found = s.next()
    while let x = s.next() {
        found = x
    }
    found
}

fn main() {
    let squares = [Square(side: 1), Square(side: 2), Square(side: 3), Square(side: 4)]
    let rects = [Rect(w: 1, h: 2), Rect(w: 3, h: 1), Rect(w: 2, h: 2), Rect(w: 5, h: 3)]
    print(total(squares, 50_000))
    print(total(rects, 50_000))
    let mut sum = 0
    for k in 0..20_000 {
        sum += last(Counter(n: 0, limit: k % 100 + 1)) ?? 0
    }
    print(sum)
}
