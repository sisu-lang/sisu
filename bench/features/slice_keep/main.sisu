// Keeps a small slice of each of many large arrays in a class field. A store to a field is a
// trim point, so each slice is copied out and its large array is freed. Without the trim, all
// 2 000 arrays of 10 000 elements would stay alive until the end.
class Holder {
    mut top: [i64]
}

fn make(seed: i64) -> Holder {
    let all = [seed; 10_000]
    let h = Holder(top: [])
    h.top = all[..4]
    h
}

fn main() {
    let mut holders: [Holder] = []
    for i in 0..2_000 { holders.push(make(i)) }
    let mut sum = 0
    for h in holders { sum += h.top[0] + h.top[3] }
    print(sum)
}
