// A stack machine: an array of optional instructions with inline payloads,
// run by a match in a loop from a different start each round, so no tag is
// known at compile time. A `None` is a spare tag of `Instr` and does nothing.
// Both registers fold into the checksum after every instruction. Then a boxed
// expression tree is built and evaluated per round.
enum Instr {
    Push(i64)
    Add
    Mul(i64)
    Dup
    Drop
}

enum Expr {
    Num(i64)
    Add(Expr, Expr)
    Mul(Expr, Expr)
}

fn tree(depth: i64, k: i64) -> Expr {
    if depth == 0 {
        Expr.Num(k % 7 + 1)
    } else if depth % 2 == 0 {
        Expr.Add(tree(depth - 1, k + 1), tree(depth - 1, k + 2))
    } else {
        Expr.Mul(tree(depth - 1, k), Expr.Num(2))
    }
}

fn eval(e: Expr) -> i64 {
    match e {
        Num(n) => n
        Add(a, b) => eval(a) + eval(b)
        Mul(a, b) => (eval(a) * eval(b)) % 1_000_003
    }
}

fn run(code: [Instr?], rounds: i64) -> i64 {
    let mut acc = 0
    for r in 0..rounds {
        let mut top = r
        let mut below = 0
        for j in 0..code.len() {
            match code[(r + j) % code.len()] {
                None => {}
                Push(v) => {
                    below = top
                    top = v
                }
                Add => top = (top + below) % 1_000_003
                Mul(k) => top = top * k % 1_000_003
                Dup => below = top
                Drop => top = below
            }
            acc = (acc * 31 + top + below) % 1_000_003
        }
    }
    acc
}

fn main() {
    let code: [Instr?] = [Instr.Push(3), Instr.Add, None, Instr.Mul(7), Instr.Dup, Instr.Push(11), Instr.Add, None, Instr.Drop, Instr.Mul(5)]
    print(run(code, 200_000))
    let mut total = 0
    for k in 0..200 {
        total = (total + eval(tree(10, k))) % 1_000_003
    }
    print(total)
}
