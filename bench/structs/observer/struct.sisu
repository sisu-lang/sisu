// An observer in a run-time list keeps its own growing state, with `mut self` through `any`.
struct Model { n: i64 }
interface Observer {
    fn on(mut self, mut m: Model, x: i64)
    fn count(self) -> i64
}
struct Seen: Observer {
    xs: [i64]
    fn on(mut self, mut m: Model, x: i64) {
        m.n += 1
        self.xs.push(x)
    }
    fn count(self) -> i64 { self.xs.len() }
}
struct Empty: Observer {
    fn on(mut self, mut m: Model, x: i64) { }
    fn count(self) -> i64 { 0 }
}
fn main() {
    let mut n = 0
    for c in (read_line() ?? "").chars() {
        n = n * 10 + i64(c) - 48
    }
    let first: any Observer = Seen(xs: [])
    let empty: any Observer = Empty()
    let mut list: [any Observer] = [first, empty]
    let mut m = Model(n: 0)
    for x in 0..n {
        list[0].on(mut m, x)
        list[1].on(mut m, x)
    }
    print(m.n)
    print(list[0].count())
}
