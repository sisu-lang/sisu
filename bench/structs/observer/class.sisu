// The same observer as a class in an `any` list.
class Model { mut n: i64 }
interface Observer {
    fn on(self, m: Model, x: i64)
    fn count(self) -> i64
}
class Seen: Observer {
    mut xs: [i64]
    fn on(self, m: Model, x: i64) {
        m.n += 1
        self.xs.push(x)
    }
    fn count(self) -> i64 { self.xs.len() }
}
fn main() {
    let mut n = 0
    for c in (read_line() ?? "").chars() {
        n = n * 10 + i64(c) - 48
    }
    let list: [any Observer] = [Seen(xs: [])]
    let m = Model(n: 0)
    for x in 0..n {
        list[0].on(m, x)
    }
    print(m.n)
    print(list[0].count())
}
