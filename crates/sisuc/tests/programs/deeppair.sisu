// Two pairs of 100 000-deep `Expr`s, deep through `Both`'s second field, compared with `==`
// and dropped under a 256 KiB stack. `Expr` holds itself through `Two<Expr>`, so the box sits
// on `Expr.Pair`'s field and `Both` holds its two `Expr`s inline. The drop and `==` walk an
// inline `Expr` in place: a drop that drained it as a nested component, or an `==` that
// recursed on it, would need a frame per level and overflow that stack. The second pair
// differs only at the bottom, so `==` walks the whole value to find it.
enum Two<T> {
    Both(T, T)
}

enum Expr {
    Lit(i64)
    Pair(Two<Expr>)
}

// `Pair(Both(Lit(1), Pair(Both(Lit(2), ... Pair(Both(Lit(depth), Lit(last)))))))`.
fn build(depth: i64, last: i64) -> Expr {
    let mut e = Expr.Lit(last)
    let mut i = depth
    while i > 0 {
        e = Expr.Pair(Two.Both(Expr.Lit(i), e))
        i -= 1
    }
    e
}

fn main() {
    let a = build(100_000, 0)
    print(a == build(100_000, 0))
    print(a == build(100_000, 1))
}
