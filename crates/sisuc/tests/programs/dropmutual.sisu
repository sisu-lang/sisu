// Chains of objects of classes that hold each other, under a 256 KiB stack. `A` and `B` hold
// each other, and so do `X`, `Y` and `Z` in a ring of three. Each chain is 1 000 000 pairs or
// 300 000 triples long. The drop frees each chain in a loop, in one frame. A drop that called
// the drop of the next class would need a frame per object and overflow that stack.
class A {
    _b: B?
}

class B {
    _a: A?
}

class X {
    _y: Y?
}

class Y {
    _z: Z?
}

class Z {
    _x: X?
}

fn pairs() {
    let mut head = A(_b: None)
    let mut i = 0
    while i < 1_000_000 {
        head = A(_b: B(_a: head))
        i += 1
    }
    print(i)
}

fn triples() {
    let mut head = X(_y: None)
    let mut i = 0
    while i < 300_000 {
        head = X(_y: Y(_z: Z(_x: head)))
        i += 1
    }
    print(i)
}

fn main() {
    pairs()
    triples()
}
