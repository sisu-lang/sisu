// `==` on two enum values, under a 256 KiB stack, finds a mismatch in an earlier field before it
// compares a later one, in field order. The later fields hold two class chains of 20 000
// objects. The written `eq` of their class follows `left`, so `==` on those chains needs a frame
// per object, which overflows that stack, so an `==` that compared a later field first would
// crash. `Node` has one field before its last, and `Tri` has two.
class C: Eq {
    mut left: C?
    right: C?
    fn eq(self, other: Self) -> bool {
        self.left == other.left && self.right == other.right
    }
}

enum E {
    Leaf
    Value(C)
    Node(E, E)
    Tri(E, E, E)
}

fn chain(depth: i64) -> C {
    let mut c = C(left: None, right: None)
    for _ in 0..depth {
        c = C(left: c, right: None)
    }
    c
}

fn main() {
    let a = chain(20_000)
    let b = chain(20_000)
    let x = E.Node(E.Node(E.Leaf, E.Leaf), E.Value(a))
    let y = E.Node(E.Node(E.Node(E.Leaf, E.Leaf), E.Leaf), E.Value(b))
    print(x == y)    // false
    let p = E.Tri(E.Leaf, E.Value(a), E.Leaf)
    let q = E.Tri(E.Node(E.Leaf, E.Leaf), E.Value(b), E.Leaf)
    print(p == q)    // false
}
