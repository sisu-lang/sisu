// The control for `longlist.sisu`: 1 000 000 objects that alternate between two classes.
// Each class holds the other, not itself, so the drop recurses once per object and overflows
// the same 256 KiB stack.
class A {
    b: B?
}

class B {
    a: A?
}

fn main() {
    let mut a: A? = None
    let mut i = 0
    while i < 500_000 {
        i += 1
        let b = B(a: a)
        a = A(b: b)
    }
    print(1)
}
