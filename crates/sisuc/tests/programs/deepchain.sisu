// The control for `longlist.sisu`: 1 000 000 objects that alternate between two classes.
// Neither class has a chain field, so the drop recurses once per object and overflows the
// same 256 KiB stack.
class A {
    _b: B?
}

class B {
    _a: A?
}

fn main() {
    let mut a: A? = None
    let mut i = 0
    while i < 500_000 {
        i += 1
        let b = B(_a: a)
        a = A(_b: b)
    }
    print(1)
}
