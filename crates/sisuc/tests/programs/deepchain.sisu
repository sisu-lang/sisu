// The control for `longlist.sisu`: 500 000 objects that each hold the next in an array. The
// drop of an array is not a loop over the objects, so it recurses once per object and overflows
// the same 256 KiB stack.
class A {
    next: [A]
}

fn main() {
    let mut a = A(next: [])
    let mut i = 0
    while i < 500_000 {
        i += 1
        a = A(next: [a])
    }
    print(i)
}
