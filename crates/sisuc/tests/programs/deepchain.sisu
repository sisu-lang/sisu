// 500 000 objects that each hold the next in an array, run under a 256 KiB stack. The drop of an
// array is not a loop over the objects. Its drop function counts the drop depth and defers its
// block at the depth limit, so no frame is needed for each object.
class A {
    next: [A]
}

fn main() {
    let mut a = A(next: [])
    let mut i = 0
    while i < 500_000 {
        i += 1
        a = A(next: [a])
    }
    print(i)
}
