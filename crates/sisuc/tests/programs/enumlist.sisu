// A list of 100 000 `Cons` cells, run under a 256 KiB stack. Each tail is a box, and the
// drop frees the boxes from a pending list, in one frame; a drop that recursed on the tail
// needs a frame per cell and overflows that stack.
enum List {
    Nil
    Cons(i64, List)
}

fn main() {
    let mut list = List.Nil
    let mut length = 0
    while length < 100_000 {
        length += 1
        list = List.Cons(length, list)
    }
    print(length)
}
