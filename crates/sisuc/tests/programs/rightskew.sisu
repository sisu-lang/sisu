// A right-skewed tree of 1 000 000 nodes, run under a 256 KiB stack. Its drop recurses on
// `_left`, which is always None here, and follows `right`, the chain field, in a loop. A drop
// that loops on `_left` instead recurses on `right` once per node and overflows that stack.
class Tree {
    _left: Tree?
    right: Tree?
    _v: i64
}

fn main() {
    let mut root: Tree? = None
    let mut i = 0
    while i < 1_000_000 {
        i += 1
        root = Tree(_left: None, right: root, _v: i)
    }
    let mut depth = 0
    let mut node = root
    while let t = node {
        depth += 1
        node = t.right
    }
    print(depth)
}
