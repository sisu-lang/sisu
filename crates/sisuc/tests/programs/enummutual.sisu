// Two equal chains of 100 000 levels that alternate between the enums `A` and `B`, which
// hold each other, compared with `==` and then dropped under a 256 KiB stack. Both the drop and
// `==` step from `A` to `B` and back in one frame: the drain keeps one pending list per enum,
// and `==` loops on the last boxed field even when it changes enum. A recursive drop or `==`
// needs a frame per level and overflows that stack. `ToB` holds its level before its box, so
// that `A` and `B` lay out their boxes differently: a drain that took a box from the wrong list
// would read it as the other enum.
enum A {
    ToB(i64, B)
}

enum B {
    ToA(A)
    End
}

fn main() {
    let mut a = B.End
    let mut b = B.End
    let mut levels = 1
    while levels < 99_999 {
        levels += 2
        a = B.ToA(A.ToB(levels, a))
        b = B.ToA(A.ToB(levels, b))
    }
    print(levels + 1)
    print(A.ToB(levels + 1, a) == A.ToB(levels + 1, b))
}
