// Two pairs of lists of 100 000 nodes, compared with `==` under a 256 KiB stack. The
// generated `eq` steps along the chain field in a loop, in one frame, whether that field
// comes last (`Last`) or first (`First`); a recursive `eq` needs a frame per node and
// overflows that stack.
class Last {
    value: i64
    next: Last?
}

class First {
    next: First?
    value: i64
}

fn last(n: i64) -> Last? {
    let mut head: Last? = None
    let mut i = 0
    while i < n {
        i += 1
        head = Last(value: i, next: head)
    }
    head
}

fn first(n: i64) -> First? {
    let mut head: First? = None
    let mut i = 0
    while i < n {
        i += 1
        head = First(next: head, value: i)
    }
    head
}

fn main() {
    print(last(100_000) == last(100_000))
    print(first(100_000) == first(100_000))
}
