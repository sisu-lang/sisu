// Twelve functions that each make 100 000 tail calls whose result is an LLVM aggregate: an array,
// a string, two optionals, and results that join through `match`, `else if`, a nested `if`, a
// `match` arm with an `if`, a method, a nested scope, ten `else if` arms and ten nested `if`s.
// At -O2 each recursion is a loop, so the small stack holds.
fn walk_array(acc: [i64], n: i64) -> [i64] {
    if n == 0 {
        acc
    } else {
        walk_array(acc, n - 1)
    }
}

fn walk_string(acc: string, n: i64) -> string {
    if n == 0 {
        acc
    } else {
        walk_string(acc, n - 1)
    }
}

fn walk_optional_array(acc: [i64]?, n: i64) -> [i64]? {
    if n == 0 {
        acc
    } else {
        walk_optional_array(acc, n - 1)
    }
}

fn walk_optional_int(x: i64?, n: i64) -> i64? {
    if n == 0 {
        x
    } else {
        walk_optional_int(x, n - 1)
    }
}

fn walk_match(acc: [i64], n: i64) -> [i64] {
    match n {
        0 => acc
        _ => walk_match(acc, n - 1)
    }
}

fn walk_else_if(acc: [i64], n: i64) -> [i64] {
    if n == 0 {
        acc
    } else if n == -1 {
        []
    } else {
        walk_else_if(acc, n - 1)
    }
}

fn walk_nested(acc: [i64], n: i64) -> [i64] {
    if n == 0 {
        acc
    } else {
        if n == -1 {
            []
        } else {
            walk_nested(acc, n - 1)
        }
    }
}

fn walk_match_if(acc: [i64], n: i64) -> [i64] {
    match n {
        0 => acc
        _ => if n < 0 { [] } else { walk_match_if(acc, n - 1) }
    }
}

fn walk_scope(acc: [i64], n: i64) -> [i64] {
    if n == 0 {
        acc
    } else {
        let t = acc
        if n == -1 {
            []
        } else {
            walk_scope(t, n - 1)
        }
    }
}

fn walk_long_else_if(acc: [i64], n: i64) -> [i64] {
    if n == 0 {
        acc
    } else if n == -1 {
        []
    } else if n == -2 {
        []
    } else if n == -3 {
        []
    } else if n == -4 {
        []
    } else if n == -5 {
        []
    } else if n == -6 {
        []
    } else if n == -7 {
        []
    } else if n == -8 {
        []
    } else if n == -9 {
        []
    } else {
        walk_long_else_if(acc, n - 1)
    }
}

fn walk_deep_nest(acc: [i64], n: i64) -> [i64] {
    if n == 0 {
        acc
    } else {
        if n == -1 {
            []
        } else {
            if n == -2 {
                []
            } else {
                if n == -3 {
                    []
                } else {
                    if n == -4 {
                        []
                    } else {
                        if n == -5 {
                            []
                        } else {
                            if n == -6 {
                                []
                            } else {
                                if n == -7 {
                                    []
                                } else {
                                    if n == -8 {
                                        []
                                    } else {
                                        if n == -9 {
                                            []
                                        } else {
                                            walk_deep_nest(acc, n - 1)
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

enum Box {
    Of([i64])
}

extend Box {
    fn walk(self, n: i64) -> [i64] {
        if n == 0 {
            match self {
                Box.Of(a) => a
            }
        } else {
            self.walk(n - 1)
        }
    }
}

fn main() {
    let k = (read_line() ?? "").len()
    print(walk_array([1; k + 2], 100_000).len())  // 2
    print(walk_string("ab" + k.to_string(), 100_000).len())  // 3
    print((walk_optional_array(Some([1; k + 2]), 100_000) ?? []).len())  // 2
    print(walk_optional_int(Some(k + 2), 100_000) ?? 0)  // 2
    print(walk_match([1; k + 2], 100_000).len())  // 2
    print(walk_else_if([1; k + 2], 100_000).len())  // 2
    print(walk_nested([1; k + 2], 100_000).len())  // 2
    print(walk_match_if([1; k + 2], 100_000).len())  // 2
    print(Box.Of([1; k + 2]).walk(100_000).len())  // 2
    print(walk_scope([1; k + 2], 100_000).len())  // 2
    print(walk_long_else_if([1; k + 2], 100_000).len())  // 2
    print(walk_deep_nest([1; k + 2], 100_000).len())  // 2
}
