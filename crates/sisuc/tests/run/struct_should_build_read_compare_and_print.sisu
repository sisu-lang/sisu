// GIVEN `struct Point { x: i64; y: i64 }`
// WHEN `main` prints `Point(x: 1, y: 2)`, its field `y`, and two comparisons
// THEN it prints the value, `2`, `false` for a different `y` and `true` for the same fields
struct Point { x: i64; y: i64 }

fn main() {
    print(Point(x: 1, y: 2))                       // Point(x: 1, y: 2)
    print(Point(x: 1, y: 2).y)                     // 2
    print(Point(x: 1, y: 2) == Point(x: 1, y: 3))  // false
    print(Point(x: 1, y: 2) == Point(x: 1, y: 2))  // true
    print(Point(x: 1, y: 2) != Point(x: 1, y: 3))  // true
}
