// GIVEN `struct Rock {}`, which has no fields and a size of 0
// WHEN an array of three grows by `push` past its first capacity, and a slice takes a part of it
// THEN `len` gives the count after each step
struct Rock {}

fn main() {
    let mut xs = [Rock(); 3]
    print(xs.len())                  // 3
    for _ in 0..100 {
        xs.push(Rock())
    }
    print(xs.len())                  // 103
    let part = xs[1..50]
    print(part.len())                // 49
    xs.push(Rock())
    print(xs.len())                  // 104
    print(part.len())                // 49: the push does not change the slice
}
