// GIVEN functions with valued, statement, exiting, `if let`, `else if let` and non-empty `else` chains
// WHEN the program builds and runs
// THEN each chain returns or prints its matching arm value and releases counted strings cleanly
fn pick_u8(n: i64, a: u8) -> u8 {
    if n == 0 {
        a
    } else if n == 1 {
        a + 1
    } else if n == 2 {
        a + 2
    } else if n == 3 {
        a + 3
    } else {
        a + 4
    }
}

fn pick_str(n: i64, s: string) -> string {
    if n == 0 {
        s + "-0"
    } else if n == 1 {
        s + "-1"
    } else if n == 2 {
        return s + "-ret"
    } else {
        s + "-end"
    }
}

fn stmt_fall(n: i64) {
    if n == 0 {
        print("sf-0")
    } else if n == 1 {
        print("sf-1")
    } else if n == 2 {
        print("sf-2")
    }
    print("sf-after")
}

fn stmt_ret(n: i64) {
    if n == 0 {
        return
    } else if n == 1 {
        print("sr-1")
    } else if n == 2 {
        let s = "sr-" + "{n}"
        print(s)
    }
    print("sr-after")
}

fn exit_cond(a: bool, b: bool, c: bool) -> i64 {
    if a {
        100
    } else if (if b { return 200 } else { c }) {
        300
    } else {
        400
    }
}

fn exit_cond_after_ret(a: bool, b: bool, c: bool) -> i64 {
    if a {
        return 10
    } else if (if b { return 20 } else { c }) {
        30
    } else {
        40
    }
}

fn lead_if_let(o: string?, n: i64) -> i64 {
    if let s = o {
        s.len()
    } else if n == 1 {
        10
    } else if n == 2 {
        20
    } else {
        30
    }
}

fn trailing_if_let(c: bool, o: string?) -> i64 {
    if c {
        1
    } else if let s = o {
        s.len()
    } else {
        0
    }
}

fn non_empty_else(c1: bool, c2: bool, tail: string) -> i64 {
    if c1 {
        1
    } else {
        let s = "else-" + tail
        print(s)
        if c2 {
            2
        } else {
            3
        }
    }
}

fn loop_exits(o: string?, xs: [i64]) -> i64 {
    let mut total = 0
    for x in xs {
        if let s = o {
            total = total + s.len()
        } else if x == 1 {
            continue
        } else if x == 2 {
            break
        } else if x == 9 {
            return 99
        } else {
            total = total + x
        }
    }
    total
}

fn main() {
    let base = (read_line() ?? "").len()
    let s = "v" + "{base}"
    print(pick_u8(base, 10))                  // 10
    print(pick_u8(base + 2, 10))              // 12
    print(pick_u8(base + 4, 10))              // 14
    print(pick_str(base, s))                  // v0-0
    print(pick_str(base + 2, s))              // v0-ret
    print(pick_str(base + 3, s))              // v0-end
    stmt_fall(base + 1)                       // sf-1, sf-after
    stmt_fall(base + 9)                       // sf-after
    stmt_ret(base)                            // (returns early)
    stmt_ret(base + 2)                        // sr-2, sr-after
    stmt_ret(base + 9)                        // sr-after
    print(exit_cond(true, false, false))          // 100
    print(exit_cond(false, true, false))          // 200
    print(exit_cond(false, false, true))          // 300
    print(exit_cond(false, false, false))         // 400
    print(exit_cond_after_ret(true, false, false))  // 10
    print(exit_cond_after_ret(false, true, false))  // 20
    print(exit_cond_after_ret(false, false, true))  // 30
    print(exit_cond_after_ret(false, false, false)) // 40
    let some_str: string? = "abc" + s
    print(lead_if_let(some_str, 1))           // 5
    print(lead_if_let(None, 2))               // 20
    print(lead_if_let(None, 9))               // 30
    print(trailing_if_let(true, some_str))    // 1
    print(trailing_if_let(false, some_str))   // 5
    print(trailing_if_let(false, None))       // 0
    print(non_empty_else(true, false, s))     // 1
    print(non_empty_else(false, true, s))     // else-v0, 2
    print(non_empty_else(false, false, s))    // else-v0, 3
    print(loop_exits(None, [3, 1, 4, 2, 5]))  // 7
    print(loop_exits(None, [3, 9, 4]))        // 99
    print(loop_exits(some_str, [1, 2]))       // 10
}
