fn iterations() -> i64 { 1000 }

// GIVEN `xs` of five elements and a loop that takes `xs[1..4]` `iterations()` times and adds
// each slice's first element and its length
// WHEN the program prints the sum
// THEN a range index allocates nothing: the slice shares the block of `xs` (S2)
fn main() {
    let xs = [1, 2, 3, 4, 5]
    let mut sum = 0
    for _ in 0..iterations() {
        let t = xs[1..4]
        sum += t[0] + t.len()
    }
    print(sum)                       // 5000 (0 with no iterations)
}
