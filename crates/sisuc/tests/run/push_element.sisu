fn iterations() -> i64 { 1000 }

// GIVEN an array of arrays, whose first element nothing else holds
// WHEN `main` pushes `iterations()` elements onto that element
// THEN each push is in place, and the outer array is never copied
fn main() {
    let mut xss = [[0]]
    for i in 0..iterations() {
        xss[0].push(i)
    }
    print(xss[0].len())              // 1001 (1 with no iterations)
}
