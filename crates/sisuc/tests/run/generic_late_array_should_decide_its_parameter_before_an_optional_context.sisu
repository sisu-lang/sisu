// GIVEN `hs<A, B>(_c: bool, p: [P<A, B>]) -> A` and a method call `C().k(n)` that returns
// `P<i64, i64>`, so that an array of such calls is a late argument (Q28)
// AND a context that asks for an optional: `i64?`, `i64??`, `any Display`, a return type, a call
// argument or a method call
// WHEN `main` calls `hs` or `hb` with an array of method calls in each of these contexts and
// prints each result
// THEN each array decides `A` and `B` from its own elements, the result wraps at its top, and
// `main` prints the value of the element
struct P<A, B> {
    a: A
    b: B
}

struct C {
    fn k(self, n: i64) -> P<i64, i64> { P(a: n, b: n) }
    fn ko(self, n: i64) -> P<i64?, i64> { P(a: Some(n), b: n) }
    fn mk<X>(self) -> P<i64, X?> { P(a: 1, b: None) }
    fn hs<A, B>(self, _c: bool, p: [P<A, B>]) -> A { p[0].a }
}

fn hs<A, B>(_c: bool, p: [P<A, B>]) -> A { p[0].a }

fn hb<A, B>(_c: bool, p: [P<A, B>]) -> B { p[0].b }

// The second parameter names `B`, and the third decides `D` from a plain argument.
fn hs2<A, B, D>(p: [P<A, B>], _q: P<B, D?>, _d: D) -> A { p[0].a }

fn takes(x: i64?) -> i64 { x ?? -1 }

fn one_element() -> i64 {
    let y: i64? = hs(true, [C().k(1)])
    y ?? -1
}

fn two_elements() -> i64 {
    let y: i64? = hs(true, [C().k(2), C().k(3)])
    y ?? -1
}

// `A` is `i64?` here, so the result wraps once more: `i64??`.
fn optional_element() -> i64 {
    let y: i64?? = hs(true, [C().ko(4)])
    if let Some(inner) = y {
        inner ?? -2
    } else {
        -1
    }
}

fn mixed_elements() -> i64 {
    let y: i64? = hs(true, [C().k(5), P(a: 6, b: 7)])
    y ?? -1
}

fn second_parameter() -> i64 {
    let y: i64? = hb(true, [C().k(8)])
    y ?? -1
}

fn returned() -> i64? {
    hs(true, [C().k(9)])
}

fn later_argument_waits() -> i64 {
    let y: i64? = hs2([C().k(10)], C().mk(), true)
    y ?? -1
}

fn in_method() -> i64 {
    let y: i64? = C().hs(true, [C().k(11)])
    y ?? -1
}

fn in_call_argument() -> i64 {
    takes(hs(true, [C().k(12)]))
}

fn in_any() -> any Display {
    let y: any Display = hs(true, [C().k(13)])
    y
}

fn main() {
    print(one_element())              // 1
    print(two_elements())             // 2
    print(optional_element())         // 4
    print(mixed_elements())           // 5
    print(second_parameter())         // 8
    print(returned() ?? -1)           // 9
    print(later_argument_waits())     // 10
    print(in_method())                // 11
    print(in_call_argument())         // 12
    print(in_any())                   // 13
}
