// GIVEN an interface `I`, an interface `J` that inherits `I`, classes that conform to them, and
// values of an `any` type, of an object type and of an optional `any` type
// WHEN they meet where an `if`, a `match`, a `loop` with `break` values or an array literal joins
// them, with the `any` value first or last, and with an expected `any`, optional `any`, or no type
// THEN the join is the `any` type, with an optional layer when one side has it, every value is
// converted to it, and the program runs the same plain, at -O2, under Valgrind and with checks
interface I {
    fn v(self) -> i64
}

interface J: I {
    fn w(self) -> i64
}

class C: I {
    fn v(self) -> i64 {
        42
    }
}

class D: I {
    fn v(self) -> i64 {
        7
    }
}

class K: J {
    fn v(self) -> i64 {
        5
    }

    fn w(self) -> i64 {
        6
    }
}

fn or_minus(o: (any I)?) -> i64 {
    if let x = o {
        x.v()
    } else {
        -1
    }
}

fn main() {
    let cond = true
    let n = 1
    let n2 = 2
    let a: any I = C()
    let o: (any I)? = D()
    let j: any J = K()

    // The `any` value first, and last, with no expected type.
    let r = if cond { a } else { D() }
    print(r.v()) // 42
    let r = if cond { D() } else { a }
    print(r.v()) // 7
    let r = match n {
        0 => a
        _ => D()
    }
    print(r.v()) // 7
    let r = match n {
        0 => D()
        _ => a
    }
    print(r.v()) // 42

    // An optional `any` joins with an object, and the object is wrapped.
    let r = if cond { o } else { C() }
    print(or_minus(r)) // 7
    let r = if cond { C() } else { o }
    print(or_minus(r)) // 42

    // An `any` that inherits joins with one that it inherits, in either order.
    let r = if cond { j } else { a }
    print(r.v()) // 5
    let r = if cond { a } else { j }
    print(r.v()) // 42
    let r = if cond { K() } else { a }
    print(r.v()) // 5

    // Three arms: the join grows, and the first arm converts to it.
    let r = match n {
        0 => K()
        1 => j
        _ => a
    }
    print(r.v()) // 5

    // The expected type is `any I` or `(any I)?`.
    let r: any I = if cond { a } else { D() }
    print(r.v()) // 42
    let r: (any I)? = if cond { a } else { D() }
    print(or_minus(r)) // 42

    // `break` values: one loop type for all of them, and the earlier values convert.
    let r = loop {
        if cond {
            break a
        }
        break D()
    }
    print(r.v()) // 42
    let r = loop {
        if !cond {
            break D()
        }
        break a
    }
    print(r.v()) // 42
    let r: (any I)? = loop {
        if !cond {
            break a
        }
        break C()
    }
    print(or_minus(r)) // 42
    let r: (any I)? = loop {
        if cond {
            break a
        }
        break C()
    }
    print(or_minus(r)) // 42
    let r = loop {
        if !cond {
            break j
        }
        break a
    }
    print(r.v()) // 42

    // The earlier `break` runs, and its value converts to the type that a later one gives.
    let r = loop {
        if cond {
            break D()
        }
        break a
    }
    print(r.v()) // 7
    let r = loop {
        if cond {
            break a
        }
        break o
    }
    print(or_minus(r)) // 42
    let r = loop {
        if cond {
            break j
        }
        break a
    }
    print(r.v()) // 5

    // Array literals.
    let xs = [a, D()]
    print(xs[0].v() + xs[1].v()) // 49
    let xs = [D(), a, j]
    print(xs[0].v() + xs[1].v() + xs[2].v()) // 54
    let xs = [o, C()]
    print(or_minus(xs[0]) + or_minus(xs[1])) // 49
    let xs: [(any I)?] = [a, C(), None]
    print(or_minus(xs[0]) + or_minus(xs[1]) + or_minus(xs[2])) // 83

    // The order of the members does not matter: an `else if` chain, a `match`, an array and a
    // loop take the `any` value last, or in the middle, with another class or a `None`.
    let c2 = false
    let r = if cond { C() } else if c2 { D() } else { a }
    print(r.v()) // 42
    let r = if c2 { C() } else if cond { a } else { D() }
    print(r.v()) // 42
    let r: (any I)? = if c2 { C() } else if c2 { a } else { None }
    print(or_minus(r)) // -1
    let r = if cond { C() } else if c2 { a } else { None }
    print(or_minus(r)) // 42
    let r = if c2 { C() } else if c2 { a } else { None }
    print(or_minus(r)) // -1
    let r = match n2 {
        0 => C()
        1 => D()
        _ => a
    }
    print(r.v()) // 42
    let r: (any I)? = match n {
        0 => C()
        1 => a
        _ => None
    }
    print(or_minus(r)) // 42
    let r = match n {
        0 => C()
        1 => a
        _ => None
    }
    print(or_minus(r)) // 42
    let xs = [C(), D(), a]
    print(xs[0].v() + xs[1].v() + xs[2].v()) // 91
    let xs = [C(), a, None]
    print(or_minus(xs[0]) + or_minus(xs[2])) // 41
    let r = loop {
        if c2 {
            break C()
        }
        if cond {
            break D()
        }
        break a
    }
    print(r.v()) // 7
    let r = loop {
        if c2 {
            break D()
        }
        if c2 {
            break C()
        }
        break a
    }
    print(r.v()) // 42

    // `??` joins its payload and its default.
    let oc: C? = None
    let od: D? = D()
    print((oc ?? a).v()) // 42
    let r: (any I)? = oc ?? o
    print(or_minus(r)) // 7
    print((o ?? C()).v()) // 7
    print((oc ?? od ?? a).v()) // 7
    let r: any I = oc ?? a
    print(r.v()) // 42
    let jo: (any J)? = K()
    let none_j: (any J)? = None
    print((jo ?? a).v()) // 5
    print((none_j ?? a).v()) // 42

    // A branch's type is a hint for the branches after it, which they do not convert to: a
    // chain of `any` values, a nested join of two classes and a loop give the `any` type.
    let r = if c2 { j } else if cond { K() } else { a }
    print(r.v()) // 5
    let r = if c2 { j } else if cond { a } else { K() }
    print(r.v()) // 42
    let r = if c2 { K() } else if cond { j } else { a }
    print(r.v()) // 5
    let r = if c2 { K() } else if cond { a } else { j }
    print(r.v()) // 42
    let r = if c2 { a } else if cond { j } else { K() }
    print(r.v()) // 5
    let r = if c2 { a } else if cond { K() } else { j }
    print(r.v()) // 5
    let r = if cond { a } else if c2 { a } else { a }
    print(r.v()) // 42
    let r = if c2 { a } else if cond { C() } else { D() }
    print(r.v()) // 42
    let r = if c2 {
        a
    } else {
        loop {
            if c2 {
                break C()
            }
            break D()
        }
    }
    print(r.v()) // 7

    // A `Some` of an object that does not convert to the hint keeps its type, and the join
    // converts it to the wider `any` type of a later branch. A `None` joins too.
    let r = if c2 { j } else if cond { Some(C()) } else { a }
    print(or_minus(r)) // 42
    let r = if c2 { Some(C()) } else if cond { j } else { a }
    print(or_minus(r)) // 5
    let r = if c2 { a } else if c2 { j } else { Some(C()) }
    print(or_minus(r)) // 42
    let r = match n {
        0 => j
        1 => Some(C())
        _ => a
    }
    print(or_minus(r)) // 42
    let r = match n2 {
        0 => Some(C())
        1 => j
        _ => a
    }
    print(or_minus(r)) // 42
    let r = match n2 {
        0 => Some(C())
        1 => a
        _ => None
    }
    print(or_minus(r)) // -1
    let r = if c2 { None } else if cond { Some(C()) } else { a }
    print(or_minus(r)) // 42
}
