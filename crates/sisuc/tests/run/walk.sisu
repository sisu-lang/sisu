fn iterations() -> i64 { 1000 }

// `for x in xs` copies nothing (the loop holds its own reference): 1000 walks of 10 000
// elements allocate nothing.
fn main() {
    let xs = [1; 10_000]
    let mut total = 0
    for _ in 0..iterations() {
        for x in xs { total += x }
    }
    print(total) // 1000 * 10 000 = 10000000 (0 with no iterations)
}
