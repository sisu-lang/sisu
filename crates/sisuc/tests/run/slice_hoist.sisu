// GIVEN `let mut xs = [1, 2, 3]`
// WHEN the program runs `for i in 0..2 { let u = xs[..2]; xs[0] = 9 + i; print(u) }`
// THEN it prints `[1, 2]` and then `[9, 2]`: the write in the loop copies the block that `u`
// shares, and the hoist of that copy out of the loop would let it reach `u` (S20)
fn main() {
    let mut xs = [1, 2, 3]
    for i in 0..2 {
        let u = xs[..2]
        xs[0] = 9 + i
        print(u)
    }
    print(xs)                        // [10, 2, 3]
}
