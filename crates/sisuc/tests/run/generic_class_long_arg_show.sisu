// GIVEN a non-generic class with a 300-character name inside a generic `Box<T>`
// WHEN `main` runs `print` and `dbg` on `Box(v: ...)`
// THEN both print the whole generic class name without cutting
class  {
    x: i64
}

class Box<T> {
    v: T
}

fn main() {
    let b = Box(v: (x: 1))
    print(b) // Box<>
    let _ = dbg(b) // Box<Laaa...a>(v: Laaa...a)
    print(b.v.x) // 1
}
