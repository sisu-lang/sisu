// GIVEN generic functions `id`, `pick` (it returns its second argument), `k`, `first`, `k2`,
//       `wrap`, `g`, `two`, `mk` and `unbox`, a class `Bx<T>`, a function `opt` that returns `T?`,
//       a class with a generic method `m`, and an interface `R` with a generic requirement `r`
// WHEN an optional value (`Some(2)`, `opt(2)`, an `if` with a `None` branch, a safe call) is an
//      argument of a generic call beside a plain literal, in both orders
// AND the call has no context or an `i64?` context, and the optional is also inside an array
// AND a safe call is the argument of `id`, on a present receiver and on an absent one
// AND a call wraps the optional in an array or a class, as `wrap`, `g`, `two`, `mk` and `unbox` do
// AND a context of `i64?` or `u8?` meets the call that holds the optional whole
// AND the context is `i64??`, and the argument of `first` is `[None, Some(1)]`
// AND a nested literal, as in `id(id(2))` or `id({ 2 })`, is beside a `u8`
// THEN the parameter is the optional type, as it is when the optional comes first, the literal
//      fits it, and each line prints the value, or 9 for an absent one
// AND the same holds for a safe call of a method and for one of a bound's requirement
// AND the same holds for the wrapped optional
// AND the context gives the `Some` as the value, and the `i64??` line prints `none`
// AND each nested-literal line prints 252
fn id<T>(x: T) -> T { x }
fn pick<T>(_a: T, b: T) -> T { b }
fn opt<T>(x: T) -> T? { Some(x) }
fn k<T>(a: T, _b: [T]) -> T { a }
fn first<T>(xs: [T]) -> T { xs[0] }
fn k2<T, U>(_a: T, b: U) -> U { b }
fn wrap<T>(x: T) -> [T] { [x] }
fn g<T>(xs: [T]) -> [T] { xs }
fn two<T>(a: T, _b: i64) -> [T] { [a] }
fn mk<T>(x: T) -> Bx<T> { Bx(v: x) }
fn unbox<T>(b: Bx<T>) -> T { b.v }

class Bx<T> {
    v: T
}

class B {
    fn m<T>(self, x: T) -> T { x }
}

interface R {
    fn r<T>(self, x: T) -> T
}

class Q: R {
    fn r<T>(self, x: T) -> T { x }
}

fn via<X: R>(x: X?) -> i64? {
    id(x?.r(1))
}

fn main() {
    let yes = true
    let no = false
    let v = pick(1, Some(2))
    print("{v ?? 9}") // 2
    let w = pick(1, opt(3))
    print("{w ?? 9}") // 3
    let u = pick(1, if yes { 4 } else { None })
    print("{u ?? 9}") // 4
    let t = pick(1, if no { 4 } else { None })
    print("{t ?? 9}") // 9
    let s = pick(Some(5), 1)
    print("{s ?? 9}") // 1
    let r: i64? = pick(1, Some(6))
    print("{r ?? 9}") // 6
    // A safe call has an optional result, so `id` meets the `i64?` context whole.
    let present: B? = B()
    let absent: B? = None
    let a: i64? = id(present?.m(7))
    print("{a ?? 9}") // 7
    let b: i64? = id(absent?.m(7))
    print("{b ?? 9}") // 9
    let c = pick(1, present?.m(8))
    print("{c ?? 9}") // 8
    let d = pick(1, absent?.m(8))
    print("{d ?? 9}") // 9
    let e = [present?.m(10), 11]
    print("{e[0] ?? 9} {e[1] ?? 9}") // 10 11
    let q: Q? = Q()
    let f = via(q)
    print("{f ?? 9}") // 1
    let none: Q? = None
    let g = via(none)
    print("{g ?? 9}") // 9
    // An optional inside an array literal binds first as well.
    let h = pick([1], [Some(12)])
    print("{h[0] ?? 9}") // 12
    let i = pick([[1]], [[Some(13)]])
    print("{i[0][0] ?? 9}") // 13
    let j = pick([1], id([Some(14)]))
    print("{j[0] ?? 9}") // 14
    let l = pick([1], [None, Some(15)])
    print("{l[0] ?? 9} {l[1] ?? 9}") // 9 15
    let m = pick([1], [if yes { 16 } else { None }])
    print("{m[0] ?? 9}") // 16
    let n = pick([1], [present?.m(17)])
    print("{n[0] ?? 9}") // 17
    let o = k(1, [Some(18)])
    print("{o ?? 9}") // 1
    let p: i64? = k(1, [Some(19)])
    print("{p ?? 9}") // 1
    let r: i64? = first([Some(20)])
    print("{r ?? 9}") // 20
    print("{pick([1], [Some(21)]) == [Some(21)]}") // true
    // The `Some` of `k2(Some(1), [2])` is not returned, so `[Some(22)]` binds first.
    let t = pick(k2(Some(1), [2]), [Some(22)])
    print("{t[0] ?? 9}") // 22
    let u = pick([1], k2(Some(1), [23]))
    print("{u[0]}") // 23
    // A call that wraps the optional in an array or a class holds it too.
    let w1 = pick([1], wrap(Some(24)))
    print("{w1[0] ?? 9}") // 24
    let w2 = pick([1], g([Some(25)]))
    print("{w2[0] ?? 9}") // 25
    let w3 = pick(1, unbox(Bx(v: Some(26))))
    print("{w3 ?? 9}") // 26
    let w4 = k(1, wrap(Some(27)))
    print("{w4 ?? 9}") // 1
    let w5 = pick([1], two(Some(28), 1))
    print("{w5[0] ?? 9}") // 28
    let w6 = pick(Bx(v: 1), mk(Some(29)))
    print("{w6.v ?? 9}") // 29
    let w7 = pick([1], wrap(present?.m(30)))
    print("{w7[0] ?? 9}") // 30
    let w8 = pick([[1]], wrap([Some(31)]))
    print("{w8[0][0] ?? 9}") // 31
    let w9 = pick(1, first(wrap(Some(32))))
    print("{w9 ?? 9}") // 32
    // The context meets the call whole, so the `Some` is the value.
    let c1: i64? = unbox(Bx(v: Some(33)))
    print("{c1 ?? 9}") // 33
    let c2: i64? = first(wrap(Some(34)))
    print("{c2 ?? 9}") // 34
    let c3: u8? = first(wrap(Some(35)))
    print("{c3 ?? 9}") // 35
    let c4: i64? = k(1, wrap(Some(36)))
    print("{c4 ?? 9}") // 1
    let c5: u8? = unbox(Bx(v: Some(37)))
    print("{c5 ?? 9}") // 37
    // An `i64??` context meets the return type whole, so the `None` is the outer one.
    let nn: i64?? = first([None, Some(1)])
    if let Some(_) = nn {
        print("some")
    } else {
        print("none") // none
    }
    // An integer literal nests in the forms that pass it on.
    let small: u8 = 250
    print("{id(id(2)) + small}") // 252
    print("{id({ 2 }) + small}") // 252
    let last = { id(2) } + small
    print("{last}") // 252
}
