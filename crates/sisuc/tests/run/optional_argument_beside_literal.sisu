// GIVEN generic functions `id`, `pick` (it returns its second argument), `k`, `first` and `k2`, a
//       function `opt` that returns `T?`, a class with a generic method `m`, and an interface
//       `R` with a generic requirement `r`
// WHEN an optional value (`Some(2)`, `opt(2)`, an `if` with a `None` branch, a safe call) is an
//      argument of a generic call beside a plain literal, in both orders
// AND the call has no context or an `i64?` context, and the optional is also inside an array
// AND a safe call is the argument of `id`, on a present receiver and on an absent one
// THEN the parameter is the optional type, as it is when the optional comes first, the literal
//      fits it, and each line prints the value, or 9 for an absent one
// AND the same holds for a safe call of a method and for one of a bound's requirement
fn id<T>(x: T) -> T { x }
fn pick<T>(_a: T, b: T) -> T { b }
fn opt<T>(x: T) -> T? { Some(x) }
fn k<T>(a: T, _b: [T]) -> T { a }
fn first<T>(xs: [T]) -> T { xs[0] }
fn k2<T, U>(_a: T, b: U) -> U { b }

class B {
    fn m<T>(self, x: T) -> T { x }
}

interface R {
    fn r<T>(self, x: T) -> T
}

class Q: R {
    fn r<T>(self, x: T) -> T { x }
}

fn via<X: R>(x: X?) -> i64? {
    id(x?.r(1))
}

fn main() {
    let yes = true
    let no = false
    let v = pick(1, Some(2))
    print("{v ?? 9}") // 2
    let w = pick(1, opt(3))
    print("{w ?? 9}") // 3
    let u = pick(1, if yes { 4 } else { None })
    print("{u ?? 9}") // 4
    let t = pick(1, if no { 4 } else { None })
    print("{t ?? 9}") // 9
    let s = pick(Some(5), 1)
    print("{s ?? 9}") // 1
    let r: i64? = pick(1, Some(6))
    print("{r ?? 9}") // 6
    // A safe call has an optional result, so `id` meets the `i64?` context whole.
    let present: B? = B()
    let absent: B? = None
    let a: i64? = id(present?.m(7))
    print("{a ?? 9}") // 7
    let b: i64? = id(absent?.m(7))
    print("{b ?? 9}") // 9
    let c = pick(1, present?.m(8))
    print("{c ?? 9}") // 8
    let d = pick(1, absent?.m(8))
    print("{d ?? 9}") // 9
    let e = [present?.m(10), 11]
    print("{e[0] ?? 9} {e[1] ?? 9}") // 10 11
    let q: Q? = Q()
    let f = via(q)
    print("{f ?? 9}") // 1
    let none: Q? = None
    let g = via(none)
    print("{g ?? 9}") // 9
    // An optional inside an array literal binds first as well.
    let h = pick([1], [Some(12)])
    print("{h[0] ?? 9}") // 12
    let i = pick([[1]], [[Some(13)]])
    print("{i[0][0] ?? 9}") // 13
    let j = pick([1], id([Some(14)]))
    print("{j[0] ?? 9}") // 14
    let l = pick([1], [None, Some(15)])
    print("{l[0] ?? 9} {l[1] ?? 9}") // 9 15
    let m = pick([1], [if yes { 16 } else { None }])
    print("{m[0] ?? 9}") // 16
    let n = pick([1], [present?.m(17)])
    print("{n[0] ?? 9}") // 17
    let o = k(1, [Some(18)])
    print("{o ?? 9}") // 1
    let p: i64? = k(1, [Some(19)])
    print("{p ?? 9}") // 1
    let r: i64? = first([Some(20)])
    print("{r ?? 9}") // 20
    print("{pick([1], [Some(21)]) == [Some(21)]}") // true
    // The `Some` of `k2(Some(1), [2])` is not returned, so `[Some(22)]` binds first.
    let t = pick(k2(Some(1), [2]), [Some(22)])
    print("{t[0] ?? 9}") // 22
    let u = pick([1], k2(Some(1), [23]))
    print("{u[0]}") // 23
}
