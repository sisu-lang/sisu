// Each callee below recurses and works after its recursive call, so that it is not a tail call.
// `keeps` and `gives` pass the depth `i % 2 + 1`: `-O2` unrolls their three iterations, so the
// calls receive the constants 1, 2 and 1, three calls in each. `main` passes the argument count,
// known only at run time. The markers check that these calls survive `-O2`, so each value
// crosses a real call.
// args: a
// o2-calls: keeps keep 3
// o2-calls: gives give 3
// o2-calls: main name_of 1
// o2-calls: main a 1
// o2-calls: main len 1
// o2-calls: main look 1
// o2-calls: main slen 1
class W {
    s: string
}

class B {
    s: string
}

// `keep` and `give` own their parameter: each returns it, `keep` through a named local.
fn keep(p: [i64], depth: i64) -> [i64] {
    let mut q = p
    if depth > 0 {
        q = keep(q, depth - 1)
    }
    if q.len() == 0 {
        q = [0]
    }
    q
}

fn give(p: [i64], depth: i64) -> [i64] {
    if depth > 0 && give(p, depth - 1).len() == 0 {
        return [0]
    }
    p
}

// Each of these only reads its parameter, so it is borrowed.
fn name_of(w: W, depth: i64) -> string {
    if depth > 0 && name_of(w, depth - 1) == "" {
        return ""
    }
    w.s
}

// Prints `s` once, at the deepest level.
fn len(s: string, depth: i64) -> i64 {
    if depth > 0 && len(s, depth - 1) < 0 {
        return -1
    }
    if depth == 0 {
        print(s)
    }
    s.len()
}

fn size(xs: [i64]) -> i64 { xs.len() }

fn look(xs: [i64], depth: i64) -> i64 {
    if depth > 0 && look(xs, depth - 1) < 0 {
        return -1
    }
    size(xs)
}

fn slen(s: string, depth: i64) -> i64 {
    if depth > 0 && slen(s, depth - 1) < 0 {
        return -1
    }
    s.len()
}

// `a` stores `p`, and `b` passes it to `a`, so both own it.
fn a(p: string, n: i64) -> B {
    if n == 0 {
        B(s: p)
    } else {
        let r = b(p, n - 1)
        if r.s == "" {
            return B(s: "")
        }
        r
    }
}

fn b(p: string, n: i64) -> B { a(p, n) }

// `saved` holds the array `keep` returned, so writing `xs` must copy it first.
fn keeps() {
    let mut xs = [0, 0, 0]
    let mut saved = [0, 0, 0]
    let mut i = 0
    while i < 3 {
        xs[i] = 1
        print(saved[i])
        saved = keep(xs, i % 2 + 1)
        i += 1
    }
    print(saved[2])
}

fn gives() {
    let mut xs = [0, 0, 0]
    let mut saved = [0, 0, 0]
    let mut i = 0
    while i < 3 {
        xs[i] = 1
        print(saved[i])
        saved = give(xs, i % 2 + 1)
        i += 1
    }
    print(saved[2])
}

fn main(args: [string]) {
    let d = args.len()
    keeps()                          // 0, 0, 0, then 1
    gives()                          // 0, 0, 0, then 1
    let k = 4
    print(name_of(W(s: "n{k}"), d))  // n4
    let n = 3
    print(a("p{n}", d).s)            // p3
    print(len("v{k}", d))            // v4, then 2
    print(look([1, k], d))           // 2
    print(slen("w{k}{k}", d))        // 3
}
