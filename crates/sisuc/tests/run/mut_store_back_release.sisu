// GIVEN `class Node { value: i64 }`, `class Bag { mut nodes: [Node] }` and
// `fn replace(mut nodes: [Node], b: Bag) { print(b.nodes.len()); nodes = [Node(value: 1)] }`
// WHEN `main` calls `replace(mut b.nodes, b)` on two nodes and prints `b.nodes.len()`
// THEN it prints "2", then "1"
// AND the `--rc-checks` build and Valgrind find no fault: the store-back writes the new value,
// then releases the old one, which `b` still held while the callee ran
class Node {
    value: i64
}

class Bag {
    mut nodes: [Node]
}

fn replace(mut nodes: [Node], b: Bag) {
    print(b.nodes.len())
    nodes = [Node(value: 1)]
}

fn main() {
    let b = Bag(nodes: [Node(value: 1), Node(value: 2)])
    replace(mut b.nodes, b)
    print(b.nodes.len())
}
