// GIVEN `class Box { mut x: [i64] }` and `fn f(mut b: Box, mut x: [i64])` that sets `b` to a new
// `Box(x: [20])` and `x` to `[30]`
// WHEN `main` calls `f(mut b, mut b.x)` on `let mut b = Box(x: [10])` and prints `old.x`, where
// `old` is the first object, then `b.x`
// THEN it prints "[30]", then "[20]": the store-back of `b.x` lands on the object kept at the
// copy-in, then the store-back of `b` rebinds the root
// AND Valgrind and `--rc-checks` find the kept object released once
class Box {
    mut x: [i64]
}

fn f(mut b: Box, mut x: [i64]) {
    b = Box(x: [20])
    x = [30]
}

fn main() {
    let mut b = Box(x: [10])
    let old = b
    f(mut b, mut b.x)
    print(old.x)
    print(b.x)
}
