// GIVEN `xs = [1, 2, 3]`, the slice `xs[1..]`, an empty `[i64]`, and a `[string]`
// WHEN the program prints `first`, `last` and `get` of each, and `get` at -1, 0, 2, 3 and 4
// THEN an index in bounds gives its element, and any other gives `None` instead of a panic
// AND a `string` element that `get` reads is still there afterwards (S7, Goal 1.4)
fn main() {
    let xs = [1, 2, 3]
    let e: [i64] = []
    print(xs.first() ?? -1)           // 1
    print(xs[1..].last() ?? -1)       // 3
    print(e.first() ?? -1)            // -1
    print(e.last() ?? -1)             // -1
    print(xs.get(2) ?? -1)            // 3
    print(xs.get(3) ?? -1)            // -1
    print(xs.get(-1) ?? -1)           // -1
    print(e.get(0) ?? -1)             // -1

    let tail = xs[1..]
    print(tail.first() ?? -1)         // 2
    print(tail.get(1) ?? -1)          // 3
    print(tail.get(2) ?? -1)          // -1
    print(xs[3..].first() ?? -1)      // -1

    let words = ["a", "b"]
    print(words.get(1) ?? "none")     // b
    print(words.get(2) ?? "none")     // none
    print(words.last() ?? "none")     // b
    print(words)                      // [a, b]
}
