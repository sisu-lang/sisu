fn iterations() -> i64 { 1000 }

// The handover through a box with count one: taking `t` apart at the commit moves `xs` out of
// its box, which held the array alone, so `xs` has count 1 and `ys[0]` writes in place. Each
// step copies no array. `match` reuses the old box, so each step allocates nothing.
enum Tree {
    Leaf([i64])
    Node(Tree)
}

fn step(t: Tree) -> Tree {
    match t {
        Node(Leaf(xs)) => {
            let mut ys = xs
            ys[0] = ys[0] + 1
            Tree.Node(Tree.Leaf(ys))
        }
        _ => panic("not a leaf node")
    }
}

fn main() {
    let mut t = Tree.Node(Tree.Leaf([0, 0, 0]))
    for _ in 0..iterations() {
        t = step(t)
    }
    match t {
        Node(Leaf(xs)) => print(xs[0]) // 1000 (0 with no iterations)
        _ => panic("not a leaf node")
    }
}
