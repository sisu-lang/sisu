// GIVEN `struct P { x: i64 }`, `struct Rock {}`, `class C { p: P }`, `struct W` of 33 `i64` fields
// (264 bytes, in memory), and `struct Held { t: Tag }` with a class `Tag` that has a written
// `to_string`
// WHEN `main` shows structs with `print`, `eprint`, an interpolation, `print("{x:#}")`, `dbg`, an
// array, an optional, a class field, an `any Display` and a generic `Display` function
// THEN each form writes `P(x: 1)`, and `Rock()` for no fields; a class shows its fields one level
// deep, a written `to_string` replaces the fields, and the wide struct writes all 33 fields
// AND a struct that is wider than a line breaks under `{x:#}` and `dbg`: one field to a line, and
// a field that is too wide for its line breaks as an array does
struct P { x: i64 }
struct Rock {}
class C { p: P }
struct W {
    f0: i64
    f1: i64
    f2: i64
    f3: i64
    f4: i64
    f5: i64
    f6: i64
    f7: i64
    f8: i64
    f9: i64
    f10: i64
    f11: i64
    f12: i64
    f13: i64
    f14: i64
    f15: i64
    f16: i64
    f17: i64
    f18: i64
    f19: i64
    f20: i64
    f21: i64
    f22: i64
    f23: i64
    f24: i64
    f25: i64
    f26: i64
    f27: i64
    f28: i64
    f29: i64
    f30: i64
    f31: i64
    f32: i64
}
class Tag { id: i64 }
struct Held { t: Tag }
struct Leaf { id: i64; name: string }
enum Kind {
    Big(label: string, size: i64)
    Small
}
struct Long { leaf: Leaf; kind: Kind; xs: [i64]; tail: string }

extend Tag: Display {
    fn to_string(self) -> string {
        "tag-{self.id}"
    }
}

fn show<T: Display>(x: T) {
    print(x)                         // P(x: 1)
}

fn wide() -> W {
    W(f0: 1, f1: 2, f2: 3, f3: 4, f4: 5, f5: 6, f6: 7, f7: 8, f8: 9, f9: 10, f10: 11, f11: 12, f12: 13, f13: 14, f14: 15, f15: 16, f16: 17, f17: 18, f18: 19, f19: 20, f20: 21, f21: 22, f22: 23, f23: 24, f24: 25, f25: 26, f26: 27, f27: 28, f28: 29, f29: 30, f30: 31, f31: 32, f32: 33)
}

fn main() {
    let p = P(x: 1)
    print(p)                         // P(x: 1)
    eprint(p)                        // stderr: P(x: 1)
    print("a {p} b")                 // a P(x: 1) b
    print("{p:#}")                   // P(x: 1)
    let q = dbg(p)
    print(q.x)                       // 1
    print([P(x: 1)])                 // [P(x: 1)]
    print(Some(P(x: 1)))             // P(x: 1): a present optional shows its value
    let c = C(p: P(x: 1))
    dbg(c)
    print(c.p.x)                     // 1
    let a: any Display = P(x: 1)
    print(a)                         // P(x: 1)
    let w: any Display = wide()
    print(w)                         // W(f0: 1, ..., f32: 33)
    show(p)
    dbg(Held(t: Tag(id: 5)))
    print(Kind.Small)                // Small
    print(Rock())                    // Rock()
    print([Rock(), Rock()])          // [Rock(), Rock()]
    dbg(Rock())
    let long = Long(
        leaf: Leaf(id: 1000000, name: "a long name for a leaf"),
        kind: Kind.Big(label: "a long label for a kind", size: 2000000),
        xs: [111111, 222222, 333333, 444444, 555555, 666666, 777777, 888888, 999999, 101010, 121212, 131313],
        tail: "the last field of the long struct"
    )
    print("{long:#}")
    dbg(long)
}

// Nothing calls this function. Its generated `print` reads each field, so no field is W0013.
fn _show(h: Held) {
    print(h)
}
