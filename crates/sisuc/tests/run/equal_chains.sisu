// `== None` and `!= None` test only whether a chain has a head: they compare no field, so they
// call no `eq` and walk no chain, so the fields stay unread. `last` and `first` prepend, so
// `last([3, 2, 1])` is the chain 1 -> 2 -> 3 with head 1.
class Last {
    _value: i64
    _next: Last?
}

class First {
    _next: First?
    _value: i64
}

fn last(values: [i64]) -> Last? {
    let mut head: Last? = None
    for value in values {
        head = Last(_value: value, _next: head)
    }
    head
}

fn first(values: [i64]) -> First? {
    let mut head: First? = None
    for value in values {
        head = First(_next: head, _value: value)
    }
    head
}

fn main() {
    let a = last([3, 2, 1])
    print(a == None) // false: a chain with a head
    print(a != None) // true
    print(None == a) // false: `None` on the left
    print(last([]) == None) // true: no head
    print(last([]) != None) // false

    let b = first([3, 2, 1])
    print(b == None) // false: a chain with a head
    print(b != None) // true
    print(None == b) // false: `None` on the left
    print(first([]) == None) // true: no head
    print(first([]) != None) // false
}
