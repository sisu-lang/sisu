class Bag {
    items: [i64]

    fn upto(self, n: i64) -> [i64] { self.items[..n] }
}

class Holder {
    mut top: [i64]
}

fn make() -> [i64] { [10, 20, 30, 40] }

// GIVEN the base of a range index that is a call, an element, a method's field, a field and a
// range index
// WHEN the program prints each slice, and keeps one past a write to its parent's field
// THEN each prints its elements, and the run is clean under `--rc-checks` and Valgrind: the
// slice keeps the copy or temporary it was taken from, with no leak and no double release
fn main() {
    let xs = [[1, 2, 3], [4, 5, 6]]
    let i = 1
    let bag = Bag(items: [7, 8, 9])
    let h = Holder(top: [1, 2, 3])
    print(make()[..2])               // [10, 20]
    print(xs[i][1..])                // [5, 6]
    print(bag.upto(2))               // [7, 8]
    print(h.top[1..])                // [2, 3]
    let ys = [1, 2, 3, 4, 5]
    print(ys[1..][1..])              // [3, 4, 5]
    let kept = h.top[..2]
    h.top = [9]
    print(kept)                      // [1, 2]
    print(h.top)                     // [9]
}
