// GIVEN `Source`, an interface with an associated type `Item`; `Countdown` that chooses `i64` for
// it in its declaration list; `Words` that chooses the counted `string` in an `extend` block;
// `Relay<S>` that chooses the `Item` of the `Source` it wraps; and generic functions, a class and
// an enum that write `S.Item` as a result, a parameter, a field and a payload; and functions
// whose bound `T: Convert<S.Item>` names the `Item` of the parameter before or after it, or of a chain of such parameters, or of its own parameter
// WHEN they run over a `Countdown`, over a `Words` of strings built at run time and over a
// `Relay` of each, with `pass2` waiting for the `S` of its second argument
// THEN every `S.Item` is the type that the conformance chose, the bounds with `S.Item` hold, and
// the strings that `Words` holds are released once
// o2-calls: main words 5
interface Source {
    type Item
    fn next(self) -> Item?
}

class Countdown: Source {
    type Item = i64
    mut n: i64

    fn next(self) -> Item? {
        if self.n > 0 {
            self.n -= 1
            self.n + 1
        } else {
            None
        }
    }
}

class Words {
    words: [string]
    mut at: i64
}

extend Words: Source {
    type Item = string

    fn next(self) -> Item? {
        if self.at < self.words.len() {
            self.at += 1
            self.words[self.at - 1]
        } else {
            None
        }
    }
}

interface Convert<T> {
    fn convert(self) -> T
}

class Twice: Convert<i64> {
    k: i64

    fn convert(self) -> i64 {
        self.k * 2
    }
}

interface Holds<Y> {
    type Item
    fn held(self) -> Item
}

class Pair2: Holds<i64> {
    type Item = i64
    k: i64

    fn held(self) -> Item {
        self.k
    }
}

class Both: Source, Convert<i64> {
    type Item = i64
    n: i64

    fn next(self) -> Item? {
        None
    }

    fn convert(self) -> i64 {
        self.n
    }
}

class Relay<S: Source> {
    inner: S
}

extend<S: Source> Relay<S>: Source {
    type Item = S.Item

    fn next(self) -> Item? {
        self.inner.next()
    }
}

class Holder<S: Source> {
    item: S.Item

    fn get(self) -> S.Item {
        self.item
    }
}

enum Got<S: Source> {
    Got(S.Item)
    Nothing
}

fn first_of<S: Source>(s: S) -> S.Item? {
    s.next()
}

fn g<S: Source>(s: S) -> S.Item? {
    first_of(s)
}

fn last_of<S: Source>(s: S) -> [S.Item] {
    let mut last: [S.Item] = []
    while let x = s.next() {
        last = [x]
    }
    last
}

fn pass<S: Source>(s: S, x: S.Item) -> S.Item {
    let rest = s.next()
    if rest == None {
        x
    } else {
        x
    }
}

fn pass2<S: Source>(x: S.Item, s: S) -> S.Item {
    let rest = s.next()
    if rest == None {
        x
    } else {
        x
    }
}

fn after<S: Source, T: Convert<S.Item>>(s: S, t: T) -> S.Item? {
    let first = s.next()
    if first == None {
        None
    } else {
        t.convert()
    }
}

fn before<T: Convert<S.Item>, S: Source>(t: T, s: S) -> S.Item {
    s.next() ?? t.convert()
}

fn chain<S: Holds<T.Item>, U: Convert<S.Item>, T: Source>(s: S, t: T, u: U) -> [S.Item] {
    if t.next() == None {
        [s.held()]
    } else {
        [s.held(), u.convert()]
    }
}

fn own<S: Source & Convert<S.Item>>(s: S) -> S.Item {
    s.convert()
}

fn words() -> Words {
    Words(words: ["a" + "b", "c" + "d", "e" + "f"], at: 0)
}

fn main() {
    // Countdown: the items are `i64`s.
    let n: i64? = first_of(Countdown(n: 3))
    print(n ?? 0) // 3
    let m: i64? = g(Relay(inner: Countdown(n: 5)))
    print(m ?? 0) // 5
    print(last_of(Countdown(n: 4))[0]) // 1, the last item of 4, 3, 2, 1
    print(pass(Countdown(n: 1), 40) + pass2(2, Countdown(n: 1))) // 42
    let held: Holder<Countdown> = Holder(item: 7)
    print(held.item + held.get()) // 14
    let got: Got<Countdown> = Got.Got(9)
    match got {
        Got.Got(v) => print(v + 1) // 10
        Got.Nothing => print(0) // not reached
    }
    // A bound that names the `Item` of the parameter before or after it.
    print(after(Countdown(n: 1), Twice(k: 21)) ?? 0) // 42
    print(before(Twice(k: 1), Countdown(n: 8))) // 8
    // A chain of bounds that name the `Item` of a parameter that comes later.
    print(chain(Pair2(k: 5), Countdown(n: 1), Twice(k: 3))[1]) // 6
    // A bound that writes the `Item` of its own parameter, which another bound of it declares.
    print(own(Both(n: 11))) // 11
    // Words: the items are counted `string`s, and each is released once.
    let w: string? = first_of(words())
    print(w ?? "none") // ab
    let r: string? = g(Relay(inner: words()))
    print(r ?? "none") // ab
    let all = last_of(words())
    print(all[0]) // ef, the last item
    print(all.len()) // 1
    print(pass(words(), "x" + "y")) // xy
    print(pass2("p" + "q", words())) // pq
    let kept: Holder<Words> = Holder(item: "h" + "i")
    print(kept.item + kept.get()) // hihi
    let there: Got<Words> = Got.Got("m" + "n")
    match there {
        Got.Got(v) => print(v + "!") // mn!
        Got.Nothing => print("nothing") // not reached
    }
    let nothing: Got<Words> = Got.Nothing
    match nothing {
        Got.Got(v) => print(v) // not reached
        Got.Nothing => print("nothing") // nothing
    }
}
