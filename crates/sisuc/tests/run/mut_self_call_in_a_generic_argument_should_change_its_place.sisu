// GIVEN `struct T { n: i64; fn next(mut self) -> i64 }`, where `next` adds 1 to `n` and gives
// it, `fn id<U>(u: U) -> U` and `let mut t = T(n: 0)`
// AND each `mut self` method takes `depth`, which `main` reads at run time as 1, and the call
// goes `depth` levels down before it changes `self`; the WHEN lines leave `depth` out
// WHEN `main` runs `let o = Some(t.next())`, `print(id(t.next()))` and
// `exchange(mut a, t.next())`, each an argument of a generic call
// THEN each call changes `t`: the results are 1, 2 and 3, and `t.n` is 1, 2 and 3 after each
// AND `before`, a copy of `t` taken before the calls, keeps 0
// o2-calls: main T.next 3
struct T {
    n: i64

    // Recursive, to a depth that `main` reads at run time, so that `-O2` keeps the calls. Only
    // the last level changes `self`.
    fn next(mut self, depth: i64) -> i64 {
        if depth > 0 {
            return self.next(depth - 1)
        }
        self.n += 1
        self.n
    }
}

fn id<U>(u: U) -> U {
    u
}

fn main() {
    let depth = 1 + (read_line() ?? "").len()
    let mut t = T(n: 0)
    let before = t
    let o = Some(t.next(depth))
    print(o ?? 0)                     // 1
    print(t.n)                        // 1
    print(id(t.next(depth)))               // 2
    print(t.n)                        // 2
    let mut a = 0
    let old = exchange(mut a, t.next(depth))
    print(a)                          // 3
    print(old)                        // 0
    print(t.n)                        // 3
    print(before.n)                   // 0
}
