// GIVEN `struct T { n: i64; fn next(mut self) -> i64 }`, where `next` adds 1 to `n` and gives
// it, `fn id<U>(u: U) -> U` and `let mut t = T(n: 0)`
// WHEN `main` runs `let o = Some(t.next())`, `print(id(t.next()))` and
// `exchange(mut a, t.next())`, each an argument of a generic call
// THEN each call changes `t`: the results are 1, 2 and 3, and `t.n` is 1, 2 and 3 after each
// AND `before`, a copy of `t` taken before the calls, keeps 0
// o2-calls: main T.next 3
struct T {
    n: i64

    // Recursive while `n` is below zero, so that `-O2` keeps the calls.
    fn next(mut self) -> i64 {
        if self.n < 0 {
            self.next()
        }
        self.n += 1
        self.n
    }
}

fn id<U>(u: U) -> U {
    u
}

fn main() {
    let mut t = T(n: 0)
    let before = t
    let o = Some(t.next())
    print(o ?? 0)                     // 1
    print(t.n)                        // 1
    print(id(t.next()))               // 2
    print(t.n)                        // 2
    let mut a = 0
    let old = exchange(mut a, t.next())
    print(a)                          // 3
    print(old)                        // 0
    print(t.n)                        // 3
    print(before.n)                   // 0
}
