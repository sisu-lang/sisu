// GIVEN an optional of an optional, and an array of a `None` and that value
// WHEN the program reads the first element
// THEN the `None` is the outer `None` of the element type, not a wrapped inner `None`
fn main() {
    let o: i64?? = Some(None)
    let x = [None, o]
    print(x[0] == None) // true
}
