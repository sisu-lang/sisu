// `==` on two enum values compares depth first. In each variant it compares the fields in
// order and stops at the first difference. Here the mismatch is in an early field. The later
// fields hold two distinct class objects that each point to themselves. `==` on those two
// objects never ends. So an `==` that compared such a field before it found the mismatch
// would hang. The first pair differs in the first field of `Node`, and its second field is the
// last link. The second pair differs in the first field of `Pair`, a link that a class field
// follows.
class C {
    mut next: C?
}

enum E {
    Leaf
    Value(C)
    Node(E, E)
    Pair(E, C)
}

fn main() {
    let a = C(next: None)
    let b = C(next: None)
    a.next = a
    b.next = b
    let x = E.Node(E.Node(E.Leaf, E.Leaf), E.Value(a))
    let y = E.Node(E.Node(E.Node(E.Leaf, E.Leaf), E.Leaf), E.Value(b))
    print(x == y)    // false
    let p = E.Pair(E.Leaf, a)
    let q = E.Pair(E.Pair(E.Leaf, a), b)
    print(p == q)    // false
    a.next = None
    b.next = None
}
