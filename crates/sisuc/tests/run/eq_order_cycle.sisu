// `==` on two enum values compares depth first. In each variant it compares the fields in
// order, except the last field of the enum's own type: it comes after the fields that follow
// it. Both fields of `Node` are of type `E`, so `==` compares them in order. Here the mismatch
// is in the first field. The second fields hold two distinct class objects that each point to
// themselves. `==` on those two objects never ends. So an `==` that compared the second field
// before it found the mismatch would hang.
class C {
    mut next: C?
}

enum E {
    Leaf
    Value(C)
    Node(E, E)
}

fn main() {
    let a = C(next: None)
    let b = C(next: None)
    a.next = a
    b.next = b
    let x = E.Node(E.Node(E.Leaf, E.Leaf), E.Value(a))
    let y = E.Node(E.Node(E.Node(E.Leaf, E.Leaf), E.Leaf), E.Value(b))
    print(x == y)    // false
    a.next = None
    b.next = None
}
