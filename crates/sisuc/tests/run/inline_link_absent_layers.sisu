// GIVEN an enum `Expr` that holds itself inline under two `?`s (`Pair`, through `Both(Expr??,
// Expr??)`) and under three (`Tri`, through `Both(Expr???, Expr???)` and then a scalar), with 256
// variants, so that its tag has no spare value and each `?` is a flag, and the variant after `Lit`
// has no payload, so that a walk which reads a flag as a tag stops at once, and 15 values that
// have `None`, `Some(None)`, `Some(Some(None))` and a value at each layer of the first and the
// second link, two of them with the absent layer deep in a chain of two `Expr`
// WHEN each value is printed, and every value of one list is compared with `==` to every value
// of a second list that has the same values, and both lists are dropped
// THEN the padding has 252 variants, each absent layer prints as `None` under one `Some(` for each
// layer above it, `==` is true for the same value only, which includes the values that differ in
// layer 2 or 3 alone, and every string is released once
enum Two<T> {
    Both(T??, T??)
}

enum Expr {
    Lit(string)
    Nil
    Pair(Two<Expr>)
    Tri(Two<Expr?>, i64)
    Pad0
    Pad1
    Pad2
    Pad3
    Pad4
