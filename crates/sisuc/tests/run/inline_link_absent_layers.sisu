fn main() {
    print(padding().len())
    let xs = values()
    let ys = values()
    for x in xs {
        print(x)
    }
    for i in 0..15 {
        let mut row = ""
        for j in 0..15 {
            row = if xs[i] == ys[j] { "{row}T" } else { "{row}." }
        }
        print(row)
    }
}
