// GIVEN generic functions `id` and `pick`, and integer literals under `dbg`, a block, an `if`, a
//       `match` and a generic call, as the arguments of `Ok` and of `id`
// WHEN each call has a `u8` or `[u8]` context, or a concrete `u8` argument beside the literal
// THEN each literal takes the type of the call, as a bare literal does, and the program prints
//      the value of each line (the comments give them)
// AND a literal does not outrank a concrete argument: `pick(dbg(11), x)` has the type of `x`
// Before, such a literal was checked alone as an `i64` and the call failed (#313).
fn id<T>(x: T) -> T { x }
fn pick<T>(a: T, b: T) -> T { [a, b][0] }

fn show(r: Result<u8, bool>) {
    match r {
        Ok(v) => print("ok {v}")
        Err(e) => print("err {e}")
    }
}

fn main() {
    let c = true
    let x: u8 = 3
    show(Ok(dbg(1))) // ok 1
    show(Ok({ 2 })) // ok 2
    show(Ok(if c { 3 } else { 4 })) // ok 3
    show(Ok(match c {
        true => 5
        false => 6
    })) // ok 5
    let a: Result<[u8], bool> = Ok(dbg([7]))
    match a {
        Ok(v) => print("{v.len()}") // 1
        Err(e) => print("err {e}")
    }
    let b: [u8] = id(dbg([8, 9]))
    print("{b.len()}") // 2
    let d: u8 = id(id(10))
    print("{d}") // 10
    // A literal does not outrank a concrete argument.
    let e: u8 = pick(dbg(11), x)
    print("{e}") // 11
    let f: u8 = pick({ 12 }, x)
    print("{f}") // 12
}
