// Empty arrays: `[]` and `[v; 0]` have length 0, a `for` over one runs no times, and two
// empty arrays are equal. `sum()` of one is 0 and `contains` finds nothing. `[[1]; 0]`
// releases `[1]` once.
class _Node: Eq {
    fn eq(self, other: Self) -> bool { true }
}

fn main() {
    let a: [i64] = []
    print(a.len())          // 0
    for x in a {
        print(x)
    }
    print(a == [])          // true
    print(a.sum())          // 0
    print(a.contains(1))    // false

    let b: [[_Node]] = []
    print(b.len())          // 0
    for x in b {
        print(x.len())
    }
    print(b == [])          // true
    print(b.contains([]))   // false

    let c = [[1]; 0]
    print(c.len())          // 0
    for x in c {
        print(x[0])
    }
    print(c == [[2]; 0])    // true
}
