fn iterations() -> i64 { 1000 }

fn contains_between(xs: [i64], x: i64, lo: i64, hi: i64) -> bool {
    if lo >= hi { return false }
    let mid = lo + (hi - lo) / 2
    if xs[mid] == x { return true }
    if x < xs[mid] { contains_between(xs, x, lo, mid) } else { contains_between(xs, x, mid + 1, hi) }
}

// `slice_search` with `lo` and `hi`: the reference for its allocation count.
fn main() {
    let mut xs = [0; 1000]
    for i in 0..1000 {
        xs[i] = i
    }
    let mut found = 0
    for key in -1..iterations() {
        if contains_between(xs, key, 0, xs.len()) { found += 1 }
    }
    print(found)                     // 1000 (0 with no iterations)
}
