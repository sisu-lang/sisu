fn iterations() -> i64 { 1000 }

// An interpolation with format specs still allocates one block, for its result: the runtime
// formats the `f64` and pads each part in place, inside that block.
fn main() {
    let x = 2.675
    let s = "日本"
    let n = 7
    let mut last = "-"
    for _ in 0..iterations() {
        last = "{x:>8.2}|{s:^5}|{n}"
    }
    print(last)                      // `    2.67| 日本  |7` (- with no iterations)
}
