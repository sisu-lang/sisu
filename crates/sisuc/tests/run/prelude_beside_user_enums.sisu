// GIVEN the user enums `e`, `x`, `total`, `other`, `lo` and `hi`, the names of locals and parameters in the prelude
// WHEN the program calls `contains`, `sum`, `min`, `max` and `clamp`, whose prelude bodies use those names
// THEN each body runs as if the enums were not there, and the program prints the results
enum e {
    A
}

enum x {
    A
}

enum total {
    A
}

enum other {
    A
}

enum lo {
    A
}

enum hi {
    A
}

fn main() {
    // Each enum is built once, so that none is reported as unused.
    let _ = [e.A]
    let _ = [x.A]
    let _ = [total.A]
    let _ = [other.A]
    let _ = [lo.A]
    let _ = [hi.A]
    print([1, 2].contains(2))         // true
    print([1, 2].sum())               // 3
    print([1.5].sum())                // 1.5
    print(3.min(1))                   // 1
    print(3.max(1))                   // 3
    print(5.clamp(1, 2))              // 2
}
