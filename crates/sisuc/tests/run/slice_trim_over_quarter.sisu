fn iterations() -> i64 { 1000 }

class Holder {
    mut top: [i64]
}

// GIVEN a block of 32 elements, 256 bytes, and a slice of its first 9, more than a quarter
// WHEN the program stores it into a field of a class object in each of `iterations()` rounds
// THEN the store keeps the slice in the block of `all`: each round allocates 1 block
fn main() {
    let h = Holder(top: [])
    for i in 0..iterations() {
        let all = [i; 32]
        h.top = all[..9]
    }
    print(h.top.len())               // 9 (0 with no iterations)
}
