// A `match` arm in a loop whose binding is still owned when the arm leaves by `break`,
// `continue` or `return` (mir part 1, Review Focus 3). Each guard prints its binding while the
// binding is borrowed, and no body consumes it, so the commit's copy must be released once on
// each exit, and the scrutinee only at the commit. Valgrind finds a leak if an exit skips the
// binding, and `--rc-checks` finds a release too many. The strings are built at run time.
enum Step {
    Stop(string)
    Skip(string)
    Done(string)
}

// Prints `s` and holds.
fn seen(s: string) -> bool {
    print(s)
    true
}

// One arm `break`s, one `continue`s and one `return`s, each with its binding unused.
fn walk(steps: [Step]) -> i64 {
    let mut n = 0
    for step in steps {
        n += 1
        match step {
            Stop(a) if seen(a) => {
                break
            }
            Skip(b) if seen(b) => {
                continue
            }
            Done(c) if seen(c) => {
                return n
            }
            _ => {
                print("unseen")
            }
        }
    }
    -n
}

fn main() {
    // skip1, then stop2 and the `break`, then -2
    print(walk([Step.Skip("skip" + "1"), Step.Stop("stop" + "2"), Step.Done("never" + "3")]))
    // skip4, then done5 and the `return` of 2
    print(walk([Step.Skip("skip" + "4"), Step.Done("done" + "5"), Step.Stop("never" + "6")]))
}
