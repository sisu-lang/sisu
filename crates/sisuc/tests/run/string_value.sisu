// GIVEN a string built at run time, bound to a second name, passed to a function and stored in
// an array
// WHEN the program appends to the string in each of these places
// THEN each place holds its own text, and the first string keeps its text to the end
// r[verify strings.text.value@1fb8]
// `shout` is recursive, and not in tail position, and `main` calls it from a loop with a depth
// that changes, so `-O2` keeps the call: the string crosses a real call as an argument.
// o2-calls: main shout 1
fn shout(s: string, marks: i64) -> string {
    if marks == 0 {
        return s
    }
    let mut t = shout(s, marks - 1)
    t += "!"
    t
}

fn main() {
    let original = "sau" + "na"
    let mut bound = original
    bound += " 1"
    print(bound)                     // sauna 1
    let mut total = 0
    for i in 0..1000 {
        total += shout(original, i % 5).len()
    }
    print(total)                     // 7000: 1000 times 5 bytes, plus 200 times 0 + 1 + 2 + 3 + 4
    let mut texts = [original]
    texts[0] += " 3"
    print(texts[0])                  // sauna 3
    print(original)                  // sauna: no append changed it
}
