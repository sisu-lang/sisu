// GIVEN a string built at run time that the program binds to a second name, passes to a
// function, and stores in a field and in an array
// WHEN the program appends to the string in each of these places
// THEN each place holds its own text, and the first string keeps its text to the end
// r[verify strings.text.value@1fb8]
class Holder {
    mut text: string
}

fn shout(s: string) -> string {
    let mut t = s
    t += "!"
    t
}

fn main() {
    let original = "sau" + "na"
    let mut bound = original
    bound += " 1"
    print(bound)                     // sauna 1
    print(shout(original))           // sauna!
    let held = Holder(text: original)
    held.text += " 2"
    print(held.text)                 // sauna 2
    let mut texts = [original]
    texts[0] += " 3"
    print(texts[0])                  // sauna 3
    print(original)                  // sauna: no append changed it
}
