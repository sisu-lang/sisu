// A failing enum value that the program owns.
// GIVEN `let Circle(r) = make(i) else { return 0.0 }`, where `make` gives `Named(string)` for
//   some `i`, and `let Label(s) = make(i) else { return 0 }` on the same value
// WHEN the program runs a loop of 100 turns, with `make` giving each variant in turn, under
//   Valgrind
// THEN the else edge releases the owned temporary once, and the pass edge takes the temporary
//   apart or releases it where the let-else commits, so Valgrind reports no leak and no double
//   free
//
// `make` gives an enum that the program owns across a real call. `-O2` inlines `radius` and
// `label` into `main`, and each keeps one call of `make`.
// o2-calls: main make 2
enum Shape {
    Circle(f64)
    Named(string)
    Label(string)
}

fn make(i: i64) -> Shape {
    match i % 3 {
        0 => Shape.Circle(1.5)
        1 => Shape.Named("name {i}")
        _ => Shape.Label("label {i}")
    }
}

fn radius(i: i64) -> f64 {
    let Circle(r) = make(i) else { return 0.0 }
    r
}

fn label(i: i64) -> i64 {
    let Label(s) = make(i) else { return 0 }
    s.len()
}

fn main() {
    let mut r = 0.0
    let mut n = 0
    for i in 0..100 {
        r += radius(i)
        n += label(i)
    }
    print(r) // 51.0: 1.5 for each of the 34 turns on `Circle`
    print(n) // 261: the length of `label {i}` for each of the 33 turns on `Label`
}
