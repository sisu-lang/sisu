// GIVEN arrays and strings, and slices and substrings taken from them without a copy
// WHEN the program takes every form of range, searches, writes, grows and appends to them, and
// leaves loops that hold them
// THEN each result is the one in the comment of its line, and a parent never changes through its
// slice
fn name(i: i64) -> string { "a" + i.to_string() }

fn contains_sorted(xs: [i64], x: i64) -> bool {
    if xs.len() == 0 { return false }
    let mid = xs.len() / 2
    if xs[mid] == x { return true }
    if x < xs[mid] { contains_sorted(xs[..mid], x) } else { contains_sorted(xs[mid + 1..], x) }
}

// A slice of a `[string]` that outlives its parent, and an empty slice of one.
fn tail_of_names() -> [string] {
    let mut all = [name(0)]
    all.push(name(1))
    all.push(name(2))
    all[1..]
}

// An early `return` leaves the loop that holds a slice.
fn first_even_after(xs: [i64], from: i64) -> i64 {
    for i in from..xs.len() {
        let rest = xs[i..]
        if rest[0] % 2 == 0 { return rest[0] }
    }
    -1
}

fn main() {
    // Every range form on an array.
    let xs = [1, 2, 3, 4, 5]
    print(xs[1..3])                  // [2, 3]
    print(xs[1..=3])                 // [2, 3, 4]
    print(xs[2..])                   // [3, 4, 5]
    print(xs[..2])                   // [1, 2]
    print(xs[..=1])                  // [1, 2]

    // The binary search on slices, on an array of 1000 elements.
    let mut big = [0; 1000]
    for i in 0..1000 {
        big[i] = i * 2
    }
    print(contains_sorted(big, 998))     // true
    print(contains_sorted(big, 999))     // false
    print(contains_sorted(big, 1998))    // true
    print(contains_sorted(big, 2000))    // false

    // A write to a slice and a push onto one leave the parent as it was. The write makes `part`
    // unique, so its push is in place. The push onto `tail` is on a slice that still shares the
    // parent's block, so it copies.
    let parent = [1, 2, 3, 4]
    let mut part = parent[..2]
    part[0] = 9
    print(parent)                    // [1, 2, 3, 4]
    print(part)                      // [9, 2]
    part.push(7)
    print(parent)                    // [1, 2, 3, 4]
    print(part)                      // [9, 2, 7]
    let mut tail = parent[..2]
    tail.push(8)
    print(parent)                    // [1, 2, 3, 4]
    print(tail)                      // [1, 2, 8]

    // `first`, `last` and `get` on a full array, on a slice and on an empty array.
    let e: [i64] = []
    print(xs.first() ?? -1)          // 1
    print(xs.last() ?? -1)           // 5
    print(xs.get(4) ?? -1)           // 5
    print(xs.get(5) ?? -1)           // -1
    print(xs[1..3].first() ?? -1)    // 2
    print(xs[1..3].last() ?? -1)     // 3
    print(xs[1..3].get(1) ?? -1)     // 3
    print(xs[1..3].get(2) ?? -1)     // -1
    print(e.first() ?? -1)           // -1
    print(e.last() ?? -1)            // -1
    print(e.get(0) ?? -1)            // -1

    // Every range form on a string, with ASCII and non-ASCII text.
    let s = "häst"
    print(s[0..1])                   // h
    print(s[1..3])                   // ä
    print(s[1..=2])                  // ä
    print(s[3..])                    // st
    print(s[..3])                    // hä
    print(s[..=0])                   // h
    print(s[1..3].len())             // 2
    print(s.get(1..2) ?? "none")     // none
    let plain = "hello"
    print(plain[1..4])               // ell
    print(plain[2..])                // llo

    // A slice of a slice, and a substring of a substring.
    print(xs[1..][1..3])             // [3, 4]
    print(xs[1..4][..2][1..])        // [3]
    print(s[1..][2..])               // st
    print(s[..3][1..])               // ä

    // A slice of a `[string]` that outlives its parent, an empty slice of one, and a push onto a
    // unique slice that does not end at its block's last element.
    print(tail_of_names())           // ["a1", "a2"]
    let none = tail_of_names()[2..]
    print(none.len())                // 0
    let mut grown = [name(0)]
    grown.push(name(1))
    grown.push(name(2))
    let mut head = grown[..1]
    head.push("z")
    print(head)                      // ["a0", "z"]

    // `+=` onto a substring copies it, and the parent keeps its text.
    let mut t = s[..3]
    t += "!"
    print(t)                         // hä!
    print(s)                         // häst

    // Slices taken in a loop that leaves by `continue`, by `break` and by an early `return`.
    let mut sum = 0
    for i in 0..5 {
        let rest = xs[i..]
        if rest[0] == 2 { continue }
        if rest[0] == 5 { break }
        sum += rest.len()
    }
    print(sum)                       // 10: 5 + 3 + 2
    print(first_even_after(xs, 0))   // 2
    print(first_even_after(xs, 4))   // -1
}
