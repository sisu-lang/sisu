// GIVEN a program of nine functions and methods, a class, a generic class, and an `any` value of
// an interface that inherits another
// AND a small function `twice`, which `main` calls
// WHEN the program is built in one codegen unit and in four, and run
// THEN each build prints the lines below, so a split build runs like one module
// AND at `--codegen-units 4`, `twice` is in another unit than `main` (`tests/codegen_units.rs`)
interface Shape {
    fn area(self) -> i64
}

interface Named: Shape {
    fn name(self) -> string
}

class Square: Named {
    side: i64

    fn area(self) -> i64 {
        twice(self.side) + self.side * self.side - self.side
    }

    fn name(self) -> string {
        "square"
    }
}

class Pile<T> {
    mut items: [T]

    fn add(self, x: T) {
        self.items.push(x)
    }

    fn count(self) -> i64 {
        self.items.len()
    }
}

fn twice(n: i64) -> i64 {
    n * 2
}

fn describe(s: any Named) -> string {
    "{s.name()} of area {s.area()}"
}

fn total(shapes: [any Shape]) -> i64 {
    let mut sum = 0
    for s in shapes {
        sum += s.area()
    }
    sum
}

fn collatz(start: i64) -> i64 {
    let mut n = start
    let mut steps = 0
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2
        } else {
            n = 3 * n + 1
        }
        steps += 1
    }
    steps
}

fn main() {
    let sq = Square(side: 3)
    print(describe(sq))                                // square of area 12
    print(total([Square(side: 1), Square(side: 2)]))   // 8
    // An `any Named` converts to its parent `any Shape`, through the table of that parent.
    let named: any Named = Square(side: 4)
    let shape: any Shape = named
    print(total([shape]))                              // 20
    let pile = Pile(items: [10])
    pile.add(20)
    pile.add(30)
    print(pile.count())                                // 3
    print(collatz(27))                                 // 111
    print(twice(21))                                   // 42
}
