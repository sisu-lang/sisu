// GIVEN structs with a string, an array, an optional, an enum, a struct, a class and an array
// of structs as fields. The class has a written `Eq`. One struct also holds an array of itself.
// WHEN `main` compares two values that differ in one field, and two that differ in none
// THEN a difference in any field is `false`, and the same fields are `true`
enum E {
    A(n: i64)
    B
}
struct In { n: i64 }
class Tag {
    id: i64
}
extend Tag: Eq {
    fn eq(self, other: Tag) -> bool {
        self.id % 10 == other.id % 10
    }
}
struct All { s: string; xs: [i64]; o: i64?; e: E; i: In; t: Tag; xl: [In] }
struct Tree { v: i64; kids: [Tree] }

fn make(s: string, xs: [i64], o: i64?, e: E, n: i64, t: i64) -> All {
    return All(s: s, xs: xs, o: o, e: e, i: In(n: n), t: Tag(id: t), xl: [In(n: n)])
}

fn main() {
    let base = make("a", [1, 2], Some(3), E.A(n: 4), 5, 6)
    print(base == make("a", [1, 2], Some(3), E.A(n: 4), 5, 6))   // true
    print(base == make("b", [1, 2], Some(3), E.A(n: 4), 5, 6))   // false
    print(base == make("a", [1, 3], Some(3), E.A(n: 4), 5, 6))   // false
    print(base == make("a", [1, 2], None, E.A(n: 4), 5, 6))      // false
    print(base == make("a", [1, 2], Some(3), E.B, 5, 6))         // false
    print(base == make("a", [1, 2], Some(3), E.A(n: 4), 7, 6))   // false
    print(base == make("a", [1, 2], Some(3), E.A(n: 4), 5, 16))  // true: the written `eq` of `Tag` decides
    print(base == make("a", [1, 2], Some(3), E.A(n: 4), 5, 7))   // false
    let leaf = Tree(v: 2, kids: [])
    print(Tree(v: 1, kids: [leaf]) == Tree(v: 1, kids: [Tree(v: 2, kids: [])]))  // true
    print(Tree(v: 1, kids: [leaf]) == Tree(v: 1, kids: [Tree(v: 3, kids: [])]))  // false
}
