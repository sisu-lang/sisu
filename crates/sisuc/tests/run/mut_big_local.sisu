fn iterations() -> i64 { 1000 }

// GIVEN a loop of `iterations()` calls `set(mut big)` on a `let mut big` of 1 000 000 elements
// WHEN the allocation count of k = 1000 and k = 0 is compared
// THEN the difference is 0: a `mut` local is moved in and out, never copied
// `set` recurses, with depth 1 or 2, so that neither the inliner nor constant propagation across
// functions can fold the call into `main` at `-O2`.
// o2-calls: main set 1
fn set(mut xs: [i64], i: i64, depth: i64) {
    if depth > 0 {
        set(mut xs, i, depth - 1)
    }
    xs[0] = i
}

fn main() {
    let mut big = [0; 1_000_000]
    for i in 0..iterations() {
        set(mut big, i, i % 2 + 1)
    }
    print(big[0]) // the last i: 999 (0 with no iterations)
}
