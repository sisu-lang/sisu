fn main() {
    let mut i = 0
    let mut odd = 0
    while i < 10 {
        i += 1
        if i % 2 == 0 { continue }
        odd += i
    }
    print(odd)
    let mut n = 0
    loop {
        n += 1
        if n * n > 50 { break }
    }
    print(n)
    let mut pairs = 0
    let mut a = 0
    while a < 4 {
        let mut b = 0
        loop {
            if b == a { break }
            pairs += 1
            b += 1
        }
        a += 1
    }
    print(pairs)
    let mut k = 0
    let mut t = 0
    while k < 5 {
        k += 1
        let v = if k == 2 { continue } else { k }
        t += v
    }
    print(t)
    let mut x = 0
    let mut s = 0
    while x < 4 {
        x += 1
        let mut y = 0
        while y < 3 {
            y += 1
            if y == 2 { continue }
            s += 1
        }
        if x == 2 { continue }
        s += 100
        if x == 3 { break }
    }
    print(s)
    print(x)
}
