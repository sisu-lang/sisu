// `is` compares two pointers and follows no field, so `a is a` does not follow the chain
// `a._next = a` forever.
class Node {
    _value: i64
    mut _next: Node?
}

fn main() {
    let a = Node(_value: 1, _next: None)
    a._next = a
    print(a is a) // true: same pointer, so the cycle is not followed
    a._next = None // breaks the cycle, so the object is freed
}
