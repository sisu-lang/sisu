fn iterations() -> i64 { 1000 }

// `names` and its element are each held once, so each `names[0] += "x"` appends in place: one
// copy of the literal, then a reallocation at each doubling to 1024. The array is never copied.
fn main() {
    let mut names = ["a"]
    for _ in 0..iterations() {
        names[0] += "x"
    }
    print(names[0].len())            // 1001 (1 with no iterations)
    let cs = names[0].chars()
    print(cs[cs.len() - 1])          // x (a with no iterations): the last char, read through `chars()`
}
