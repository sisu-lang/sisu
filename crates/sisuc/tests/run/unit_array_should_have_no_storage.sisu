// GIVEN two arrays of `unit`, `xs` and `ys`
// WHEN the program pushes the value of `print("")` 100 000 times into each one
// THEN `xs.len()` is 100000, `xs[99999]` is `()`, and `xs == ys` is true
// AND the arrays hold no bytes for their elements, so Valgrind and `--rc-checks` report no error
fn main() {
    let mut xs: [unit] = []
    let mut ys: [unit] = []
    for _i in 0..100000 {
        xs.push(print(""))
    }
    for _i in 0..100000 {
        ys.push(print(""))
    }
    print(xs.len())     // 100000
    print(xs[99999])    // ()
    print(xs == ys)     // true
}
