// GIVEN `struct W` of 33 `i64` fields, above 256 bytes, so it stays in memory, with the
// `mut self` method `set_last`, which writes its last field
// WHEN `main` calls `set_last` on a `let mut` local and on `ws[0]`
// THEN the last field of each is the new value, and a copy of each taken before keeps 0
// AND the sum of the fields of each is the new value: no other field changes
// o2-calls: main W.set_last 2
struct W {
    f0: i64
    f1: i64
    f2: i64
    f3: i64
    f4: i64
    f5: i64
    f6: i64
    f7: i64
    f8: i64
    f9: i64
    f10: i64
    f11: i64
    f12: i64
    f13: i64
    f14: i64
    f15: i64
    f16: i64
    f17: i64
    f18: i64
    f19: i64
    f20: i64
    f21: i64
    f22: i64
    f23: i64
    f24: i64
    f25: i64
    f26: i64
    f27: i64
    f28: i64
    f29: i64
    f30: i64
    f31: i64
    f32: i64

    // Recursive, and to a depth that `main` reads at run time, so that `-O2` keeps the calls.
    fn set_last(mut self, v: i64, depth: i64) {
        if depth > 0 {
            self.set_last(v, depth - 1)
        }
        self.f32 = v
    }

    fn sum(self) -> i64 {
        self.f0 + self.f1 + self.f2 + self.f3 + self.f4 + self.f5 + self.f6 + self.f7 + self.f8 + self.f9 + self.f10 + self.f11 + self.f12 + self.f13 + self.f14 + self.f15 + self.f16 + self.f17 + self.f18 + self.f19 + self.f20 + self.f21 + self.f22 + self.f23 + self.f24 + self.f25 + self.f26 + self.f27 + self.f28 + self.f29 + self.f30 + self.f31 + self.f32
    }
}

fn zero() -> W {
    W(f0: 0, f1: 0, f2: 0, f3: 0, f4: 0, f5: 0, f6: 0, f7: 0, f8: 0, f9: 0, f10: 0, f11: 0, f12: 0, f13: 0, f14: 0, f15: 0, f16: 0, f17: 0, f18: 0, f19: 0, f20: 0, f21: 0, f22: 0, f23: 0, f24: 0, f25: 0, f26: 0, f27: 0, f28: 0, f29: 0, f30: 0, f31: 0, f32: 0)
}

fn main() {
    let depth = (read_line() ?? "").len()
    let mut w = zero()
    let w_before = w
    w.set_last(7, depth)
    print(w.f32)                      // 7
    print(w_before.f32)               // 0
    print(w.sum())                    // 7
    let mut ws = [zero()]
    let ws_before = ws
    ws[0].set_last(8, depth)
    print(ws[0].f32)                  // 8
    print(ws_before[0].f32)           // 0
    print(ws[0].sum())                // 8
}
