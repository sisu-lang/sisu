// GIVEN `fn split(xs: [i64], mut evens: [i64], mut odds: [i64])` that pushes each element of `xs`
// onto `evens` or `odds`, `let mut e: [i64] = []` and `let mut o: [i64] = []`
// WHEN `main` calls `split([1, 2, 3, 4, 5], mut e, mut o)` and prints `e`, then `o`
// THEN it prints "[2, 4]", then "[1, 3, 5]"
fn split(xs: [i64], mut evens: [i64], mut odds: [i64]) {
    for x in xs {
        if x % 2 == 0 {
            evens.push(x)
        } else {
            odds.push(x)
        }
    }
}

fn main() {
    let mut e: [i64] = []
    let mut o: [i64] = []
    split([1, 2, 3, 4, 5], mut e, mut o)
    print(e)
    print(o)
}
