fn iterations() -> i64 { 1000 }

// `h = step(h)` hands `h` to `step` at its last use, so the `match` owns it. At the commit the
// `match` takes `h` apart, and `xs` moves the array out of it, which `h` held alone: `xs` has
// count 1, so `ys[0]` writes in place and no step copies the array.
enum Holder {
    W([i64])
}

fn step(h: Holder) -> Holder {
    match h {
        W(xs) => {
            let mut ys = xs
            ys[0] = ys[0] + 1
            Holder.W(ys)
        }
    }
}

fn main() {
    let mut h = Holder.W([0, 0, 0])
    for _ in 0..iterations() {
        h = step(h)
    }
    match h {
        W(xs) => print(xs[0]) // 1000 (0 with no iterations)
    }
}
