// GIVEN an enum `U` whose method `log` prints `log`, a function `g` of no result, and `c` true
// WHEN the program binds, passes, prints and compares a `unit` or a `unit?` value, with `o` as
//   `None` and as `Some(U.A)`. It also breaks with a `unit` value
// THEN `log` runs only when `o` holds a value. A `unit?` prints `None` or `()`, and a
//   `unit` prints `()`. Two `unit` values are equal, and neither is less than the other
// AND `dbg` writes each value to stderr
enum U {
    A
    fn log(self) {
        print("log")
    }
}

fn g() {}

fn id<T>(x: T) -> T { x }

fn f() -> unit? { None }

fn rows(o: U?) {
    print(o?.log())                                   // None | log, ()
    let u = { o?.log() }                              // | log
    print(u)                                          // None | ()
    let _ = o?.log()                                  // | log
    print(id(o?.log()))                               // None | log, ()
    print(o?.log() ?? g())                            // () | log, ()
    dbg(o?.log())                                     // | log
}

fn main() {
    let c = true
    rows(None)
    rows(Some(U.A))
    let x: unit? = None
    print(x)              // None
    print(f())            // None
    let y = g()
    let w: unit = y
    print(w)              // ()
    let w2: unit? = y
    print(w2)             // ()
    print(g() < g())      // false
    print(g() <= g())     // true
    print(g() == g())     // true
    print(g() != g())     // false
    let s = Some(g())
    print(s == g())       // true
    dbg(loop { if c { break g() }; break })
}
