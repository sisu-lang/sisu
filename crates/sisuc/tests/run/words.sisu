// `words()`: the runs of characters between white space, each a new string. A no-break space
// separates words; an empty or blank string has none; `?.` gives an optional array. The last
// receivers in `main` are built at run time, so Valgrind checks the receiver's release too:
// `t` is read again after `words()`, so `words()` must leave it alone. `show` keeps the
// `[string]` in a local, so it is built; `s.words().len()` in `main` only counts the words.
// o2-calls: main show 4
// o2-calls: main show_optional 1
// r[verify strings.methods.word@7498]
// r[verify strings.methods.no-words@2acb]
// r[verify strings.methods.optional@dad7]
fn show(s: string) {
    let ws = s.words()
    print("{ws.len()}")           // the word count
    for w in ws {
        print("[{w}]")            // each word, in brackets
    }
}

fn show_optional(s: string?) {
    if let ws = s?.words() {
        print("{ws.len()}")       // the word count
        for w in ws {
            print("[{w}]")        // each word, in brackets
        }
    } else {
        print("none")             // none
    }
}

fn main() {
    show("  one two\tthree  ")     // 3, [one], [two], [three]
    show("")                       // 0
    show("a\u{A0}b")               // 2, [a], [b]
    show(" x" + "y ")              // 1, [xy]
    show_optional("p " + "q")      // 2, [p], [q]
    show_optional(None)            // none
    let n = ("a " + "b").words().len()
    print(n)                       // 2
    let t = "c " + "d"
    print(t.words().len())         // 2
    print(t)                       // c d
    print("".words().len())        // 0
    print(" \t ".words().len())    // 0
    print(("a\u{3000}b" + "\u{2028}häst 😀\u{85}").words().len())   // 4
}
