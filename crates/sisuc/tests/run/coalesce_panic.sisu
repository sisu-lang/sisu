// `??` with `panic` on the right, on both optional shapes: a scalar `i64?` pair and a `string?`
// pointer. The payload is there, so neither panic runs, and Valgrind checks the string's release.
// `_unreached` is compiled but never called: a right side whose branches both return.
fn _unreached(x: i64?, c: bool) {
    let _ = x ?? if c { return } else { return }
}

fn main() {
    let n: i64? = 5
    print(n ?? panic("no n")) // 5
    let s: string? = "a" + "b"
    print(s ?? panic("no s")) // ab
}
