// GIVEN `fn f(mut a: i64, _n: i64, mut b: i64) { a = 3; b = 4 }`,
// `fn change(mut i: i64) -> i64 { i = 1; 0 }`, `let mut xs = [0, 0]` and `let mut i = 0`
// WHEN `main` calls `f(mut xs[i], change(mut i), mut xs[i])` and prints `xs`
// THEN it prints "[3, 4]": each `mut` argument saves its own value of the `let mut` index
fn f(mut a: i64, _n: i64, mut b: i64) {
    a = 3
    b = 4
}

fn change(mut i: i64) -> i64 {
    i = 1
    0
}

fn main() {
    let mut xs = [0, 0]
    let mut i = 0
    f(mut xs[i], change(mut i), mut xs[i])
    print(xs)
}
