// GIVEN enums with no field: one with two variants and a method, one with one variant, and one
//       with 300 variants
// AND `flip`, `grow`, `pick`, `same` and `size_of` take or return such an enum, and recurse to a
//     depth that `main` reads at run time
// WHEN `main` uses them as locals, parameters, results, `mut` arguments, payload fields, class
//      fields, array elements, optionals, results and `any` values, and compares them
// THEN each `print` line shows the value or the result of the comparison
// AND `-O2` keeps the call of each of these functions in `main`, because the compiler cannot know
//     the depth: the markers below check this
// AND `size_of` stays a function of its own at `-O2`, and calls `size` through the `any` table:
//     the last marker checks this
// o2-calls: main flip 1
// o2-calls: main grow 1
// o2-calls: main pick 1
// o2-calls: main same<Kind> 1
// o2-calls: main size_of 1
// o2-indirect-calls: size_of 1
interface Shape {
    fn size(self) -> i64
}

enum Kind: Shape {
    Small
    Large

    fn size(self) -> i64 {
        match self {
            Kind.Small => 1
            Kind.Large => 2
        }
    }
}

enum One: Shape {
    Only

    fn size(self) -> i64 {
        0
    }
}

