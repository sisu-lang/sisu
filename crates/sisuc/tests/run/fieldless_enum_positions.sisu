enum Token {
    Mark(Kind)
    Pair(Kind, i64)
}

enum MaybeKind {
    Nothing
    Just(Kind)
}

class Holder {
    kind: Kind
    mut wide: Wide
}

class Box<T> {
    item: T
}

fn swap(k: Kind) -> Kind {
    match k {
        Kind.Small => Kind.Large
        Kind.Large => Kind.Small
    }
}

// `swap` is its own inverse, so every depth gives `swap(k)`.
fn flip(k: Kind, depth: i64) -> Kind {
    if depth == 0 { swap(k) } else { swap(flip(swap(k), depth - 1)) }
}

// The call comes first, so that `-O2` cannot make it a loop.
fn grow(mut k: Kind, depth: i64) {
    if depth > 0 {
        grow(mut k, depth - 1)
    }
    k = Kind.Large
}

// `!b` gives the other result, and the `match` turns it back.
fn pick(b: bool, depth: i64) -> Result<Kind, string> {
    if depth == 0 {
        if b { Ok(Kind.Small) } else { Err("no") }
    } else {
        match pick(!b, depth - 1) {
            Ok(_) => Err("no")
            Err(_) => Ok(Kind.Small)
        }
    }
}

// `==` is symmetric for these types, so every depth gives `a == b`.
fn same<T: Eq>(a: T, b: T, depth: i64) -> bool {
    if depth == 0 { a == b } else { same(b, a, depth - 1) && a == b }
}

fn size_of(s: any Shape, depth: i64) -> i64 {
    if depth > 1 {
        size_of(s, depth - 1) + size_of(s, depth - 2)
    } else {
        s.size()
    }
}

