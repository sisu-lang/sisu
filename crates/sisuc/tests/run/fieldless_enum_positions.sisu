        Wide.W298,
        Wide.W299,
    ]
    print(all.len())   // 300
    let k = Kind.Small
    print(k)   // Small
    print(flip(k, depth))   // Large
    let mut m = Kind.Small
    grow(mut m, depth)
    print(m)   // Large
    print(k == Kind.Small)   // true
    print(k != Kind.Small)   // false
    print(One.Only == One.Only)   // true
    let w = Wide.W299
    print(w)   // W299
    print(w == Wide.W0)   // false
    let t = Token.Pair(Kind.Large, 7)
    match t {
        Token.Mark(x) => print(x)
        Token.Pair(x, n) => print("{x} {n}")   // Large 7
    }
    print(Token.Mark(Kind.Small) == Token.Mark(Kind.Small))   // true
    let mk = MaybeKind.Just(Kind.Large)
    print(mk)   // Just(Large)
    print(MaybeKind.Nothing == mk)   // false
    let h = Holder(kind: Kind.Large, wide: Wide.W1)
    h.wide = Wide.W2
    print(h.kind)   // Large
    print(h.wide)   // W2
    let b = Box(item: Kind.Small)
    print(b.item)   // Small
    print(same(Kind.Small, Kind.Large, depth))   // false
    print(same(One.Only, One.Only, depth))   // true
    let ks = [Kind.Small, Kind.Large, Kind.Small]
    for x in ks {
        print(x.size())   // 1, 2, 1: one line for each element
    }
    print(ks)   // [Small, Large, Small]
    print(ks == [Kind.Small, Kind.Large, Kind.Small])   // true
    let o: Kind? = Some(Kind.Large)
    let n: Kind? = None
    let oo: Kind?? = Some(None)
    print(o.to_string())   // Large
    print(n.to_string())   // None
    print(oo.to_string())   // Some(None)
    print(o == n)   // false
    print(o ?? Kind.Small)   // Large
    print(oo == Some(None))   // true
    match pick(true, depth) {
        Ok(x) => print(x)   // Small
        Err(e) => print(e)
    }
    // A second type converts to `any Shape` here, so that `-O2` cannot replace the call of `size`.
    let shape: any Shape = if depth == 0 { Kind.Large } else { One.Only }
    print(size_of(shape, depth))   // 2
    print("{k} and {w}")   // Small and W299
    print(k.to_string())   // Small
    let p = true
    let q = 1 > 2
    print(p == q)   // false
    print(p != q)   // true
    print(p == true)   // true
    let bo: bool? = Some(false)
    print(bo == Some(false))   // true
    print(bo != None)   // true
}
