// A `;` stands in for a line break between two things on one line (ADR 0028).
class P { x: i64; y: i64; fn sum(self) -> i64 { self.x + self.y } }

enum E { A; B }

const K = 4; const L = 5

fn pick(e: E) -> i64 { match e { A => 1; B => 2 } }

// `main` is one line, so its values are listed here, in order: 2 (`p.y`), 3 (`p.sum()`),
// 2 (`pick(E.B)`), 9 (`K + L`), 5 (the block) and 1 (`x`).
fn main() { let _ = E.A; let p = P(x: 1, y: 2); print(p.y); print(p.sum()); print(pick(E.B)); print(K + L); print({ let a = 4; a + 1 }); let x = 1; print(x) }
