// Each function is one case. Valgrind checks that every object it makes is freed exactly once.
class P {
    mut x: i64
    mut y: bool
    mut n: i64

    fn bump(self, by: i64) -> i64 {
        self.n += by
        self.x = self.n + self.x
        self.x
    }
}

class E {}

class T {
    mut count: i64
    mut _e: E

    fn me(self) -> T {
        self
    }

    fn reset(self) {
        self._e = E()
    }
}

fn fields_and_methods() {
    let p = P(x: 7, y: true, n: 42)
    print(p.x)
    print(p.y)
    print(p.n)
    p.x = 9
    p.y = false
    print(p.x)
    print(p.y)
    print(p.n)
    print(p.bump(8))
    print(p.x)
    print(p.n)
}

// Review Focus 2: a method that returns `self`, chained and discarded.
fn returns_self() {
    let t = T(count: 3, _e: E())
    print(t.me().me().count)
    let _ = t.me()
    print(t.count)
}

// A `unit` function whose body ends in an object. The unused value warning stays: the tail is
// what codegen releases here, and `let _ =` would make it a statement.
fn ends_in_object() {
    E()
}

// Class-typed values that nothing keeps. The branch and loop tails keep their warnings, as
// `ends_in_object` does.
fn discarded(c: bool) {
    let _ = E()
    let _ = T(count: 1, _e: E())
    let _ = T(count: 2, _e: E()).me()
    ends_in_object()
    if c { E() }
    let mut i = 0
    while i < 3 {
        i += 1
        E()
    }
    print(i)
}

// One object per iteration, dropped at the end of each.
fn in_a_loop() {
    let mut i = 0
    let mut sum = 0
    while i < 5 {
        let t = T(count: i, _e: E())
        sum += t.count
        i += 1
    }
    print(sum)
}

// A field assigned through `self` releases its old object on each call.
fn reset_twice() {
    let t = T(count: 4, _e: E())
    t.reset()
    t.reset()
    print(t.count)
}

fn main() {
    fields_and_methods()
    returns_self()
    discarded(true)
    discarded(false)
    in_a_loop()
    reset_twice()
}
