// Two binary search trees built from the same 10 000 keys are equal, but not the same object.
class Tree: Eq {
    value: i64
    mut left: Tree?
    mut right: Tree?

    fn insert(self, v: i64) {
        if v < self.value {
            if let l = self.left {
                l.insert(v)
            } else {
                self.left = Tree(value: v, left: None, right: None)
            }
        } else {
            if let r = self.right {
                r.insert(v)
            } else {
                self.right = Tree(value: v, left: None, right: None)
            }
        }
    }

    fn eq(self, other: Self) -> bool {
        self.value == other.value && self.left == other.left && self.right == other.right
    }
    fn count(self) -> i64 {
        1 + (self.left?.count() ?? 0) + (self.right?.count() ?? 0)
    }

    fn sum(self) -> i64 {
        self.value + (self.left?.sum() ?? 0) + (self.right?.sum() ?? 0)
    }
}

fn next(x: i64) -> i64 {
    (x * 1103 + 12345) % 100_003
}

// The keys are the values of `x` after each of 10 000 updates from `x = 1`; the first is the root.
fn build() -> Tree {
    let mut x = next(1)
    let t = Tree(value: x, left: None, right: None)
    let mut i = 1
    while i < 10_000 {
        x = next(x)
        t.insert(x)
        i += 1
    }
    t
}

fn main() {
    let t1 = build()
    let t2 = build()
    print(t1.count())
    print(t1.sum())
    print(t1 == t2)
    print(t1 is t2)
}
