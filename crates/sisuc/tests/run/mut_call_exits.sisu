// GIVEN `fn bump(mut xs: [i64], n: i64)` that pushes `n`, and callers, one a method, that put
// `o ?? return`, `o ?? continue` and `o ?? break` in the other argument of a `mut` call
// WHEN each caller runs with `o` empty and with a value
// THEN an empty `o` leaves through the `return`, `continue` or `break` before the copy-in, with no
// call, and the final value of the caller's own `mut` parameter reaches its caller
// AND a value runs the call, and a borrowed field argument `c.items` beside a `mut` local works
class Putter {
    fn put(self, mut xs: [i64], n: i64) {
        xs.push(n)
    }
}

class Items {
    mut items: [i64]
}

fn bump(mut xs: [i64], n: i64) {
    xs.push(n)
}

fn early(mut xs: [i64], o: i64?) {
    bump(mut xs, o ?? return)
    xs.push(100)
}

fn by_method(p: Putter, mut xs: [i64], o: i64?) {
    p.put(mut xs, o ?? return)
    xs.push(200)
}

fn put<T>(mut xs: [T], x: T) {
    xs.push(x)
}

fn generic(mut xs: [i64], o: i64?) {
    put(mut xs, o ?? return)
    xs.push(300)
}

fn safe(p: Putter?, mut xs: [i64], o: i64?) {
    p?.put(mut xs, o ?? return)
    xs.push(400)
}

fn first(mut ys: [i64], n: i64) -> i64 {
    ys.push(n)
    n
}

fn nested(mut xs: [i64], mut ys: [i64], o: i64?) {
    bump(mut xs, first(mut ys, o ?? return))
    xs.push(500)
}

fn skipping(mut xs: [i64], items: [i64?]) {
    for o in items {
        bump(mut xs, o ?? continue)
    }
}

fn stopping(mut xs: [i64], items: [i64?]) {
    for o in items {
        bump(mut xs, o ?? break)
    }
}

fn show(items: [i64], mut xs: [i64]) {
    xs.push(items.len())
}

fn main() {
    let mut xs: [i64] = []
    early(mut xs, None)
    print(xs)
    early(mut xs, 5)
    print(xs)
    let mut ys: [i64] = []
    skipping(mut ys, [1, None, 3])
    print(ys)
    let mut zs: [i64] = []
    stopping(mut zs, [1, None, 3])
    print(zs)
    let mut ms: [i64] = []
    by_method(Putter(), mut ms, None)
    by_method(Putter(), mut ms, 6)
    print(ms)
    let mut gs: [i64] = []
    generic(mut gs, None)
    generic(mut gs, 8)
    safe(Putter(), mut gs, None)
    safe(Putter(), mut gs, 9)
    safe(None, mut gs, 10)
    print(gs)
    let mut ns: [i64] = []
    let mut os: [i64] = []
    nested(mut ns, mut os, None)
    nested(mut ns, mut os, 11)
    print("{ns} {os}")
    let c = Items(items: [4, 5])
    let mut ws: [i64] = []
    show(c.items, mut ws)
    print(ws)
}
