// A `bool` fill stores one byte per slot; the loads must read back what it stored.
fn filled(b: bool, n: i64) -> [bool] {
    [b; n]
}

fn main() {
    let yes = [true; 5]
    let no = [false; 5]
    print(yes[0])              // true
    print(yes[4])              // true
    print(no[0])               // false
    print(no[4])               // false
    let n = 3
    let by_value = filled(n > 2, n)
    let other = filled(n > 3, n)
    print(by_value[0])         // true
    print(by_value[2])         // true
    print(other[0])            // false
    print(other[2])            // false
    print(by_value.len())      // 3
    print(filled(true, 0).len()) // 0
}
