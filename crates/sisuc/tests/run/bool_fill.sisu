// args: a b c
// A `bool` fill stores one byte per slot; the loads must read back what it stored. The
// length and the filler come from `args`, so that `-O2` cannot fold them to constants.
fn filled(b: bool, n: i64) -> [bool] {
    [b; n]
}

fn main(args: [string]) {
    let yes = [true; 5]
    let no = [false; 5]
    print(yes[0])              // true
    print(yes[4])              // true
    print(no[0])               // false
    print(no[4])               // false
    let n = args.len()         // 3
    let set = filled(n > 2, n)
    let clear = filled(n < 2, n)
    print(set[0])              // true
    print(set[2])              // true
    print(clear[0])            // false
    print(clear[2])            // false
    print(set.len())           // 3
    print(filled(n > 2, n - 3).len()) // 0
}
