// GIVEN a loop `a` of type `unit?`, with a bare `break a` two loops inside it
// WHEN that bare `break a` ends the loop `a`
// THEN the value of `a` is a wrapped `unit`, so it prints `()`
fn main() {
    let c = false
    let o: unit? = None
    let v = a: loop {
        b: loop {
            loop { if c { break b }; if c { break a o }; break a }
        }
    }
    print(v.to_string())    // ()
}
