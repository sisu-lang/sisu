// GIVEN generic functions whose type parameters have bounds, called at two conforming classes
// that each hold a counted `string`, and a class with a body method, a method in a `Label` block
// and one in a `Code` block, all named `name`
// WHEN each function calls the requirements of its bounds, an inherited bound, two bounds at
// once, a diamond of inherited bounds and a function that passes its own parameter on
// THEN every call runs the method of the type it is called for, each of the three names of the
// circle shows, and every string is released once
// args: a b
interface Named {
    fn name(self) -> string
}

interface Shape: Named {
    fn area(self) -> f64
}

interface Same {
    fn same(self, other: Self) -> bool
}

interface Ord2: Same {
    fn less(self, other: Self) -> bool
}

interface Keep {
    fn keep<U>(self, x: U) -> U
}

interface Label {
    fn name(self) -> string
}

interface Code {
    fn name(self) -> string
}

interface Base {
    fn base(self) -> string
}

interface Left: Base {}

interface Right: Base {}

interface Both: Left, Right {}

// The body holds a `name`, which meets `Named`, and the blocks below hold two more.
class Circle: Shape, Same, Ord2, Keep, Both {
    tag: string
    r: f64

    fn name(self) -> string {
        "circle {self.tag}"
    }

    fn area(self) -> f64 {
        self.r * self.r
    }

    fn same(self, other: Circle) -> bool {
        self.r == other.r
    }

    fn less(self, other: Circle) -> bool {
        self.r < other.r
    }

    fn keep<V>(self, x: V) -> V {
        x
    }

    fn base(self) -> string {
        "base of {self.tag}"
    }
}

extend Circle: Label {
    fn name(self) -> string {
        "label of {self.tag}"
    }
}

extend Circle: Code {
    fn name(self) -> string {
        "code of {self.tag}"
    }
}

class Square {
    tag: string
    side: f64
}

extend Square: Named {
    fn name(self) -> string {
        "square {self.tag}"
    }
}

extend Square: Shape {
    fn area(self) -> f64 {
        // `self` is bound to a local first, so this method owns it.
        let s = self
        s.side * s.side
    }
}

extend Square: Same {
    fn same(self, other: Square) -> bool {
        self.side == other.side
    }
}

class Sorted<T: Same> {
    items: [T]
}

fn total<T: Shape>(xs: [T]) -> f64 {
    let mut sum = 0.0
    for x in xs {
        sum += x.area()
    }
    sum
}

fn both<T: Shape & Same>(a: T, b: T) -> bool {
    a.same(b) && a.area() > 0.0
}

fn named<T: Shape>(x: T) -> string {
    x.name()
}

fn base_of<T: Both>(x: T) -> string {
    x.base()
}

fn equal<T: Same>(x: T, y: T) -> bool {
    x.same(y)
}

// It passes its parameter on to a function whose bound it meets through `Ord2: Same`.
fn smaller<T: Ord2>(x: T, y: T) -> bool {
    x.less(y) && !equal(x, y)
}

fn count<T: Same>(s: Sorted<T>) -> i64 {
    s.items.len()
}

fn kept<T: Keep>(x: T) -> string {
    let n: i64 = x.keep(7)
    let s = x.keep("kept")
    "{s} {n}"
}

fn label_of<T: Label>(x: T) -> string {
    x.name()
}

fn code_of<T: Code>(x: T) -> string {
    x.name()
}

fn main(args: [string]) {
    let c = Circle(tag: "c", r: 2.0)
    let d = Circle(tag: "d", r: 3.0)
    let s = Square(tag: "s", side: 1.5)
    print(total([c, d]))                  // 13.0
    print(total([s]))                     // 2.25
    print(both(c, d))                     // false
    print(named(c))                       // circle c
    print(named(s))                       // square s
    print(base_of(d))                     // base of d
    print(smaller(c, d))                  // true
    print(smaller(d, c))                  // false
    print(equal(s, Square(tag: "t", side: 1.5)))  // true
    print(count(Sorted(items: [c, d, c])))        // 3
    print(count(Sorted(items: [s])))              // 1
    print(kept(c))                        // kept 7
    print(c.name())                       // circle c
    print(label_of(c))                    // label of c
    print(code_of(c))                     // code of c
    print(args.len())                     // 2
}
