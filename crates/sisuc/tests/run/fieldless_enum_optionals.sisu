class Box<T> {
    item: T
}

// The result of the call is `f`, so `r == None` holds only when `f` is `None`. `-O2` cannot know
// this, so it keeps the call.
fn pass_full(f: Full?, depth: i64) -> Full? {
    if depth == 0 {
        f
    } else {
        let r = pass_full(f, depth - 1)
        if r == None { f } else { r }
    }
}

