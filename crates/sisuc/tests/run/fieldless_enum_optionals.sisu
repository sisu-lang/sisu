    print(w ?? Wide.W0)   // W299
    print(wn ?? Wide.W7)   // W7
    let f: Full? = Some(Full.F255)
    let fn2: Full? = None
    print(pass_full(f, depth).to_string())   // F255
    print(pass_full(fn2, depth).to_string())   // None
    print(f == fn2)   // false
    print(f == Some(Full.F255))   // true
    print(f != Some(Full.F0))   // true
    print(Box(item: One.Only).item)   // Only
    print([One.Only, One.Only])   // [Only, Only]
    print([One.Only] == [One.Only])   // true
    let wo: [Wide?] = [None, Some(Wide.W1)]
    print(wo)   // [None, W1]
    print(wo == [None, Some(Wide.W1)])   // true
}
