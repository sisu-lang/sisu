// Arrays: literals, `[v; n]`, reads, `len`, `==`, shared objects, `for`, drops and evaluation
// order. Valgrind checks that every block is freed exactly once on every path.
class Node: Eq {
    mut v: i64
    fn eq(self, other: Self) -> bool { self.v == other.v }
}

fn side(x: i64) -> i64 {
    print(x)
    x
}

fn count(n: i64) -> i64 {
    print(n)
    n
}

// `[1]` is bound to a local before the element that can return runs.
fn literal_exit(c: bool) -> i64 {
    let g = [[1], if c { return 0 } else { [2] }]
    g.len()
}

fn fill_exit(c: bool) -> i64 {
    let g = [[1]; if c { return 0 } else { 3 }]
    g.len()
}

// `d`, its inner arrays and their references to `a` are released when `deep` returns.
fn deep(a: Node) {
    let d: [[Node?]] = [[a, None], [None], [a]]
    print(d[2][0] == a)               // true
}

fn main() {
    let ints = [10, 20, 30]
    print(ints[0] + ints[2])          // 40
    let bytes: [u8] = [1, 255]
    print(bytes[1])                   // 255
    let flags = [true, false]
    print(flags[1])                   // false
    let maybe = [None, 5]
    print(maybe[1] ?? 0)              // 5
    print(maybe[0] == None)           // true
    let a = Node(v: 1)
    let nodes = [a, Node(v: 7)]
    print(nodes[1].v)                 // 7
    let optional_nodes: [Node?] = [None, a, Node(v: 3)]
    let grid = [[1, 2], [3, 4, 5]]
    print(grid[1][2])                 // 5
    print(grid.len() + grid[1].len()) // 5

    let zeros = [0; 4]
    print(zeros[3] + zeros.len())     // 4
    let rows = [[1]; 3]
    print(rows[2][0] + rows.len())    // 4
    let nones: [Node?] = [None; 2]
    print(nones[1] == None)           // true

    let none: [i64]? = None
    print(none?.len() == None)        // true
    let some: [i64]? = ints
    print(some?.len() ?? 0)           // 3

    print([[1, 2], [3]] == [[1, 2], [3]]) // true
    print([[1, 2], [3]] == [[1, 2], [4]]) // false
    print([[1], [2]] == [[1]])        // false
    print([Node(v: 1)] == [Node(v: 1)]) // true

    // Both arrays hold the same object.
    let first = [a]
    let second = [a]
    first[0].v = 2
    print(second[0].v)                // 2

    for n in optional_nodes {
        if let n = n {
            print(n.v)                // 2, then 3
        }
    }
    for i in 0..10 {
        if i == 1 { continue }
        if i == 4 { break }
        print(i)                      // 0, 2, 3
    }
    for i in 3..3 {
        print(i)                      // never runs: the range is empty
    }
    print(-1)                         // -1
    deep(a)

    let order = [side(1); count(2)]   // 1, then 2
    print(order.len())                // 2
    let listed = [side(3), side(4)]   // 3, then 4
    print(listed.len())               // 2
    print(literal_exit(true))         // 0
    print(literal_exit(false))        // 2
    print(fill_exit(true))            // 0
    print(fill_exit(false))           // 3
}
