// GIVEN `class Item { mut cells: [i64] }`, `class Crate { mut items: [Item] }`,
// `fn f(mut cells: [i64], n: i64) { cells.push(n) }` and `fn g() -> i64` that prints "g ran"
// AND `let o = Crate(items: [])`
// WHEN `main` calls `f(mut o.items[5].cells, g())`
// THEN it prints "g ran", then panics with "index 5 out of bounds for length 0" at the index `5` of
// the argument: the objects along the place are read after the other arguments
class Item {
    mut cells: [i64]
}

class Crate {
    mut items: [Item]
}

fn f(mut cells: [i64], n: i64) {
    cells.push(n)
}

fn g() -> i64 {
    print("g ran")
    0
}

fn main() {
    let o = Crate(items: [])
    f(mut o.items[5].cells, g())
}
