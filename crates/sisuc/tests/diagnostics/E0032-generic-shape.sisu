class Box<A> {
    value: A
}

interface Shape {
    fn area(self) -> i64
}

fn id<X>(x: X) -> X {
    x
}

fn h<U: Shape>(a: U, b: [U]) -> i64 {
    1
}

fn k<U>(a: U, b: Box<U>) -> i64 {
    2
}

fn e<U>(a: U, b: Result<U, string>) -> i64 {
    3
}

fn main() {
    print(h(5, id(true)))
    print(k(5, id(true)))
    print(e(5, id(true)))
}
