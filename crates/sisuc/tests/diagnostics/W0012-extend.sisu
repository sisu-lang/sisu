interface Shape {
    fn area(self) -> f64
}

class Crate<T> {
    item: T
}

extend<T: Shape> Crate<T> {
    fn one(self) -> f64 {
        self.item.area()
    }

    fn two(self) -> f64 {
        self.item.area() * 2.0
    }
}

class Spare<T> {
    item: T
}

extend<T: Shape> Spare<T> {
    fn one(self) -> f64 {
        self.item.area()
    }
}

class Plain {
    n: i64
}

extend Plain {
    fn grow(self) -> i64 {
        self.n + 1
    }
}

fn stale(p: Plain) -> i64 {
    p.grow()
}

fn main() {
    let c = Crate(item: 1)
    print("{c.item}")
    print("{Plain(n: 1).n}")
}
