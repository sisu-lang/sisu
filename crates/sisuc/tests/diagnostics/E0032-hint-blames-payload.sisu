fn id<T>(x: T) -> T {
    x
}

fn first<T>(xs: [T]) -> T {
    xs[0]
}

fn equal_to_first() {
    let b: u8 = 1
    let ys = [1]
    print(b == first(ys))
}

fn if_with_first() {
    let b: u8 = 1
    let c = true
    let ys = [1]
    print(if c { b } else { first(ys) })
}

fn coalesce_with_first() {
    let o: u8? = None
    let ys = [1]
    print(o ?? first(ys))
}

fn written_optional_first() {
    let ys = [1]
    let x: u8? = first(ys)
    print(x)
}

fn equal_to_loop() {
    let v: u8 = 7
    let x = v == id(loop { break 1 })
    print(x)
}

fn written_optional_loop() {
    let x: u8? = id(loop { break 1 })
    print(x)
}

fn not_equal_to_first() {
    let v: u8 = 7
    let ys = [1]
    let x = v != first(ys)
    print(x)
}

fn match_arm_first() {
    let v: u8 = 7
    let k = 1
    let ys = [1]
    let x = match k { 0 => v; _ => first(ys) }
    print(x)
}

fn not_equal_to_loop() {
    let v: u8 = 7
    let x = v != id(loop { break 1 })
    print(x)
}

fn equal_to_nested_first() {
    let v: u8 = 7
    let ys = [1]
    let x = v == first(first([ys]))
    print(x)
}

fn equal_to_wrapped_first() {
    let v: u8 = 7
    let ys = [1]
    let x = v == id(first(ys))
    print(x)
}

fn coalesce_with_wrapped_loop() {
    let o: u8? = None
    let x = o ?? id(id(loop { break 1 }))
    print(x)
}

fn equal_to_sum_loop() {
    let v: u8 = 7
    let x = v == id(1 + loop { break 1 })
    print(x)
}

fn mut_marker_missing() {
    let v: u8 = 7
    let ys = [1]
    let x = v == first(mut ys)
    print(x)
}

fn optional_argument_under_written_optional() {
    let o: u8? = None
    let x: i64? = id(o)
    print(x)
}

fn optional_element_in_array_argument() {
    let q = 5
    let x: u8? = first([q, None])
    print(x)
}

fn optional_argument_beside_sibling() {
    let o: u8? = None
    let q = 5
    let x = q == id(o)
    print(x)
}

fn plain_argument_under_written_optional() {
    let v: u8 = 7
    let x: i64? = id(v)
    print(x)
}

fn pick<T>(a: T, bs: [T?]) -> T {
    a
}

fn one_of_two_arguments_holds_optional() {
    let v: u8 = 7
    let ao: [u8?] = [None]
    let x: i64? = pick(v, ao)
    print(x)
}

fn enum_argument_holds_optional() {
    let rr: Result<u8?, bool> = Ok(None)
    let x: i64? = id(rr)
    print(x)
}

fn main() {}
