extend i64 {
    fn twice(self) -> i64 { self * 2 }
}

extend f64 {
    fn half(self) -> f64 { self / 2.0 }
}

extend string {
    fn shout(self) -> string { self }
}

extend bool {
    fn flip(self) -> bool { !self }
}

extend [i64] {
    fn second(self) -> i64 { 0 }
}

extend<T> T {
    fn same(self) -> bool { true }
}

interface Source {
    type Item
    fn next(self) -> Item?
}

class Wrap<S> {
    value: S
}

extend<S: Source> Wrap<S.Item> {
    fn size(self) -> i64 { 1 }
}

fn main() {
    print(5.twice())
    print(1.5.half())
    print("a".shout())
    print(true.flip())
    print([1].second())
    print(true.same())
    print(Wrap(value: 1).size())
    // An optional receiver keeps its own error, and an argument keeps its errors.
    let maybe: i64? = 5
    print(maybe.twice())
    print(5.twice(missing))
}
