// GIVEN `enum Only { One(i64) }` and a `main` whose line 11 is `let One(n) = zz`, with no name `zz`
// WHEN `sisu check` runs on it
// THEN it reports E0174 at 11:9 with the label "`One(n)` may not match", because the value has no type
// AND it reports E0033 at 11:18
// AND it reports no other diagnostic
enum Only {
    One(i64)
}

fn main() {
    let One(n) = zz
    print(n)
}
