fn id<T>(x: T) -> T {
    x
}

fn first<T>(xs: [T]) -> T {
    xs[0]
}

fn pick<T>(a: T, b: T) -> T {
    a
}

fn takes(_n: i64) {}

struct Pair<A, B> {
    a: A
    b: B
}

fn mk<A, B>(a: A, b: B) -> Pair<A, B> {
    Pair(a: a, b: b)
}

fn main() {
    let n = 5
    let a: string = id(n)
    let r: Result<i64, string> = Ok("x")
    // An array argument under a written type that it does not fit: the report names the closed
    // type of the array, with each open literal at its default.
    let c = [1].len() == 2
    let x: i64 = id([1, 2])
    let y: string = id(["a", "b"])
    takes(id([1, 2]))
    let d: i64 = first([[1], [2]])
    let e: i64 = pick([1], [2])
    let f: [i64] = id([[1, 2]])
    let g: i64 = id([None, Some(1)])
    let p: Pair<u8, string> = mk([1], "s")
    let h: i64? = id(Some([1]))
    let i: i64 = id(if c { [1] } else { ["s"] })
    let j: i64 = id([1, Some(2)])
    let k: i64 = id([1; 3])
    let m: i64 = id(Some([1]))
    // Elements that conflict with each other: they report, as with no written type.
    let l: i64 = id([1, "s"])
}
