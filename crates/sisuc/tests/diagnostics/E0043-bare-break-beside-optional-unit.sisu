enum U {
    A
    fn log(self) {
        print("log")
    }
}

fn main() {
    let o: U? = Some(U.A)
    let c = [1].len() == 1
    loop { if c { break o?.log() }; break }
    outer: loop { loop { if c { break outer o?.log() }; break outer } }
    outer: loop { loop { if c { break outer o?.log() }; break }; break outer }
    let x = loop { if c { break o?.log() }; break }
    print(x)
    let n: unit? = None
    let v = a: loop { b: loop { loop { if c { break b }; if c { break a n }; break a } } }
    print(v)
}
