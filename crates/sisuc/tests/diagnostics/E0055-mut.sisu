// GIVEN `set(mut n: xs)`, where `set` is a function
// WHEN `sisu check` runs on it
// THEN it reports E0055 on the label and nothing else
// AND there is no E0166 and no E0167 for the argument
fn set(mut xs: [i64]) {
    xs[0] = 9
}

fn main() {
    let xs = [1, 2]
    set(mut n: xs)
    print(xs)
}
