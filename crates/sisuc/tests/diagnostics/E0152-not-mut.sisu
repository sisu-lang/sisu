// GIVEN a requirement whose parameter `xs` is not `mut`
// WHEN a conformance spells the parameter `mut`
// THEN it reports E0152 on the method, with the note that the requirement's parameter is not `mut`
// AND it does not warn W0002 on `xs`: the error already names its `mut`
interface Filler {
    fn fill(self, xs: [i64])
}

class Nines: Filler {
    n: i64

    fn fill(self, mut xs: [i64]) {
        print(xs)
    }
}

fn main() {
    print(Nines(n: 9).n)
}
