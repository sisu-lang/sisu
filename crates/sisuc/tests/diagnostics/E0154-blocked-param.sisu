interface Seq {
    type Item
    fn first(self) -> Item
}

class Pair<A> {
    a: A
}

extend<A: Eq> Pair<A>: Eq {
    fn eq(self, other: Pair<A>) -> bool {
        self.a == other.a
    }
}

class Held<A> {
    a: A
}

extend<A: AnyObject> Held<A>: Eq {
    fn eq(self, other: Held<A>) -> bool {
        self.a is other.a
    }
}

fn plain<T>(x: Pair<T>) -> bool {
    [x].contains(x)
}

fn shown<T: Display>(x: Pair<T>) -> bool {
    [x].contains(x)
}

fn item<S: Seq>(x: Pair<S.Item>) -> bool {
    [x].contains(x)
}

fn held<T>(x: Held<T>) -> bool {
    [x].contains(x)
}

fn main() {}
