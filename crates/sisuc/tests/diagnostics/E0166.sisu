// GIVEN `set(xs)`, where `xs` is a `let mut` local and the parameter of `set` is `mut`
// WHEN `sisu check` runs on it
// THEN it reports E0166 on the argument, with the secondary label on the parameter
// AND the safe fix adds `mut`
fn set(mut xs: [i64]) {
    xs[0] = 9
}

fn main() {
    let mut xs = [1, 2]
    set(xs)
    print(xs)
}
