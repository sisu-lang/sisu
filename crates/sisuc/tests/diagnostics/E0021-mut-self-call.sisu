// GIVEN a struct method that takes `mut self`
// AND a call of it on the value that a function returns
// WHEN `sisu check` runs on it
// THEN it is E0021 at the receiver: the change has no place to go
struct Point {
    x: i64
    y: i64

    fn move_by(mut self, dx: i64, dy: i64) {
        self.x += dx
        self.y += dy
    }
}

fn origin() -> Point {
    Point(x: 0, y: 0)
}

fn main() {
    origin().move_by(1, 1)
}
