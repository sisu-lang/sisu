// GIVEN `fn u() {}`, which returns `unit`
// WHEN a comparison has `u()` on one side and a join on the other side: an `if`, a `match`, a
//     `loop`, `dbg`, `Some`, or a chain of comparisons
// THEN `sisu check` reports E0043 at each `u()`, as it does for `1 < u()`, and no other error
// AND the reports start at 11:39, 17:32, 22:17, 31:10, 40:13, 46:37, 52:43, 57:34, 63:42, 69:53 and
//     75:43
fn u() {}

fn if_on_the_left() {
    let c = [1].len() == 1
    let a = (if c { 1 } else { 2 }) < u()
    print(a)
}

fn unit_in_a_branch() {
    let c = [1].len() == 1
    let a = (if c { 1 } else { u() }) < u()
    print(a)
}

fn plain_number() {
    let a = 1 < u()
    print(a)
}

fn match_on_the_left() {
    let c = [1].len() == 1
    let a = (match c {
        true => 1
        false => 2
    }) < u()
    let z = if c { u() } else { u() }
    let b = z < u()
    print(a)
    print(b)
}

fn if_on_the_right() {
    let c = [1].len() == 1
    let a = u() < (if c { 1 } else { 2 })
    print(a)
}

fn if_without_parentheses() {
    let c = [1].len() == 1
    let a = if c { 1 } else { 2 } < u()
    print(a)
}

fn comparison_chain() {
    let c = [1].len() == 1
    let a = 1 < (if c { 1 } else { 2 }) < u()
    print(a)
}

fn loop_on_the_left() {
    let a = (loop { break 1 }) < u()
    print(a)
}

fn dbg_of_an_if() {
    let c = [1].len() == 1
    let a = dbg(if c { 1 } else { 2 }) < u()
    print(a)
}

fn if_let_on_the_left() {
    let o: i64? = Some(1)
    let a = (if let Some(v) = o { v } else { 2 }) < u()
    print(a)
}

fn some_of_an_if() {
    let c = [1].len() == 1
    let a = Some(if c { 1 } else { 2 }) < u()
    print(a)
}

fn main() {
    if_on_the_left()
    unit_in_a_branch()
    plain_number()
    match_on_the_left()
    if_on_the_right()
    if_without_parentheses()
    comparison_chain()
    loop_on_the_left()
    dbg_of_an_if()
    if_let_on_the_left()
    some_of_an_if()
}
