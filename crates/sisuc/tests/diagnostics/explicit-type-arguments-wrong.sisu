// A call with written type arguments gets only the errors of its count and of its types. The
// wrong number of arguments is E0053, and the wrong number of types is E0137. A type that does
// not exist is E0030. A written type that breaks a bound is not reported again. An alias of a
// missing type does not hide the error of its use.
interface Conv<U> {
    fn conv(self) -> U
}

interface Source {
    type Item
    fn next(self) -> Item?
}

struct S: Conv<i64> {
    fn conv(self) -> i64 { 1 }
}

type A = i64
type Bad = Nope

fn two<T, U>(a: T, _b: U) -> T { a }
fn f<T: Conv<U>, U>(a: T, _b: U) -> U { a.conv() }
fn g<T: Conv<i64>, U>(a: T, _b: U) -> i64 { a.conv() }
fn k<T: Conv<R.Item>, R: Source>(t: T, _r: R) -> i64 { 1 }

fn main() {
    let a = f<S>(S(), 2, 3)
    let b = g<S>(S(), 2, 3)
    let c = g<Nope, i64>(S(), 2, 3)
    let d = g<S, i64>(S())
    let e = k<S, i64>(S())
    let h = two<A, A>(1, 2, 3)
    let i = Bad.m(1)
}
