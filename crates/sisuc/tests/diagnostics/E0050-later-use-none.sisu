fn take(p: [char]) -> i64 { p.len() }

fn handle<T>(p: [T]) -> i64 { p.len() }

fn wants_optional(p: i64?) -> i64 { 0 }

fn first<T>(p: [T], q: T) -> T { q }

fn failed_push() {
    let mut failed = []
    failed.push(nope)
    print(failed.len())
}

fn failed_assign() {
    let mut best = None
    best = nope
    print(best ?? "")
}

fn new_local() {
    let again = []
    let again = ["a"]
    print(again.len())
}

fn failed_shadow() {
    let shadow = []
    let shadow = nope
    print(take(shadow))
}

fn open_parameter() {
    let open = []
    print(handle(open))
}

fn open_argument() {
    let beside = []
    print(first(beside, 'a'))
}

fn pushed_never() {
    let mut never_pushed = []
    never_pushed.push(panic("x"))
    print(never_pushed.len())
}

fn pushed_unit() {
    let mut unit_pushed = []
    unit_pushed.push(print(1))
    print(unit_pushed.len())
}

fn assigned_never() {
    let mut stopped = None
    stopped = panic("x")
    print(stopped ?? 0)
}

fn assigned_failed_typed() {
    let c = true
    let mut mixed = None
    mixed = if c { 1 } else { nope }
    print(mixed ?? 0)
}

fn index_write() {
    let mut indexed = []
    indexed[0] = 'a'
    print(indexed.len())
}

fn else_initializer() {
    let Some(v) = None else { return }
    print(v)
}

fn else_scrutinee() {
    let scrutinee = None
    let Some(v) = scrutinee else { return }
    print(v)
}

fn optional_for_array() {
    let wrong = []
    print(wants_optional(wrong))
}

fn unknown_target() {
    let waits = None
    nowhere = 1
}

fn other_target() {
    let mut count = 1
    let left = None
    count = 2
    print(count)
}

fn scalar_for_array() {
    let mut hold = []
    hold = 'x'
}

fn none_pushed() {
    let mut nothing = None
    nothing.push(1)
}

fn rolled_back() {
    let early = []
    let n: u8 = "a" + if true {
        let inner = []
        "b"
    } else {
        "c"
    }
}

