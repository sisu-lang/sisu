// GIVEN a call `set(mut xs[1..3])`, whose `mut` argument is a range index
// WHEN `sisu check` runs on it
// THEN it reports E0169 on the argument, labelled "a range index gives a new array, not a place"
fn set(mut xs: [i64]) {
    xs[0] = 9
}

fn main() {
    let mut xs = [1, 2, 3, 4]
    set(mut xs[1..3])
    print(xs)
}
