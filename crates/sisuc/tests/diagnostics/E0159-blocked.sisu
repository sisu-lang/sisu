interface Shape {
    fn area(self) -> f64
}

class Node {
    v: i64
}

class Pair<A> {
    a: A
}

extend<A: Eq> Pair<A>: Eq {
    fn eq(self, other: Pair<A>) -> bool {
        self.a == other.a
    }
}

extend<A: Ord> Pair<A>: Ord {
    fn less(self, other: Pair<A>) -> bool {
        self.a < other.a
    }
}

enum Outer {
    Has(Pair<Node>)
}

enum Chain {
    Cons(Pair<Chain>)
    Leaf(Node)
}

fn equal() {
    print(Pair(a: Node(v: 1)) == Pair(a: Node(v: 1)))
}

fn unequal() {
    print(Pair(a: Node(v: 1)) != Pair(a: Node(v: 1)))
    let o: Pair<Node>? = None
    print(o == o)
}

fn ordered() {
    print(Pair(a: Node(v: 1)) < Pair(a: Node(v: 1)))
    print(Pair(a: true) < Pair(a: true))
}

fn arrays() {
    print([Pair(a: Node(v: 1))] == [Pair(a: Node(v: 1))])
}

fn holder() {
    print(Outer.Has(Pair(a: Node(v: 1))) == Outer.Has(Pair(a: Node(v: 1))))
}

fn no_help(x: Pair<any Shape>, y: Pair<bool>) -> bool {
    x == x || y < y
}

fn cycle() {
    print(Pair(a: Chain.Leaf(Node(v: 1))) == Pair(a: Chain.Leaf(Node(v: 1))))
}

fn main() {
    equal()
    unequal()
    ordered()
    arrays()
    holder()
    cycle()
}

interface Conv<T> {
    fn conv(self) -> T
}

interface Seq {
    type Item
    fn first(self) -> Item
}

class P<A> {
    a: A
}

extend<A: Conv<i64>> P<A>: Eq {
    fn eq(self, other: P<A>) -> bool {
        true
    }
}

extend<A: Conv<i64>> P<A>: Ord {
    fn less(self, other: P<A>) -> bool {
        true
    }
}

fn unwritable_equal<T>(x: P<T>) -> bool {
    x == x
}

fn unwritable_less<T>(x: P<T>) -> bool {
    x < x
}

fn unwritable_optional<T>(x: P<T>?) -> bool {
    x == x
}

fn unwritable_assoc<S: Seq>(x: P<S.Item>) -> bool {
    x == x
}

class Two<A, B> {
    a: A
    b: B
}

extend<A: Eq, B: Ord> Two<A, B>: Eq {
    fn eq(self, other: Two<A, B>) -> bool {
        true
    }
}

class Q<A> {
    a: A
}

extend<A: Eq & Conv<i64>> Q<A>: Eq {
    fn eq(self, other: Q<A>) -> bool {
        true
    }
}

class R<A> {
    a: A
}

extend<A: Eq & Ord> R<A>: Eq {
    fn eq(self, other: R<A>) -> bool {
        true
    }
}

class Same2<A, B> {
    a: A
    b: B
}

extend<A: Eq, B: Eq> Same2<A, B>: Eq {
    fn eq(self, other: Same2<A, B>) -> bool {
        true
    }
}

fn two_param_and_concrete<T>(x: Two<T, bool>) -> bool {
    x == x
}

fn two_param_and_class<T>(x: Two<T, Node>) -> bool {
    x == x
}

fn two_concrete(x: Two<Node, bool>) -> bool {
    x == x
}

fn two_params<T, U>(x: Two<T, U>) -> bool {
    x == x
}

fn two_same_param<T>(x: Two<T, T>) -> bool {
    x == x
}

fn two_bounds_one_param<T>(x: Q<T>) -> bool {
    x == x
}

fn two_interfaces_one_param<T>(x: R<T>) -> bool {
    x == x
}

fn two_inside_pair<T>(x: Pair<Two<T, bool>>) -> bool {
    x == x
}

fn two_optional<T>(x: Two<T, bool>?) -> bool {
    x == x
}

fn one_fails_param<T>(x: Two<T, i64>) -> bool {
    x == x
}

fn one_fails_class(x: Two<Node, i64>) -> bool {
    x == x
}

fn same_fix_param<T>(x: Same2<T, T>) -> bool {
    x == x
}

fn same_fix_optional<T>(x: Same2<T, T?>) -> bool {
    x == x
}

fn same_fix_class(x: Same2<Node, Node>) -> bool {
    x == x
}
