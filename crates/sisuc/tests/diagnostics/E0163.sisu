class C7<T> { a: C6<[T]>; b: C6<T?> }
class C8<T> { a: C7<[T]>; b: C7<T?> }
class C9<T> { a: C8<[T]>; b: C8<T?> }
class C10<T> { a: C9<[T]>; b: C9<T?> }
class C11<T> { a: C10<[T]>; b: C10<T?> }
class C12<T> { a: C11<[T]>; b: C11<T?> }
class C13<T> { a: C12<[T]>; b: C12<T?> }
class C14<T> { a: C13<[T]>; b: C13<T?> }
class C15<T> { a: C14<[T]>; b: C14<T?> }
