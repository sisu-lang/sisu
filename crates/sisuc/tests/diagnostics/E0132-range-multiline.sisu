fn f(a: i64) -> i64 {
    a
}

fn start_exclusive() {
    for i in f(
        1)..<5 {
        print(i)
    }
}

fn start_ellipsis() {
    for i in f(
        1)...5 {
        print(i)
    }
}

fn end_exclusive() {
    for i in 0..<f(
        5) {
        print(i)
    }
}

fn end_ellipsis() {
    for i in 0...f(
        5) {
        print(i)
    }
}

fn in_an_index() {
    let xs = [1, 2, 3]
    print(xs[f(
        0)..<2])
}

fn with_a_comment() {
    let r = f( // c
        1)..<3
}

fn main() {
}
