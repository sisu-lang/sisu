// GIVEN a range pattern in another language's form that has no start: `..<5` and `...5`
// AND the same in a sub-pattern with an end, `E.P(x, ...5)`, or with no end, `E.P(x, ..<)`
// WHEN `sisu check` runs on it
// THEN it reports E0132 at 8:9 and 15:9, and at 22:16 and 29:16
// AND the message writes the missing start as `start`
fn exclusive(n: i64) {
    match n {
        ..<5 => print(1)
        _ => print(2)
    }
}

fn ellipsis(n: i64) {
    match n {
        ...5 => print(1)
        _ => print(2)
    }
}

fn ellipsis_in_a_sub_pattern(e: E) {
    match e {
        E.P(x, ...5) => print(x)
        _ => print(2)
    }
}

fn exclusive_with_no_end_in_a_sub_pattern(e: E) {
    match e {
        E.P(x, ..<) => print(x)
        _ => print(2)
    }
}

enum E {
    P(x: i64, y: i64)
}

fn main() {}
