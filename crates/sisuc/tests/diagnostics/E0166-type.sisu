// GIVEN `set(xs)`, where `xs` is a `let mut` `[string]` and the parameter of `set` is a `mut` `[i64]`
// WHEN `sisu check` runs on it
// THEN it reports E0166 on the argument and nothing else
// AND there is no fix and no help: `mut xs` would be E0170
fn set(mut xs: [i64]) {
    xs[0] = 9
}

fn main() {
    let mut xs = ["a"]
    set(xs)
    print(xs)
}
