    let z = id(mk2()) + o
    let w: string = z
}
fn pair_of_calls_minus_bool(b: bool) { let z = pair(id(mk2()), id(mk2())) - b }

// Guards: a leader that is a written type, a literal first, or the concrete twin. A literal first does not decide a sum with a failed right, so the `- b` after it waits.
fn bool_minus_call(b: bool) { let z = b - id(mk2()) }
fn call_plus_u8(x: u8) { let z = id(mk2()) + x }
fn call_plus_optional_string(o: string?) { let z = id(mk2()) + o }
