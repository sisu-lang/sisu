fn block_nope_then_literal_then_u8(x: u8) { let z = { let q = 1 == id(mk2()); nope } + 1 + x }

// A block statement that keeps an E0050 does not make the value of the block fail. A branch makes its join untyped.
// A call of such a block has a failed part, so its result waits.
fn call_of_block_then_string() {
    let z = id({
        let q = 1 == id(mk2())
        5
    })
    let w: string = z
}
fn block_plus_literal_then_string() {
    let z = {
        let q = 1 == id(mk2())
        5
    } + 1
    let w: string = z
}
fn coalesce_block_then_string(o: i64?) {
    let z = o ?? {
        let q = 1 == id(mk2())
        nope
    }
    let w: string = z
}
fn call_of_block_plus_literal_then_string() {
    let z = id({
        let q = 1 == id(mk2())
        5
    }) + 1
    let w: string = z
}
fn match_on_sum_plus_literal_then_string() {
    let z = match id(mk2()) + id(mk2()) { _ => 1 } + 1
    let w: string = z
}
fn match_on_equal_plus_literal_then_string() {
    let z = match 1 == id(mk2()) { _ => 1 } + 1
    let w: string = z
}
fn call_of_match_then_string() {
    let z = id(match 1 == id(mk2()) { _ => 1 })
    let w: string = z
}
fn method_of_block_then_string(k: K) {
    let z = k.g({ let q = 1 == id(mk2()); 5 })
    let w: string = z
}
fn coalesce_block_sum_then_string(o: i64?) {
    let z = o ?? ({ let q = 1 == id(mk2()); nope } + 1)
    let w: string = z
}
fn branch_with_sum_plus_literal_then_string(c: bool) {
    let z = (if c { id(mk2()) + 1 } else { 2 }) + 1
    let w: string = z
}

// A sum with a call gives a plain E0032. A block that kept an E0050 is a failed part: it waits.
fn pair_with_sum_then_string(x: u8) {
    let z = pair(id(mk2()) + 1, x)
    let w: string = z
}
fn pair_with_block_then_string(x: u8) {
    let z = pair({ let q = 1 == id(mk2()); x }, x)
    let w: string = z
}

// Guards: the concrete twin gives these outputs too. A literal left does not decide a sum with a failed right, so its `string` waits.
fn compare_call_array_compare() { let z = mk2() < [] < 2 }
fn compare_call_none() { let z = mk2() < None }
fn coalesce_concrete_call_then_string(o: i64?) {
    let z = o ?? mk2()
    let w: string = z
}
fn literal_first_call_then_string() {
    let z = 1 + id(mk2())
    let w: string = z
}

// Only a value that kept its E0050 is kept. A value that failed with its own report is not kept,
// and the operator treats it, or a `-` of it, as any untyped operand: the call is held to no type.
fn snd<T, U>(a: T, b: T) -> U { panic("no") }
fn join_of_failures_then_call(c: bool) { let z = (if c { nope } else { nope }) + id(mk2()) }
fn coalesce_join_of_failures_then_string(c: bool, o: i64?) {
    let z = o ?? (if c { nope } else { nope })
    let w: string = z
}
fn negated_failure_then_call() { let z = -nope + id(mk2()) }

// A call fails on an unbound parameter. A sum with a call gives a plain E0032, with no cascade.
fn coalesce_pair_with_sum_then_string(o: i64?) {
    let z = o ?? pair(id(mk2()) + 1, nope)
    let w: string = z
}
fn pair_with_sum_then_call() { let z = pair(id(mk2()) + 1, nope) + id(mk2()) }

// A type from a sibling is a type, not the hint: a `u8` left decides the sum, so its E0032 stays.
// A sum with a call in it, beside a `u8`, gives a plain E0032, as its concrete twin does.
fn u8_plus_call_of_sum_then_string(x: u8) {
    let z = x + id(id(mk2()) + 1)
    let w: string = z
}
fn result_from_hint_then_string(x: u8) {
    let z = snd(id(mk2()) + 1, x) + 1
    let w: string = z
}

// A leader that the operator does not take is reported against the operator's list. The call
// beside it keeps its E0050, because the operator's `i64` is a hint to it, not a written type.
enum E {
    A
    B
}
fn call_minus_bool(b: bool) { let z = id(mk2()) - b }
fn call_times_class(k: K) { let z = id(mk2()) * k }
fn call_plus_array(xs: [i64]) { let z = id(mk2()) + xs }
fn call_plus_array_literal() { let z = id(mk2()) + [1] }
fn call_plus_some() { let z = id(mk2()) + Some(1) }
fn call_plus_bool_then_string(b: bool) {
    let z = id(mk2()) + b
    let w: string = z
}
fn call_minus_bool_minus_literal(b: bool) { let z = id(mk2()) - b - 1 }
fn call_minus_bool_minus_call(b: bool) { let z = id(mk2()) - b - id(mk2()) }
fn call_plus_optional_i64(o: i64?) { let z = id(mk2()) + o }
fn call_plus_optional_u8(o: u8?) { let z = id(mk2()) + o }
fn call_times_optional_f64(o: f64?) { let z = id(mk2()) * o }
