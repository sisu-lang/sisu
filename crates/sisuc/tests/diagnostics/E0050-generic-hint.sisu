fn nested_call_sum_then_u8(x: u8) { let z = id(id(mk2()) + 1) + x }
fn field_of_sum_then_call() { let z = (id(mk2()) + id(mk2())).a + id(mk2()) }
fn field_of_sum_then_literal_then_call() {
    let z = (id(mk2()) + id(mk2())).a + 1 + id(mk2())
}
fn product_of_calls_then_remainder(x: u8) { let z = (id(mk2()) * id(mk2())) % x }
fn difference_of_calls_then_less(x: u8) { let z = (id(mk2()) - id(mk2())) < x }
fn negated_sum_then_u8(x: u8) { let z = -(id(mk2()) + id(mk2())) + x }
fn three_calls_then_u8(x: u8) { let z = id(mk2()) + id(mk2()) + id(mk2()) + x }
fn method_call_sum_then_u8(k: K, x: u8) { let z = (k.g(id(mk2())) + 1) + x }
fn branch_sums_then_u8(c: bool, x: u8) {
    let z = (if c { id(mk2()) + 1 } else { id(mk2()) + 1 }) + x
}
fn block_value_sum_then_u8(x: u8) { let z = { id(mk2()) + 1 } + x }
fn block_statement_sum_then_u8(x: u8) {
    let z = { let q = id(mk2()) + 1; id(mk2()) + 1 } + x
}

// A comparison is a `bool` whatever its operands are, so a use of it reports its own mistake.
fn call_less_then_string() {
    let z = id(mk2()) < 3
    let w: string = z
}
fn concrete_call_less_then_string() {
    let z = mk2() < 3
    let w: string = z
}
