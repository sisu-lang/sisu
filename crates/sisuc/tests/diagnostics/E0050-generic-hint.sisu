fn block_less_then_string() {
    let z = { let q = 1 == id(mk2()); 5 } < 3
    let w: string = z
}
fn block_less_then_u8(x: u8) { let z = { let q = 1 == id(mk2()); nope } < x }
fn block_times_u8(x: u8) { let z = { let q = 1 == id(mk2()); nope } * x }
