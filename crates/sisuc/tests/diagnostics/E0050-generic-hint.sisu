fn mk2<X>() -> Two<X, bool> { panic("no") }
fn id<V>(v: V) -> V { v }

class Two<A, B> {
    a: A
    b: B
}

fn main() {
    print(1 == id(mk2()))
    print(id(mk2()) == 1)
    print(1 == id(id(mk2())))
    let o: i64? = None
    print(o ?? id(id(mk2())))
    let c = true
    print(if c { 1 } else { id(id(mk2())) })
}

// A default `i64` that an operator takes is no one's written type: a call beside it keeps its
// E0050, and the sum is `Error`.
fn add_calls() { let z = id(mk2()) + id(mk2()) }
