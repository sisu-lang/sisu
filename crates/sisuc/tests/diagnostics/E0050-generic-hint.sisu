    let w: string = z
}

// Guards: a type that the user wrote holds the call to it. So does a sum that has one, or an
// integer literal first, as in the concrete twin. A branch that keeps an E0050 makes its join untyped.
fn written_i64() { let z: i64 = id(mk2()) + id(mk2()) }
fn literal_first() { let z = 1 + id(mk2()) }
fn chain_literal_first() { let z = 0 < id(mk2()) < 10 }
fn written_u8() { let z: u8 = id(mk2()) + id(mk2()) }
fn add_assign_i64() {
    let mut n = 0
    n += id(mk2())
}
fn add_assign_u8() {
    let mut n: u8 = 0
    n += id(mk2())
}
fn string_literal_after() { let z = id(mk2()) + "a" }
fn f64_literal_after() { let z = id(mk2()) * 2.5 }
fn call_after_i64_call() { let z = id(1) + id(mk2()) }
fn call_after_f64_literal() { let z = 1.5 + id(mk2()) }
fn equal_then_string() {
    let z = 1 == id(mk2())
    let w: string = z
}
fn branch_then_string(c: bool) {
    let z = if c { 1 } else { id(mk2()) }
    let w: string = z
}
fn typed_sum_first(x: i64) { let z = (x + 1) + id(mk2()) }

// A value is kept only by its own E0050. An E0050 beside it, in a block statement or an earlier
// operand, does not make the value fail. The default `i64` of an operator is no one's type.
fn pair<T>(a: T, b: T) -> T { a }
class K {
    fn g<T>(self, t: T) -> T { t }
}

// An operand that kept its E0050 is not held to `i64`; the operands after it are not either.
fn field_of_sum_then_u8(x: u8) { let z = (id(mk2()) + id(mk2())).a + x }
fn match_on_sum_then_u8(x: u8) { let z = match id(mk2()) + id(mk2()) { _ => nope } + x }
fn call_compare_array() { let z = id(mk2()) < [] }
fn call_add_array() { let z = id(mk2()) + [] }
fn call_add_none() { let z = id(mk2()) + None }
fn two_calls_add_array() { let z = id(mk2()) + id(mk2()) + [] }
fn sum_of_calls_then_u8(x: u8) { let z = (id(mk2()) + id(mk2())) + x }
fn sum_of_calls_then_bool(b: bool) { let z = (id(mk2()) + id(mk2())) + b }
fn sum_with_literal_then_bool() { let z = (id(mk2()) + 1) + true }
fn flat_sum_with_literal_then_bool() { let z = id(mk2()) + 1 + true }
fn block_sum_then_u8(x: u8) { let z = { id(mk2()) + id(mk2()) } + x }
fn flat_sum_of_calls_then_u8(x: u8) { let z = id(mk2()) + id(mk2()) + x }
