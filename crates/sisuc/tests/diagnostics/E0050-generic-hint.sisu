// `-` of a value that kept its E0050 keeps it, as an operator does. The code that uses it adds
// no report for the default `i64`.
fn block_negated_sum_then_u8(x: u8) { let z = { -(id(mk2()) + 1) } + x }
fn branch_negated_sums_then_u8(c: bool, x: u8) {
    let z = (if c { -(id(mk2()) + 1) } else { -(id(mk2()) + 1) }) + x
}
fn call_of_negated_sum_then_u8(x: u8) { let z = id(-(id(mk2()) + 1)) + x }
fn negated_sum_then_u8_binding() {
    let z = -(id(mk2()) + 1)
    let w: u8 = z
}
fn negated_sum_then_string() {
    let z = -(id(mk2()) + 1)
    let w: string = z
}

// A `string` leader under `-` or `%` gets the operator's list error, and the call keeps its E0050.
// A `string?` leader gets the list error alone, as in its twin `mk2() - o`.
fn call_minus_string(s: string) { let z = id(mk2()) - s }
fn call_remainder_string(s: string) { let z = id(mk2()) % s }
fn call_minus_optional_string(o: string?) { let z = id(mk2()) - o }

// A `char` beside a value that kept its E0050 is still rejected, on either side, and a `char`
// beside a plain call has the one E0094. A comparison with a `char` is no sum.
fn negated_sum_plus_char(c: char) { let z = -(id(mk2()) + 1) + c }
fn char_plus_negated_sum(c: char) { let z = c + -(id(mk2()) + 1) }
fn parenthesised_sum_plus_char(c: char) { let z = (id(mk2()) + 1) + c }
fn call_plus_char(c: char) { let z = id(mk2()) + c }
fn negated_sum_less_char(c: char) { let z = -(id(mk2()) + 1) < c }
