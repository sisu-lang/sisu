// GIVEN `set(ys)`, where `ys` is a `let` local and the parameter of `set` is `mut`
// WHEN `sisu check` runs on it
// THEN it reports E0166 on the argument, with the help to declare `ys` with `let mut` and pass `mut ys`
// AND there is no fix
fn set(mut xs: [i64]) {
    xs[0] = 9
}

fn main() {
    let ys = [1, 2]
    set(ys)
    print(ys)
}
