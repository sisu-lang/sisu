    fn get(self, n: i64) -> T { self.v }
    fn n(self, k: i64) -> i64 { k }
    fn mk<U: Eq>(self, u: U) -> T { self.v }
}
class Cat: Named {
    fn name(self) -> string { "cat" }
}
enum Opt {
    Wrap([string])
    Nope
}
