fn hb<T: Eq>(t: T) -> [string] { [] }
fn ge<T: Eq>(n: T) -> T { n }
fn h<T: Eq>(n: T) -> [string] { [] }
fn h2<T>(t: T) -> [string] { [] }
fn k() -> [string] { [] }
fn u() {}

