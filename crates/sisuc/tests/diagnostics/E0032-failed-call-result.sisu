// GIVEN a call that fails, as the value of an annotated `let`, a condition, a `match`, a `??`
// or the receiver of a method, in a function for each case
// AND the callee fixes its result type: a function, a method, a method of a generic class, an
// interface requirement, a constructor, a variant, a built-in method or a prelude function
// WHEN `sisu check` runs on it
// THEN it reports the call's own error, and the mismatch of the result type with its context
// AND a callee whose result an argument decides (`gen`, `Option.Some`, `dbg`, `get`, `i64(x, 1)`),
// and a call that fails its block bound, report no mismatch
//
// GIVEN a call whose count is wrong, and that gives a bound to its own type parameter, or a
// written type argument list that fails
// WHEN `sisu check` runs on it
// THEN it reports the count, and the list when the list fails, and no mismatch: the corrected call
// is `Error` when a bound fails or its list fails, and it has no type when the bound has no list
// AND a bound that holds, with a written list, keeps the type that the list fixes
//
// GIVEN a built-in method or a prelude function with a label or an argument that fails
// WHEN `sisu check` runs on it
// THEN it reports the mismatch of its result type, and the error of the label or of the argument
//
// GIVEN a generic class or variant whose written list, or alias, fixes its type, and that fails
// on its fields, its labels or its count
// WHEN `sisu check` runs on it
// THEN it reports the mismatch of that type
// AND when a bound of the list fails, or the list fails, it reports no mismatch
class Node {
    v: i64
    fn ys(self, n: i64) -> [string] { [] }
}
extend Node {
    fn zs(self, n: i64) -> [string] { [] }
}
