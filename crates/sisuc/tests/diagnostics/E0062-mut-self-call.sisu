// GIVEN a struct method and an enum method that take `mut self`
// AND a call of each through `?.` and through `.` on an optional value
// WHEN `sisu check` runs on it
// THEN each `?.` call is E0062 from the `?.` to the method name
// AND each `.` call is E0062 at the receiver
// AND each error has the help that replaces the value, as a field write has
struct Point {
    x: i64
    y: i64

    fn move_by(mut self, dx: i64, dy: i64) {
        self.x += dx
        self.y += dy
    }
}

enum Dir {
    North
    South

    fn flip(mut self) {
        self = Dir.South
    }
}

fn main() {
    let mut p: Point? = Some(Point(x: 1, y: 2))
    p?.move_by(1, 1)
    let mut d: Dir? = Some(Dir.North)
    d?.flip()
    p.move_by(1, 1)
    d.flip()
}
