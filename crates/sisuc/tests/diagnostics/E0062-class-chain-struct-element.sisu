struct S {
    n: i64
}

type Id = i64

struct H {
    k: i64
    xs: [S]
    id: Id
}

class C {
    mut xs: [S]
    mut s: H
}

struct W {
    s: H
}

fn get() -> C? {
    None
}

fn f(mut k: i64) {
    k += 1
}

fn main() {
    let c: C? = C(xs: [S(n: 1)], s: H(k: 1, xs: [], id: 1))
    c?.xs[0].n = 2
    c?.s.k = 2
    c?.s.xs[0].n = 2
    f(mut c?.s.k)
    c?.s.id = "x"
    get(
    )?.xs[0].n = 2
    let mut w: W? = W(s: H(k: 1, xs: [], id: 1))
    w?.s.k = 2
}
