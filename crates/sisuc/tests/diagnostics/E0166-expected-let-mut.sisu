// GIVEN `let s: string = gget(ys)`, where `ys` is a `let mut` `[i64]` and `gget` has a `mut` `T`
// WHEN `sisu check` runs on it
// THEN it reports E0166 on `ys`; the E0032 of the result waits, because the call has a failed part
// AND the E0166 has no help: adding `mut` would leave that E0032
fn gget<T>(mut x: T) -> T {
    let y = x
    x = y
    y
}

fn main() {
    let mut ys = [1]
    let s: string = gget(ys)
    ys[0] = 2
    print(s)
}
