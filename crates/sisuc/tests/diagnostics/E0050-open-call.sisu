// A call that waits with a parameter left open reports that parameter, as on `main`: the type
// of a `None` is no part of it. A `None` literal reports its own type.
struct Two<A, B> {
    a: A
    b: B
}
interface Source {
    type Item
}
fn mk2<X>() -> Two<X, bool> { panic("no") }
fn id<V>(v: V) -> V { v }
fn first<T>(xs: [T]) -> T? { None }
fn put<S: Source>(v: S.Item) -> S? { None }

fn element() { let w = [id(mk2())] }
fn branch(c: bool) { let w = if c { id(mk2()) } else { id(mk2()) } }
fn elements() { let w = [id(mk2()), id(mk2())] }
fn compare() { print(mk2() < mk2()) }
fn coalesce(u: u8) -> i64? { first([]) ?? u }
fn associated() { let w = [put(true)] }

// Guards: a `None` literal keeps its own text.
fn none_element() { let w = [None] }
fn none_branch(c: bool) { let w = if c { None } else { None } }

fn main() {}
