// GIVEN `set(b.cells)`, where the field `cells` is not `mut` and the parameter of `set` is `mut`
// WHEN `sisu check` runs on it
// THEN it reports E0166 on the argument, with the help to declare the field `cells` as `mut` and pass it `mut`
// AND there is no fix
class Board {
    cells: [i64]
}

fn set(mut xs: [i64]) {
    xs[0] = 9
}

fn main() {
    let b = Board(cells: [1, 2])
    set(b.cells)
    print(b.cells)
}
