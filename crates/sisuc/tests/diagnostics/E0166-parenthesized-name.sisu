// GIVEN `bump((x))`, where `x` is declared with `let` and the parameter of `bump` is `mut`
// WHEN `sisu check` runs on it
// THEN it reports E0166 on the argument
// AND the help names the variable `x`, not the parenthesized text
fn bump(mut n: i64) {
    n += 1
}

fn main() {
    let x = 1
    bump((x))
    print(x)
}
