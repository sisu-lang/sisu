// GIVEN a function that returns an optional whose body ends in an `if` without an `else` whose
//   branch gives `unit` or never finishes
// WHEN `sisu check` runs on it
// THEN it reports E0031 at the closing `}` of the function
// AND a label at the `if` says that it has no value, as an `if` without an `else` has none where
//   an optional is expected
// AND E0043 says the same where a `let`, a generic parameter, an optional array, a join or an
//   `==` expects an optional
fn g() {}

fn k<T>(x: T, y: T?) {}

fn m<T>(xs: [T]) {}

fn f(c: bool) -> i64? {
    if c { g() }
}

fn b(c: bool) -> unit? {
    if c { return None }
}

fn main() {
    let c = true
    let y: i64? = if c { g() }
    print(y ?? f(c) ?? 0)
    let _ = b(c)
    let d = false
    let o: i64? = None
    k(1, if c { g() })
    let e = [Some(1), if c { g() }]
    m([o, if c { g() }])
    let x = if d { o } else { if c { g() } }
    print(o == if c { g() })
    let w = if d { if c { g() } } else { o }
    print(if c { g() } == o)
    let a1 = [1, o, if c { g() }]
    let a2 = [1, None, if c { g() }]
}
