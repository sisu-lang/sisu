class Bumper {
    fn bumpm(self, mut x: i64) {
        x += 1
    }
}

fn read(x: i64) {}

fn q3(c: Tree??) {
    bump(x: mut c.m.v)
}

fn m3(t: Bumper, c: Tree??) {
    t.bumpm(x: mut c.m.v)
