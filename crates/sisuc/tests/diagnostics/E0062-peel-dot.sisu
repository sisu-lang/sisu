// GIVEN the method of a generic class, or of an enum, called as a function
// THEN the value at a `mut` parameter gets the `if let` help
class Gc<T> {
    v: T
    fn put(self, mut x: T) {
        x = self.v
    }
    fn e10(self, c: Tree??) {
        put(c.m.v)
    }
}

fn row_e11(b: Gc<i64>, c: Tree??) {
    put(b, c.m.v)
}

fn row_q3(c: Tree??) {
    Gc.put(c.m.v)
}

enum En {
