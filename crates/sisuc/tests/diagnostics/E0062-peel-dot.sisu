// Each argument below keeps the peel help: no `mut` parameter is known for it.
fn z1(c: Tree??) {
    bump(c.m.v, c.m.v)
}

fn z2(c: Tree??) {
    bump(c.m.v + 1, 2)
}

fn z3(c: Tree??) {
    let f = bump
    f(c.m.v, 1)
}

// GIVEN a method called as a function, E0070, and a method called as `Name.method(..)`, E0105
// WHEN the value is at a `mut` parameter of the method
// THEN it gets the `if let` help, as for a call that finds the method
// AND a value at a plain parameter keeps the peel help, also where the receiver's method wins
fn row_e4(t: Tree, c: Tree??) {
    bumpm(t, c.m.v)
}

fn row_e5(t: Tree?, c: Tree??) {
    bumpm(t, c.m.v)
}

fn row_e6(t: Tree, c: Tree???) {
    bumpm(t, c.m.v)
}

fn row_e7(t: Tree, c: Tree??) {
    bumpm(t, c.m.v, 1)
}

fn row_q1(c: Tree??) {
    Tree.bumpm(c.m.v)
}

fn row_q2(c: Tree??) {
    Bp.bp(c.m.v)
}

fn row_g2(t: Tree, c: Tree??) {
    readm(t, c.m.v)
}

fn row_g3(c: Tree??) {
    Tree.readm(c.m.v)
}

