// GIVEN a `.` on an optional of an optional, in a function for each case
// AND a `?.` on the same value, which has the same help
// WHEN `sisu check` runs on it
// THEN it reports E0062 with no fix, and a help that peels the layers that `?.` does not take
// AND the `.` says "the extra layers", and the `?.` says "the other layers", with one `?? None` for each
// AND an index, a slice, a `for` subject, or a `mut` argument or an argument at a `mut` parameter after the `.` gets the `if let` help instead, also in a call that fails
// AND a `push` onto `[i64]??` gets the `if let` help and no fix: the peeled `push` gives E0021
class Node {
    v: i64
    mut ys: [i64]
    fn get(self) -> i64 { self.v }
}

fn f1(c: Node??) {
    print(c.get())
}

fn f2(c: Node??) {
    print(c?.get())
}

fn f3(c: Node??) {
    c.ys.push(1)
}

fn f4(c: Node??) {
    c?.ys.push(1)
}

fn f5(c: Node??) {
    c.v = 2
}

fn f6(xs: [i64]??) {
    print(xs.len())
}

fn f7(c: Node???) {
    print(c?.v)
}

fn f8(c: Node???) {
    print(c.v)
}

class Pusher {
    mut count: i64
    fn push(self, x: i64) {}
}

class Leaf {
    mut v: i64
    mut ys: [i64]
}

class Tree {
    mut v: i64
    mut ys: [i64]
    mut n: Tree?
    mut m: Leaf
    mut q: Pusher
    fn all(self) -> [i64] { self.ys }
    fn get(self) -> i64 { self.v }
}

fn bump(mut x: i64) {
    x += 1
}

fn r1(c: Tree??) {
    print(c.v)
}

fn r2(c: Tree??) {
    print(c.get())
}

