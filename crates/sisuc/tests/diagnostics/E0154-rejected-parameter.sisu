interface Source {
    type Item
}

class Plain: Source {
    type Item = i64
}

enum Two<A, B> {
    Both(A, B)
}

fn first_only<T: Source>(pair: Two<T, T.Item>, same: T) {}

fn then_other<T: Source, U>(pair: Two<T, T.Item>, label: U, other: Two<U, T.Item>) {}

fn main() {
    // `i64` has no `Source`. The call reports this once, and not `Plain()` as well.
    first_only(Two.Both(5, 7), Plain())
    // The bound fails here too. `label` and `other` are still checked against each other.
    then_other(Two.Both(5, 7), true, Two.Both("s", 3))
}
