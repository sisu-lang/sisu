// GIVEN `enum Only { One(i64) }` and a `main` whose line 10 is `let One(n) = v` and whose line 11 is `print(n)`
// WHEN `sisu check` runs on it
// THEN it reports E0174 at 10:9 and no other diagnostic
enum Only {
    One(i64)
}

fn main() {
    let v = Only.One(1)
    let One(n) = v
    print(n)
}
