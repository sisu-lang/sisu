// GIVEN a typed `let v: i64? = o` whose `else { return 0 }` starts the next line
// WHEN `sisu check` runs on it
// THEN it reports E0006 at the `else` (6:5) in the words for an `if`, with no fix: a typed `let` takes no `else`
fn f(o: i64?) -> i64 {
    let v: i64? = o
    else { return 0 }
    return 0
}

fn main() {
    print(f(Some(1)))
}
