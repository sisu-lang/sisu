// GIVEN `Board(mut cells: xs)`
// WHEN `sisu check` runs on it
// THEN it reports E0167 on the `mut`, in the constructor form, with the help for a class
// AND the safe fix removes `mut ` and gives `Board(cells: xs)`
class Board {
    mut cells: [i64]
}

fn main() {
    let mut xs = [1, 2]
    let b = Board(mut cells: xs)
    xs[0] = 3
    print(b.cells)
}
