class C {
    xs: [i64]
}

fn f(a: i64) -> i64 {
    a
}

fn main() {
    let c = C(xs: [1, 2, 3])
    let xs = [1, 2, 3]
    let c2 = true
    print(c
        .xs[:-1])
    print(c
        .xs[0:2])
    print(c // note
        .xs[0:2])
    print(c // note
        .xs[:-1])
    print([1, 2,
        3][0:1])
    print(xs[
        1:2])
    print(["a // b",
        "c"][0:1])
    print(xs[f(
        1):2])
    print(xs[0:f(
        2)])
    print(xs[f(1) // one
        :2])
    print((if c2 {
        let y = xs
        y
    } else { xs })[0:1])
}
