// GIVEN `enum Only { One(i64) }` and a `main` whose line 11 is `let w: Only = Only.One("x")` and whose line 12 is `let One(n) = w`
// WHEN `sisu check` runs on it
// THEN it reports E0032 at 11:28 for the value of the annotated `let`
// AND it reports E0174 at 12:9 with the label "`One(n)` always matches" and the help "use `match`"
// AND it reports no other diagnostic
enum Only {
    One(i64)
}

fn main() {
    let w: Only = Only.One("x")
    let One(n) = w
    print(n)
}
