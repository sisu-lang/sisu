enum _T {
    Leaf
    Node(i64)
}

enum _Color {
    Red
    Blue
    fn wait(self, other: _Color) {
        while self == other {
            print(1)
        }
    }
}

fn _f(t: _T, n: i64) {
    match t {
        Leaf => print(0)
        Node(x) => {
            while x < n {
                print(x)
            }
        }
    }
}

fn _g() {
    for k in 0..3 {
        while k > 0 {
            print(k)
        }
    }
}

fn main() {}
