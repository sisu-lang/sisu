// GIVEN an array's `get` with two arguments, the second one a range
// WHEN `sisu check` runs on it
// THEN it reports E0053 for the argument count
// AND it reports E0032 with the help "use `xs[a..b]`", which names the receiver as written
fn main() {
    let xs = [1, 2]
    print(xs.get(1, ..2) ?? 0)
}
