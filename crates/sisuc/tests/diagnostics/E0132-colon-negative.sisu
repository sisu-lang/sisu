class C {
    xs: [i64]

    fn head(self) {
        print(self.xs[:-1])
    }
}

fn f() -> C {
    C(xs: [1, 2, 3])
}

fn main() {
    let xs = [1, 2, 3, 4]
    let xss = [[1, 2, 3], [4, 5]]
    let c = C(xs: [1, 2, 3])
    let s = "hello"
    let p = "päivä"
    let n = 1
    let a = 1
    let b = 2
    print(xs[:-1])
    print(xs[-2:])
    print(xs[-3:-1])
    print(s[:-1])
    print(p[:-1])
    print(xs[:-n])
    print(xs[:-(n + 1)])
    print(xs[:(-1)])
    print(xs[1:-1])
    print(c.xs[:-1])
    print(xss[0][:-1])
    print(xs[:-a * b])
    print(xs[:-1 + n])
    print(xs[:--1])
    print(xs[:-9223372036854775808])
    print(f().xs[:-1])
    print(xs[1..][:-1])
    print(xs[{ xs = [7]; 0 }:-1])
    print(xs[:-1][:-1])
}
