// GIVEN a function `f` whose line 10 is `let v = w else { missing(); return }` on an enum value, with the pattern at 10:9
// WHEN `sisu check` runs on it
// THEN it reports E0131 at 10:9 with the unsafe fix "remove the `else` block", and E0052 at 10:22
enum E {
    A(n: i64)
    B
}

fn f(w: E) {
    let v = w else { missing(); return }
    print(v)
}

fn main() {
    f(E.B)
}
