// GIVEN the name of an enum, called as if it were a function
// AND the same with type arguments, with no arguments, and with an unknown argument
// AND an enum with no variant, and the enum `Result` of the prelude
// WHEN `sisu check` runs on it
// THEN it reports E0105 for each, and the message says that the name is an enum
// AND the help names a variant, unless the enum has none or the prelude declares it
enum Color {
    Red
}

enum Box<T> {
    Full(T)
}

enum Empty {
}

fn main() {
    let _a = Color(1)
    let _b = Color()
    let _c = Color<i64>(1)
    let _d = Box<i64>(1)
    let _e = Empty(1)
    let _f = Color(zzz)
    let _g = Result(1)
}
