fn f(a: i64) -> i64 {
    a
}

fn start_ellipsis() {
    for i in f(
        1)...5 {
        print(i)
    }
}

fn end_ellipsis() {
    for i in 0...f(
        5) {
        print(i)
    }
}

// `in_an_index` and `with_a_comment` are here because their `..<` forms have no fix;
// `E0132-range-multiline` holds only the `..<` forms that have one.
fn in_an_index() {
    let xs = [1, 2, 3]
    print(xs[f(
        0)..<2])
}

fn with_a_comment() {
    let r = f( // c
        1)..<3
}

fn main() {
}
