// GIVEN the method `put` of a generic struct, with a `mut` parameter
// WHEN it is called on the type, as `G.put(0, c.m.v)`
// THEN the value at the `mut` parameter gets the `if let` help (20:14), as a place does
class Leaf {
    mut v: i64
}

class Tree {
    mut m: Leaf
}

struct G<T> {
    v: T
    fn put(self, mut x: T) {
        x = self.v
    }
}

fn row(c: Tree??) {
    G.put(0, c.m.v)
}

fn main() {
    row(None)
}
