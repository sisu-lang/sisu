// GIVEN `f(mut ps[0], mut ps)`, where `ps` is a `let mut` array of a class `Point`
// WHEN `sisu check` runs on it
// THEN it reports E0171 on the second argument, with the message that `ps[0]` is inside `ps`
class Point {
    mut x: i64
}

fn f(mut first: Point, mut all: [Point]) {
    first = Point(x: 1)
    all[0] = first
}

fn main() {
    let mut ps = [Point(x: 1)]
    f(mut ps[0], mut ps)
    print(ps[0].x)
}
