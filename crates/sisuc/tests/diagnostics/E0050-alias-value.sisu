enum E {
    A
    B(i64)
}

class P {
    x: i64
}

type F<T> = f64
type S<T> = string
type N<T> = i64
type B<T> = u8
type C<T> = char
type EU<T> = E
type PU<T> = P

const X: f64 = F(3)
const Y: f64 = F.pi

fn main() {
    print(F(3))
    print(F.pi)
    print(S(['a']))
    print(N(2.5))
    print(B(3))
    print(C(65))
    print(EU.A)
    print(EU.B(1) == EU.A)
    print(PU(x: 1).x)
}
