// GIVEN a self-cycle, a 2-node cycle, a cross-interface cycle, and a tree-path cycle
// WHEN `sisu check` checks their associated-type bounds
// THEN it reports E0030 at 9:24, 14:24, 24:29, and 29:28
interface Has<X> {
    type Inner
}

interface SelfLoop {
    type A: Has<Self.A.Inner>
}

interface PairLoop {
    type A: Has<Self.B.Inner>
    type B: Has<Self.A.Inner>
}

interface Left {
    type Step: Right
    type A: Has<Self.Step.B.Inner>
}

interface Right {
    type Step: Left
    type B: Has<Self.Step.A.Inner>
}

interface Tree {
    type Kid: Tree
    type A: Has<Self.Kid.A.Inner>
}

fn main() {}
