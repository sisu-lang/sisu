// GIVEN a 2-node cycle, a cross-interface cycle, and a tree-path cycle
// WHEN `sisu check` checks their associated-type bounds
// THEN it reports E0030 at 10:24, 20:29, and 25:28
interface Has<X> {
    type Inner
}

interface PairLoop {
    type A: Has<Self.B.Inner>
    type B: Has<Self.A.Inner>
}

interface Left {
    type Step: Right
    type A: Has<Self.Step.B.Inner>
}

interface Right {
    type Step: Left
    type B: Has<Self.Step.A.Inner>
}

interface Tree {
    type Kid: Tree
    type A: Has<Self.Kid.A.Inner>
}

fn main() {}
