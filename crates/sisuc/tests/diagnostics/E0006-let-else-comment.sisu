// GIVEN a `let v = o // c` whose `else { return 0 }` starts the next line
// WHEN `sisu check` runs on it
// THEN it reports E0006 at the `else` (6:5), with an unsafe fix, because the join deletes the comment
fn f(o: i64?) -> i64 {
    let v = o // c
    else { return 0 }
    v
}

fn main() {
    print(f(Some(1)))
}
