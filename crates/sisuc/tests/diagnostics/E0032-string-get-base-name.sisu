// GIVEN a string's `get` with an argument that is not a range, after a plain or a failed `?.`
// WHEN `sisu check` runs on it
// THEN it reports E0032 for each call, and E0049 or E0062 for each failed `?.`
// AND the help of `t.get` and `u?.get` writes the call, as `t.get(1..3)` and `u?.get(1..3)`
// AND the help after a failed `?.` writes only the range, `1..3`, because the call fails again
class Holder { name: string }
fn main() {
    let t = "ab"
    let u: string? = "ab"
    let w = "ab"
    let p: string?? = Some(Some("ab"))
    let h = Holder(name: "ab")
    print(t.get(1) ?? "")
    print(u?.get(1) ?? "")
    print(w?.get(1) ?? "")
    print(p?.get(1) ?? "")
    print(h.name?.get(1) ?? "")
}
