// A method that two interfaces give to one struct has two result types, and no other argument
// picks one. The call that takes it as an argument has two outcomes. When the result of the call
// names the type parameter, the error is E0156 at the method. When the parameter is a bare `x: T`
// that the result does not name, the call cannot infer it: E0050. The last row is another rule:
// `[]` has no element, so nothing gives `U` its type, and the call is E0050.
interface Label {
    fn name(self) -> string
}

interface Code {
    fn name(self) -> i64
}

struct S {
}

extend S: Label {
    fn name(self) -> string { "a" }
}

extend S: Code {
    fn name(self) -> i64 { 7 }
}

struct Two<A, B> {
    a: A
    b: B
}

struct Box<T> {
    v: T

    fn put<U>(self, y: [Two<T, U>]) -> i64 { 0 }
}

fn wrap<T>(x: [T]) -> [T] { x }
fn opt<T>(x: T?) -> T { x ?? panic("no") }
fn h<T>(x: T) -> i64 { 0 }

fn main() {
    let s = S()
    let bx = Box(v: 1)
    let a = [wrap([s.name()])]
    let b = [opt(s.name())]
    let c = [h(s.name()), 1]
    let d = bx.put([])
    print(a.len() + b.len() + c.len() + d)
}
