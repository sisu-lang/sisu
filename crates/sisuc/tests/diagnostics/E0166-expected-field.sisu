// GIVEN `let n: i64 = first(b.cells)`, where the field `cells` is a `[string]` that is not `mut`
// WHEN `sisu check` runs on it
// THEN it reports E0032 for the result, then E0166 on `b.cells`
// AND the E0166 has no help: declaring the field `mut` would leave the E0032
class Names {
    cells: [string]
}

fn first<T>(mut xs: [T]) -> T {
    xs[0]
}

fn main() {
    let b = Names(cells: ["a"])
    let n: i64 = first(b.cells)
    print(n)
}
