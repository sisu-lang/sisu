interface Same {
    fn same(self, other: Self) -> bool
}

interface Ord2: Same {
    fn less(self, other: Self) -> bool
}

class Heap<T> {
    items: [T]
}

extend<T: Ord2> Heap<T>: Same {
    fn same(self, other: Self) -> bool {
        true
    }
}

extend<T: Same> Heap<T>: Ord2 {
    fn less(self, other: Self) -> bool {
        true
    }
}

class Heap2<A, B> {
    a: A
    b: B
}

extend<A: Same, B: Same> Heap2<A, B>: Ord2 {
    fn less(self, other: Self) -> bool {
        true
    }
}

extend<A: Ord2, B: Ord2> Heap2<A, B>: Same {
    fn same(self, other: Self) -> bool {
        true
    }
}

class Heap1<A, B> {
    a: A
    b: B
}

extend<A: Same, B: Ord2> Heap1<A, B>: Ord2 {
    fn less(self, other: Self) -> bool {
        true
    }
}

extend<A: Ord2, B: Ord2> Heap1<A, B>: Same {
    fn same(self, other: Self) -> bool {
        true
    }
}

fn main() {
    print(Heap(items: [1]).items.len())
}
