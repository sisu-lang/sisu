// GIVEN a struct method that takes `mut self`
// AND a call of it on a `let`
// WHEN `sisu check` runs on it
// THEN it is E0001 at the receiver, with the fix `let mut`
struct Point {
    x: i64
    y: i64

    fn move_by(mut self, dx: i64, dy: i64) {
        self.x += dx
        self.y += dy
    }
}

fn main() {
    let p = Point(x: 1, y: 2)
    p.move_by(1, 1)
    print(p.x)
}
