// GIVEN `fill<i64>(mut b?.cells, 3)`, where `fill<T>` takes a `mut` `[T]`
// WHEN `sisu check` runs on it
// THEN it reports E0170 on the argument, with the label for the write type, and `[i64]` in it
// AND the unwrap help
class Board {
    mut cells: [i64]
}

fn fill<T>(mut xs: [T], value: T) {
    xs[0] = value
}

fn main() {
    let b: Board? = Board(cells: [1])
    fill<i64>(mut b?.cells, 3)
    print(b == None)
}
