// GIVEN a `.` on an optional that starts a chain, in a function for each case
// AND the rest of the chain checks whether a value is optional, or binds a name to the value
// AND a value built from the typed one by an operator, a block, a join, a generic call or a slice
// WHEN `sisu check` runs on it
// THEN it reports E0062, and a reader of the failed value adds no report, because the value has no type
// AND it does not report that the value is not optional, and a name bound to it has no type
// AND a form that gives its own type, such as `==`, `<`, `-`, `!` or a string, reads as that type,
// so `??` on it reports E0048. A `match` on the failed value does not report a missing variant
class Inner {
    ys: [i64]
    v: i64
}

class Outer {
    ns: [Inner]
    inner: Inner
}

enum E {
    A
    B
}

enum F {
    A(string)
    B
}

enum Bx2<T> {
    Full(T)
    Empty
}

interface Get {
    fn get<T>(self, t: T) -> T
}

class C {
    v: i64
    b: bool
    e: E
    f: F
    s: string
    ys: [i64]
    n: C?
    mut w: i64
    m: Inner
    fn opt<T>(self, t: T) -> T? { Some(t) }
    fn wrap<T>(self, t: T) -> T { t }
    fn arr<T>(self, t: T) -> [T] { [t] }
}

class Bx {
    fn wrap<T>(self, t: T) -> T { t }
}

fn id<T>(t: T) -> T { t }

fn safe_after(c: Outer?) {
    print(c.inner?.v)
}

fn coalesce(c: Outer?) {
    print(c.inner.v ?? 0)
}

fn coalesce_len(o: [i64]?) {
    print(o.len() ?? 0)
}

fn iflet_value(c: Outer?) {
    if let x = c.inner.v { print(x) }
}

fn let_else(c: Outer?) {
    let x = c.inner.v else { return }
}

fn eq_none(c: Outer?) {
    print(c.inner.v == None)
}

fn local(c: Outer?) {
    let x = c.inner
    x.ys.push("a")
}

fn for_binding(c: Outer?) {
    for n in c.ns { n.ys.push("a") }
}

fn add_left(c: C?, k: bool, p: E) {
    print((c.v + 1) ?? 0)
}

fn add_right(c: C?, k: bool, p: E) {
    print((1 + c.v) ?? 0)
}

fn add_eq_none(c: C?, k: bool, p: E) {
    print((c.v + 1) == None)
}

fn add_if_let(c: C?, k: bool, p: E) {
    if let x = c.v + 1 { print(x) }
}

fn add_safe_call(c: C?, k: bool, p: E) {
    print((c.v + 1)?.to_string())
}

fn add_local(c: C?, k: bool, p: E) {
    let x = c.v + 1
    x.nope()
}

fn join_string(c: C?, k: bool, p: E) {
    print((c.s + "x") ?? "")
}

fn less(c: C?, k: bool, p: E) {
    print((c.v < 1) ?? false)
}

fn negate(c: C?, k: bool, p: E) {
    print((-c.v) ?? 0)
}

fn not(c: C?, k: bool, p: E) {
    print((!c.b) ?? false)
}

fn and(c: C?, k: bool, p: E) {
    print((c.b && k) ?? false)
}

fn block(c: C?, k: bool, p: E) {
    print({ c.v } ?? 0)
}

fn block_local(c: C?, k: bool, p: E) {
    let x = { c.v }
    print(x ?? 0)
}

fn block_for(c: C?, k: bool, p: E) {
    for n in { c.ys } { n.nope() }
}

fn join_both(c: C?, k: bool, p: E) {
    print((if k { c.v } else { c.v }) ?? 0)
}

fn join_one(c: C?, k: bool, p: E) {
    print((if k { c.v } else { 1 }) ?? 0)
}

fn join_match(c: C?, k: bool, p: E) {
    print((match p { A => c.v; B => 1 }) ?? 0)
}

fn join_nested(c: C?, k: bool, p: E) {
    print((if k { if k { c.v } else { 1 } } else { 1 }) ?? 0)
}

fn join_else_if(c: C?, k: bool, p: E) {
    print((if k { 1 } else if k { c.v } else { 1 }) ?? 0)
}

fn join_in_match(c: C?, k: bool, p: E) {
    print((match p { A => if k { c.v } else { 1 }; B => 1 }) ?? 0)
}

fn join_condition(c: C?, k: bool, p: E) {
    print((if c.b { 1 } else { 2 }) ?? 0)
}

fn join_for(c: C?, k: bool, p: E) {
    for n in if k { c.ys } else { c.ys } { n.nope() }
}

fn generic(c: C?, k: bool, p: E) {
    print(id(c.v) ?? 0)
}

fn generic_local(c: C?, k: bool, p: E) {
    let x = id(c.v)
    print(x ?? 0)
}

fn generic_safe_call(c: C?, k: bool, p: E) {
    print(id(c.v)?.to_string())
}

fn generic_method(c: C?, k: bool, p: E) {
    print(Bx().wrap(c.v) ?? 0)
}

fn slice(c: C?, k: bool, p: E) {
    let x = c.ys[0..1]
    x.nope()
}

fn coalesce_right(c: C?, k: bool, p: E) {
    let o: i64? = None
    print((o ?? c.v) ?? 0)
}

fn equal(c: C?, k: bool, p: E) {
    print((c.v == 1) ?? false)
}

fn interpolation(c: C?, k: bool, p: E) {
    print("{c.v}" ?? "")
}

fn array_literal(c: C?, k: bool, p: E) {
    print([c.v] ?? [1])
}

fn coalesce_left(c: C?, k: bool, p: E) {
    print((c.v ?? 0) ?? 0)
}

fn name_iflet_enum(c: C?, k: bool, p: E) {
    if let x = c.e { print(x) }
}

fn name_while_enum(c: C?, k: bool, p: E) {
    while let x = c.e { print(x) }
}

fn name_let_else_enum(c: C?, k: bool, p: E) {
    let x = c.e else { return }
}

fn some_none_arms(c: C?, k: bool, p: E) {
    match c.v { Some(x) => print(x); None => {} }
}

fn none_arm(c: C?, k: bool, p: E) {
    match c.v { None => {}; _ => {} }
}

fn some_arm(c: C?, k: bool, p: E) {
    match c.v { Some(x) => print(x) }
}

fn some_iflet(c: C?, k: bool, p: E) {
    if let Some(x) = c.v { print(x) }
}

fn some_string_literal(c: C?, k: bool, p: E) {
    match c.v { Some("a") => {}; _ => {} }
}

fn some_some(c: C?, k: bool, p: E) {
    match c.v { Some(Some(x)) => {}; _ => {} }
}

fn name_arm(c: C?, k: bool, p: E) {
    match c.v { x => print(x ?? 0) }
}

fn some_arm_optional(c: C?, k: bool, p: E) {
    match c.n { Some(m) => print(m.v); None => {} }
}

fn some_iflet_optional(c: C?, k: bool, p: E) {
    if let Some(m) = c.n { print(m.v) }
}

fn enum_missing(c: C?, k: bool, p: E) {
    match c.e { A => {} }
}

fn enum_covered(c: C?, k: bool, p: E) {
    match c.e { A => {}; B => {} }
}

fn enum_none_arm(c: C?, k: bool, p: E) {
    match c.e { A => {}; None => {} }
}

fn enum_some_arm(c: C?, k: bool, p: E) {
    match c.e { Some(A) => {}; _ => {} }
}

fn debug_call(c: C?, k: bool, p: E) {
    print(dbg(c.v) ?? 0)
}

fn or_pattern(c: C?, k: bool, p: E) {
    match c.v { Some(1) | None => {}; _ => {} }
}

fn variant_generic(c: C?, k: bool, p: E) {
    match Bx2.Full(c.v) { Bx2.Full(x) => print(x ?? 0); Bx2.Empty => {} }
}

fn interface_call<X: Get>(x: X, c: C?) {
    print(x.get(c.v) ?? 0)
}

fn some_name_coalesce(c: C?, k: bool, p: E) {
    match c.v { Some(x) => print(x ?? 0); None => {} }
}

fn some_name_member(c: C?, k: bool, p: E) {
    match c.v { Some(x) => x.nope(); None => {} }
}

fn some_name_iflet_member(c: C?, k: bool, p: E) {
    if let Some(x) = c.v { x.nope() }
}

fn iflet_join(c: C?, k: bool, p: E) {
    print((if let x = c.v { x } else { 0 }) ?? 0)
}

fn some_built(c: C?, k: bool, p: E) {
    match Some(c.v) { Some(x) => print(x ?? 0); None => {} }
}

fn some_built_iflet(c: C?, k: bool, p: E) {
    if let Some(x) = Some(c.v) { print(x ?? 0) }
}

fn some_guard(c: C?, k: bool, p: E) {
    match c.v { Some(x) if (x ?? 0) > 1 => {}; _ => {} }
}

fn some_variant_name(c: C?, k: bool, p: E) {
    match c.f { Some(F.A(x)) => x.nope(); _ => {} }
}

fn generic_method_iflet(c: C?, k: bool, p: E) {
    if let x = c.opt(c.v) { print(x ?? 0) }
}

fn generic_method_match(c: C?, k: bool, p: E) {
    match c.opt(c.v) { Some(x) => print(x ?? 0); None => {} }
}

fn generic_method_nested_some(c: C?, k: bool, p: E) {
    if let x = c.wrap(Some(c.v)) { print(x ?? 0) }
}

fn coalesce_left_some(c: C?, k: bool, p: E) {
    print((Some(c.v) ?? 0) ?? 0)
}

fn coalesce_left_method(c: C?, k: bool, p: E) {
    print((c.opt(c.v) ?? 0) ?? 0)
}

fn safe_generic_iflet(c: C?, k: bool, p: E) {
    if let x = c?.opt(c.v) { print(x ?? 0) }
}

fn safe_generic_match(c: C?, k: bool, p: E) {
    match c?.opt(c.v) { Some(x) => print(x ?? 0); None => {} }
}

fn safe_generic_let(c: C?, k: bool, p: E) {
    let y = c?.opt(c.v)
    print((y ?? 0) ?? 0)
}

fn safe_after_member_optional(c: C?, k: bool, p: E) {
    if let x = c.n?.opt(c.v) { print(x ?? 0) }
}

fn let_generic_method(c: C?, k: bool, p: E) {
    let y = c.opt(c.v)
    print((y ?? 0) ?? 0)
}

fn for_generic_default(c: C?, k: bool, p: E) {
    for x in c.opt(c.ys) ?? [] { print(x ?? 0) }
}

fn match_array_name(c: C?, k: bool, p: E) {
    match c.ys { xs => print(xs) }
}

fn match_class_name(c: C?, k: bool, p: E) {
    match c.m { x => print(x.v) }
}

fn match_generic_call(c: C?, k: bool, p: E) {
    match id(c.ys) { xs => print(xs) }
}

fn match_generic_method(c: C?, k: bool, p: E) {
    match c.arr(c.v) { xs => print(xs) }
}

fn match_generic_method_member(c: C?, k: bool, p: E) {
    match c.arr(c.v) { xs => xs.nope() }
}

fn let_some_member(c: C?, k: bool, p: E) {
    let y = Some(c.v)
    y.nope()
}

fn main() {}
