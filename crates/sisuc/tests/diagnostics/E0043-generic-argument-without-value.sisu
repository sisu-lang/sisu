// A `unit` has no value to compare or to pass on. A block that ends in a `let` is a valid `unit`
// value. `id({ let y = 2 }) == 1` compares it, and that is E0043 at the call. The same block as an
// operand of `==` is E0043. An `if` whose branches never finish is E0043 as an argument.
struct P<A, B> {
    a: A
    b: B
}

fn id<T>(x: T) -> T {
    x
}

fn h<A, B>(_c: bool, p: P<A, B>) -> A {
    p.a
}

fn main() {
    let c = true
    let a = id({ let y = 2 }) == 1
    let b = { let z = 3 } == id(1)
    let z: i64? = h(c, if c { todo("a") } else { panic("b") })
    print(a)
}
