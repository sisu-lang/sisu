// A block that ends in a `let` is a `unit` value. `id({ let y = 2 }) == 1` compares a `unit`
// with an `i64`: E0043 at the call. `{ let z = 3 } == id(1)` is the same mistake, with the block
// as the operand. An `if` whose branches never finish has no value: E0043 at `P<A, B>` of `h`.
struct P<A, B> {
    a: A
    b: B
}

fn id<T>(x: T) -> T {
    x
}

fn h<A, B>(_c: bool, p: P<A, B>) -> A {
    p.a
}

fn main() {
    let c = true
    let a = id({ let y = 2 }) == 1
    let b = { let z = 3 } == id(1)
    let z: i64? = h(c, if c { todo("a") } else { panic("b") })
    print(a)
}
