// The prelude: Sisu source that the compiler checks before every program. The compiler
// embeds this file (`front_end::PRELUDE_SOURCE`), and an error in it is an internal error.

// A value that may be missing. The compiler takes this declaration for the optional type: `T?`
// and `Option<T>` are the same type, `Some(x)` converts `x` to it, and no enum is made.
enum Option<T> {
    None
    Some(T)
}

// The result of work that can fail: a value, or the reason it failed.
enum Result<T, E> {
    Ok(T)
    Err(E)
}

// The methods of `i64` that Sisu code writes. `f64`'s are built in.
extend i64 {
    fn min(self, other: i64) -> i64 {
        if self < other { self } else { other }
    }

    fn max(self, other: i64) -> i64 {
        if self > other { self } else { other }
    }

    // With `lo` above `hi`, the result is `hi`.
    fn clamp(self, lo: i64, hi: i64) -> i64 {
        self.max(lo).min(hi)
    }
}
