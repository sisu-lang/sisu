  "cards": [
    { "dot": "emerald", "title": "Driver", "items": ["lib.rs runs the stages in order; main.rs starts it on a 64 MiB stack", "fuzz.rs runs --check on fuzz input, asserts spans and compiles clean input", "mir::build lowers tir to mir, then infers borrowed parameters (params.rs), places moves (ownership.rs), hoists unique calls, elaborates scope releases (elaborate.rs) and removes retain/release pairs within a block (pairs.rs), and debug builds certify each function", "--emit tokens|ast|tir|mir|ir|ir-raw stops early and prints", "--check stops after the checker", "--format json prints diagnostics as JSON Lines", "--explain prints a code's explanation", "-O2 or -O3 runs LLVM's default<O2> or default<O3> pipeline", "--rc-checks builds count checks into the program", "--linker bfd|gold|lld|mold picks the linker cc runs"] },
    { "dot": "amber", "title": "Runtime", "items": ["C ABI, linked into every program", "sisu_print_int, sisu_print_bool, sisu_eprint_int, sisu_eprint_bool, sisu_flush_stdout", "text.rs: sisu_print_char, sisu_print_str, sisu_eprint_*, sisu_str_compare, sisu_write_*, sisu_utf8_*, sisu_words_count, sisu_word_next", "stdin.rs: sisu_read_line", "args.rs: sisu_args_len, sisu_arg", "sisu_panic, sisu_panic_message, sisu_panic_bounds", "sisu_alloc, sisu_realloc, sisu_free for objects, arrays and strings", "sisu_rc_fault, sisu_rc_check_exit under --rc-checks"] }
