enum Status {
    Paid
    Pending
    Refunded(reason: string)
}

class Order {
    item: string
    price: f64
    status: Status
}

fn main() {
    let orders = [
        Order(item: "sauna stones", price: 39.0, status: Status.Paid),
        Order(item: "birch whisk", price: 12.5,
              status: Status.Refunded(reason: "too stiff")),
        Order(item: "wool socks", price: 18.0, status: Status.Pending),
    ]
    let mut paid = 0.0
    for order in orders {
        match order.status {
            Paid => paid += order.price
            Pending => print("{order.item}: waiting")
            Refunded(reason) => print("{order.item}: refunded, {reason}")
        }
    }
    print("Paid: {paid:.2} €")
}
