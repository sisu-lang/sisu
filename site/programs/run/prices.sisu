fn total(xs: [f64]) -> f64 {
    let mut sum = 0.0
    for x in xs {
        sum += x
    }
    sum
}

fn add_tax(mut prices: [f64], rate: f64) {
    for i in 0..prices.len() {
        prices[i] *= 1.0 + rate
    }
}

fn main() {
    let prices = [39.0, 12.5, 18.0]
    let mut taxed = prices
    add_tax(mut taxed, 0.24)
    print(prices)
    print(taxed)
    print("{total(taxed[0..2]):.2}")
}
