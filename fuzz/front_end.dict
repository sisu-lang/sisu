# libFuzzer dictionary for the front_end target: every keyword, operator and delimiter
# the Sisu lexer knows, from crates/sisuc/src/lexer/mod.rs (`keyword_or_ident`, `symbol`
# and the string, char and comment cases of the main loop).

# Keywords, reserved words included.
kw_fn="fn"
kw_let="let"
kw_mut="mut"
kw_var="var"
kw_import="import"
kw_pub="pub"
kw_enum="enum"
kw_match="match"
kw_record="record"
kw_type="type"
kw_weak="weak"
kw_test="test"
kw_todo="todo"
kw_echo="echo"
kw_interface="interface"
kw_extern="extern"
kw_as="as"
kw_if="if"
kw_else="else"
kw_while="while"
kw_for="for"
kw_loop="loop"
kw_in="in"
kw_return="return"
kw_break="break"
kw_continue="continue"
kw_class="class"
kw_const="const"
kw_None="None"
kw_is="is"
kw_self="self"
kw_Self="Self"
kw_extend="extend"
kw_true="true"
kw_false="false"
kw__="_"

# Operators and punctuation.
op_plus_eq="+="
op_plus="+"
op_minus_eq="-="
op_arrow="->"
op_minus="-"
op_star_eq="*="
op_star="*"
op_slash_eq="/="
op_slash="/"
op_percent_eq="%="
op_percent="%"
op_eq_eq="=="
op_fat_arrow="=>"
op_eq="="
op_not_eq="!="
op_bang="!"
op_le="<="
op_lt="<"
op_ge=">="
op_gt=">"
op_and_and="&&"
op_amp="&"
op_or_or="||"
op_pipe="|"
op_lparen="("
op_rparen=")"
op_lbrace="{"
op_rbrace="}"
op_comma=","
op_colon=":"
op_dot_dot=".."
op_dot_dot_eq="..="
op_dot="."
op_lbracket="["
op_rbracket="]"
op_semicolon=";"
op_question_dot="?."
op_question_question="??"
op_question="?"

# String, char and comment delimiters.
delim_string="\""
delim_char="'"
delim_comment="//"
